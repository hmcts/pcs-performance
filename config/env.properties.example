# Backend service hosts used by the JMeter scripts.
#
# Copy this file to config/env.properties (git-ignored) and fill in the
# host names for the environment you are testing against. Values are host
# names only - no scheme (http://) and no trailing slash.
#
# Load it when starting JMeter:
#   jmeter -q config/env.properties                                   (GUI)
#   jmeter -q config/env.properties -n -t <test_plan>.jmx -l out.jtl  (non-GUI)

# Service-to-service auth provider (rpe-service-auth-provider)
s2sHost=

# PCS API
pcsApiHost=

# CCD data store API
ccdDataStoreHost=

# Document management store (dm-store)
dmStoreHost=
