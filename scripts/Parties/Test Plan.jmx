            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC05_ManageParties_Build_Add_Options_Body">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import groovy.json.JsonOutput
def event = [id: &quot;manageParties&quot;, summary: &quot;&quot;, description: &quot;&quot;]
def data = [
  addParty_ManagePartyOptions: &quot;ADD_PARTY&quot;,
  addParty_AddPartyType: (vars.get(&quot;addPartyType&quot;) ?: &quot;CLAIMANT&quot;),
  updateParty_PreviouslySelectedPartyId: null,
  updateParty_UpdatePartyType: null
]
vars.put(&quot;addOptionsValidateBody&quot;, JsonOutput.toJson([
  data: data, event: event, event_data: data,
  event_token: vars.get(&quot;event_token&quot;), ignore_warning: false,
  case_reference: vars.get(&quot;Case_ID&quot;)
]))</stringProp>
            </JSR223PreProcessor>
