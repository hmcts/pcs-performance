          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC02_UploadDocument_Build_Upload_Body" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def relatedItems = new JsonSlurper().parseText(vars.get(&quot;relatedPartyListJson&quot;) ?: &quot;[]&quot;)
def docTypeItems = new JsonSlurper().parseText(vars.get(&quot;docTypeListJson&quot;) ?: &quot;[]&quot;)

def relatedPartyCode = vars.get(&quot;relatedPartyCode&quot;) ?: &quot;&quot;
def relatedPartyLabel = vars.get(&quot;relatedPartyLabel&quot;) ?: &quot;&quot;
def docTypeCode = vars.get(&quot;docTypeCode&quot;) ?: &quot;RENT_STATEMENT&quot;
def docTypeLabel = vars.get(&quot;docTypeLabel&quot;) ?: docTypeCode

def document = [
    document_url: vars.get(&quot;doc_url&quot;),
    document_binary_url: vars.get(&quot;doc_binary_url&quot;),
    document_filename: vars.get(&quot;doc_filename&quot;),
    document_hash: vars.get(&quot;doc_hash&quot;)
]

def relatedParty = [
    value: [code: relatedPartyCode, label: relatedPartyLabel],
    list_items: relatedItems
]

def standaloneDocType = [
    value: [code: docTypeCode, label: docTypeLabel],
    list_items: docTypeItems
]

def data = [
    cwDoc_ShowRelatedSubmissionsList: &quot;NO&quot;,
    cwDoc_Document: document,
    cwDoc_StandaloneDocumentType: standaloneDocType,
    cwDoc_IssueDate: null,
    cwDoc_RelatedParty: relatedParty
]

def event = [
    id: &quot;caseworkerUploadDocuments&quot;,
    summary: &quot;&quot;,
    description: &quot;&quot;
]

def validateBody = [
    data: data,
    event: event,
    event_data: data,
    event_token: vars.get(&quot;event_token&quot;),
    ignore_warning: false,
    case_reference: vars.get(&quot;Case_ID&quot;)
]

def eventData = [
    cwDoc_ShowRelatedSubmissionsList: &quot;NO&quot;,
    cwDoc_Document: document,
    cwDoc_StandaloneDocumentType: [
        value: [code: docTypeCode, label: docTypeLabel],
        list_items: docTypeItems,
        valueCode: docTypeCode
    ],
    cwDoc_IssueDate: null,
    cwDoc_RelatedParty: [
        value: [code: relatedPartyCode, label: relatedPartyLabel],
        list_items: relatedItems,
        valueCode: relatedPartyCode,
        valueLabel: relatedPartyLabel
    ]
]

def eventBody = [
    data: eventData,
    event: event,
    event_token: vars.get(&quot;event_token&quot;),
    ignore_warning: false
]

vars.put(&quot;uploadValidateBody&quot;, JsonOutput.toJson(validateBody))
vars.put(&quot;uploadEventBody&quot;, JsonOutput.toJson(eventBody))
</stringProp>
