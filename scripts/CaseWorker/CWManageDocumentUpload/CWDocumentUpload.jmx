              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def json = new JsonSlurper().parseText(body)

def findField = { id -&gt;
    def fields = json.case_fields ?: []
    return fields.find { it.id == id }
}

def related = findField(&quot;cwDoc_RelatedParty&quot;)
def docType = findField(&quot;cwDoc_StandaloneDocumentType&quot;)

def relatedItems = (related?.value?.list_items ?: []) as List
def docTypeItems = (docType?.value?.list_items ?: []) as List

def relatedFirst = relatedItems ? relatedItems[0] : null
def relatedPartyCode = relatedFirst?.code?.toString() ?: &quot;&quot;
def relatedPartyLabel = relatedFirst?.label?.toString() ?: &quot;&quot;

def wantedCode = vars.get(&quot;docTypeCode&quot;) ?: &quot;RENT_STATEMENT&quot;
def matched = docTypeItems.find { it.code?.toString() == wantedCode }
if (!matched &amp;&amp; docTypeItems) {
    matched = docTypeItems[0]
}
def docTypeCode = matched?.code?.toString() ?: wantedCode
def docTypeLabel = matched?.label?.toString() ?: wantedCode

vars.put(&quot;relatedPartyCode&quot;, relatedPartyCode)
vars.put(&quot;relatedPartyLabel&quot;, relatedPartyLabel)
vars.put(&quot;docTypeCode&quot;, docTypeCode)
vars.put(&quot;docTypeLabel&quot;, docTypeLabel)
vars.put(&quot;relatedPartyListJson&quot;, JsonOutput.toJson(relatedItems))
vars.put(&quot;docTypeListJson&quot;, JsonOutput.toJson(docTypeItems))

</stringProp>
