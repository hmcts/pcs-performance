          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC02_UploadDocument_Decode_Password" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.util.Base64
String encoded = vars.get(&quot;encodedPassword&quot;)
if (encoded != null) {
    String password = new String(Base64.getDecoder().decode(encoded), &quot;UTF-8&quot;)
    password = password.replace(&apos;\u00A0&apos;, &apos;&apos;).trim()
    vars.put(&quot;password&quot;, password)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
