              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def raw = prev.getResponseDataAsString() ?: &quot;&quot;

def json
try {
  json = new JsonSlurper().parseText(raw)
} catch (Exception e) {
  return
}

def data = (json.data ?: [:]) as Map
def docField = vars.get(&quot;removeDocField&quot;)
def docItems = new JsonSlurper().parseText(vars.get(&quot;removeDocListJson&quot;) ?: &quot;[]&quot;)
def emptyFlags = new JsonSlurper().parseText(vars.get(&quot;removeEmptyFlagsJson&quot;) ?: &quot;{}&quot;)
def reasonField = vars.get(&quot;removeReasonField&quot;)

def docId = (data.documentRemoval_SelectedDocumentId ?: vars.get(&quot;removeDocCode&quot;)).toString()
def docLabel = (data.documentRemoval_SelectedDocumentFileName ?: vars.get(&quot;removeDocLabel&quot;)).toString()
def folderCode = (data.documentRemoval_SelectedFolder ?: vars.get(&quot;removeFolderCode&quot;)).toString()

def eventData = [:]
eventData.documentRemoval_PropertyAddressSummary = data.documentRemoval_PropertyAddressSummary ?: vars.get(&quot;removePropertyAddress&quot;)
eventData.documentRemoval_SelectedFolder = folderCode
eventData[docField] = [
  value: [code: docId, label: docLabel],
  list_items: docItems,
  valueLabel: docLabel,
  valueCode: docId
]
emptyFlags.each { k, v -&gt; eventData[k] = data[k] ?: v }
eventData[reasonField] = data[reasonField] ?: (vars.get(&quot;removeReason&quot;) ?: &quot;Test&quot;)
eventData.documentRemoval_SelectedDocumentId = docId
eventData.documentRemoval_SelectedDocumentFileName = docLabel

def eventBody = [
  data: eventData,
  event: [id: &quot;removeDocument&quot;, summary: &quot;&quot;, description: &quot;&quot;],
  event_token: vars.get(&quot;remove_event_token&quot;),
  ignore_warning: false
]
vars.put(&quot;removeEventBody&quot;, JsonOutput.toJson(eventBody))

log.info(&quot;[CWRemove] submit id=&quot; + docId + &quot; file=&quot; + docLabel)</stringProp>
