              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def status = prev.getResponseCode() ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
if (status != &quot;200&quot;) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;removeDocument trigger HTTP &quot; + status)
  return
}

def json
try {
  json = new JsonSlurper().parseText(body)
} catch (Exception e) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;removeDocument trigger not JSON: &quot; + e.message)
  return
}

def token = (json.event_token ?: &quot;&quot;).toString()
vars.put(&quot;remove_event_token&quot;, token)

def fields = (json.case_fields ?: []) as List
def byId = fields.collectEntries { [(it.id): it] }

def folders = [
  [code: &quot;STATEMENTS_OF_CASE&quot;, docField: &quot;statementsOfCaseDocuments&quot;, emptyField: &quot;documentRemoval_StatementsOfCaseEmpty&quot;, reasonField: &quot;documentRemoval_StatementsOfCaseReason&quot;],
  [code: &quot;PROPERTY_DOCUMENTS&quot;, docField: &quot;propertyDocuments&quot;, emptyField: &quot;documentRemoval_PropertyDocumentsEmpty&quot;, reasonField: &quot;documentRemoval_PropertyDocumentsReason&quot;],
  [code: &quot;EVIDENCE&quot;, docField: &quot;evidenceDocuments&quot;, emptyField: &quot;documentRemoval_EvidenceEmpty&quot;, reasonField: &quot;documentRemoval_EvidenceReason&quot;],
  [code: &quot;HEARING_DOCUMENTS&quot;, docField: &quot;hearingDocuments&quot;, emptyField: &quot;documentRemoval_HearingDocumentsEmpty&quot;, reasonField: &quot;documentRemoval_HearingDocumentsReason&quot;],
  [code: &quot;ORDERS_AND_NOTICE_OF_HEARINGS&quot;, docField: &quot;ordersAndNoticeOfHearingsDocuments&quot;, emptyField: &quot;documentRemoval_OrdersAndNoticeOfHearingsEmpty&quot;, reasonField: &quot;documentRemoval_OrdersAndNoticeOfHearingsReason&quot;],
  [code: &quot;APPLICATIONS&quot;, docField: &quot;applicationsDocuments&quot;, emptyField: &quot;documentRemoval_ApplicationsEmpty&quot;, reasonField: &quot;documentRemoval_ApplicationsReason&quot;],
  [code: &quot;APPEALS&quot;, docField: &quot;appealsDocuments&quot;, emptyField: &quot;documentRemoval_AppealsEmpty&quot;, reasonField: &quot;documentRemoval_AppealsReason&quot;],
  [code: &quot;CORRESPONDENCE&quot;, docField: &quot;correspondenceDocuments&quot;, emptyField: &quot;documentRemoval_CorrespondenceEmpty&quot;, reasonField: &quot;documentRemoval_CorrespondenceReason&quot;],
  [code: &quot;UNCATEGORISED_DOCUMENTS&quot;, docField: &quot;uncategorisedDocuments&quot;, emptyField: &quot;documentRemoval_UncategorisedDocumentsEmpty&quot;, reasonField: &quot;documentRemoval_UncategorisedDocumentsReason&quot;]
]

def emptyFlags = [:]
folders.each { f -&gt;
  emptyFlags[f.emptyField] = (byId[f.emptyField]?.value ?: &quot;Yes&quot;).toString()
}

def wantedName = vars.get(&quot;uploadedStoredFilename&quot;) ?: vars.get(&quot;doc_filename&quot;) ?: &quot;&quot;
def docUrl = vars.get(&quot;doc_url&quot;) ?: &quot;&quot;
def uploadedDocId = &quot;&quot;
def idMatch = (docUrl =~ /([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/)
if (idMatch.find()) {
  uploadedDocId = idMatch.group(1)
}
def uploadedCollectionId = vars.get(&quot;uploadedCollectionId&quot;) ?: &quot;&quot;
def chosen = null
def items = []
def picked = null
def pickHow = &quot;none&quot;

if (uploadedCollectionId) {
  for (f in folders) {
    def listItems = (byId[f.docField]?.value?.list_items ?: []) as List
    def match = listItems.find { it.code?.toString() == uploadedCollectionId }
    if (match) {
      chosen = f
      items = listItems
      picked = match
      pickHow = &quot;upload-collection-id&quot;
      break
    }
  }
}

if (!chosen &amp;&amp; uploadedDocId) {
  for (f in folders) {
    def listItems = (byId[f.docField]?.value?.list_items ?: []) as List
    def match = listItems.find { it.code?.toString() == uploadedDocId }
    if (match) {
      chosen = f
      items = listItems
      picked = match
      pickHow = &quot;upload-doc-id&quot;
      break
    }
  }
}

if (!chosen &amp;&amp; wantedName) {
  for (f in folders) {
    def listItems = (byId[f.docField]?.value?.list_items ?: []) as List
    def match = listItems.find { (it.label ?: &quot;&quot;).toString() == wantedName }
    if (match) {
      chosen = f
      items = listItems
      picked = match
      pickHow = &quot;upload-stored-filename&quot;
      break
    }
  }
}

def origName = vars.get(&quot;doc_filename&quot;) ?: &quot;&quot;
def origBase = origName.replaceAll(/\.[^.]+$/, &quot;&quot;)
if (!chosen &amp;&amp; origBase) {
  for (f in folders) {
    def listItems = (byId[f.docField]?.value?.list_items ?: []) as List
    def matches = listItems.findAll { (it.label ?: &quot;&quot;).toString().contains(origBase) }
    if (matches) {
      chosen = f
      items = listItems
      picked = matches[0]
      pickHow = &quot;upload-filename-stem&quot;
      break
    }
  }
}

if (!chosen) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;Uploaded document not found for remove. collectionId=&quot; + uploadedCollectionId + &quot; filename=&quot; + wantedName)
  return
}

vars.put(&quot;removePropertyAddress&quot;, (byId[&quot;documentRemoval_PropertyAddressSummary&quot;]?.value ?: &quot;&quot;).toString())
vars.put(&quot;removeFolderCode&quot;, chosen.code)
vars.put(&quot;removeDocField&quot;, chosen.docField)
vars.put(&quot;removeReasonField&quot;, chosen.reasonField)
vars.put(&quot;removeDocCode&quot;, picked.code?.toString() ?: &quot;&quot;)
vars.put(&quot;removeDocLabel&quot;, picked.label?.toString() ?: &quot;&quot;)
vars.put(&quot;removeDocListJson&quot;, JsonOutput.toJson(items))
vars.put(&quot;removeEmptyFlagsJson&quot;, JsonOutput.toJson(emptyFlags))

log.info(&quot;[CWRemove] case=&quot; + vars.get(&quot;Case_ID&quot;) + &quot; folder=&quot; + chosen.code + &quot; doc=&quot; + picked.label + &quot; how=&quot; + pickHow)</stringProp>
