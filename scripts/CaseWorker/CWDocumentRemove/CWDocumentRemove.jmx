              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def emptyFlags = new JsonSlurper().parseText(vars.get(&quot;removeEmptyFlagsJson&quot;) ?: &quot;{}&quot;)
def docItems = new JsonSlurper().parseText(vars.get(&quot;removeDocListJson&quot;) ?: &quot;[]&quot;)
def docField = vars.get(&quot;removeDocField&quot;)
def reasonField = vars.get(&quot;removeReasonField&quot;)

def data = [:]
data.documentRemoval_PropertyAddressSummary = vars.get(&quot;removePropertyAddress&quot;)
data.documentRemoval_SelectedFolder = vars.get(&quot;removeFolderCode&quot;)
data[docField] = [
  value: [code: vars.get(&quot;removeDocCode&quot;), label: vars.get(&quot;removeDocLabel&quot;)],
  list_items: docItems
]
emptyFlags.each { k, v -&gt; data[k] = v }
data[reasonField] = vars.get(&quot;removeReason&quot;) ?: &quot;Test&quot;
data.documentRemoval_SelectedDocumentId = null
data.documentRemoval_SelectedDocumentFileName = null

def event = [id: &quot;removeDocument&quot;, summary: &quot;&quot;, description: &quot;&quot;]
def body = [
  data: data,
  event: event,
  event_data: data,
  event_token: vars.get(&quot;remove_event_token&quot;),
  ignore_warning: false,
  case_reference: vars.get(&quot;Case_ID&quot;)
]
def jsonBody = JsonOutput.toJson(body)
vars.put(&quot;removeValidateBody&quot;, jsonBody)

</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.case-data-validate.v2+json;charset=UTF-8</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">experimental</stringProp>
                  <stringProp name="Header.value">true</stringProp>
                </elementProp>
              </collectionProp>
