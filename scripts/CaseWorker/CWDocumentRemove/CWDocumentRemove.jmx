              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def relatedItems = new JsonSlurper().parseText(vars.get(&quot;relatedPartyListJson&quot;) ?: &quot;[]&quot;)
def docTypeItems = new JsonSlurper().parseText(vars.get(&quot;docTypeListJson&quot;) ?: &quot;[]&quot;)
def relSubItems = new JsonSlurper().parseText(vars.get(&quot;relatedSubmissionListJson&quot;) ?: &quot;[]&quot;)
def showRelated = vars.get(&quot;showRelatedSubmissions&quot;) ?: &quot;YES&quot;
def relatedPartyCode = vars.get(&quot;relatedPartyCode&quot;) ?: &quot;&quot;
def relatedPartyLabel = vars.get(&quot;relatedPartyLabel&quot;) ?: &quot;&quot;
def docTypeCode = vars.get(&quot;docTypeCode&quot;) ?: &quot;POSSESSION_NOTICE&quot;
def docTypeLabel = vars.get(&quot;docTypeLabel&quot;) ?: docTypeCode
def relSubCode = vars.get(&quot;relatedSubmissionCode&quot;) ?: &quot;NONE&quot;
def relSubLabel = vars.get(&quot;relatedSubmissionLabel&quot;) ?: &quot;Not related to an application or counterclaim&quot;

def document = [
  document_url: vars.get(&quot;doc_url&quot;),
  document_binary_url: vars.get(&quot;doc_binary_url&quot;),
  document_filename: vars.get(&quot;doc_filename&quot;),
  document_hash: vars.get(&quot;doc_hash&quot;)
]
def relatedParty = [
  value: [code: relatedPartyCode, label: relatedPartyLabel],
  list_items: relatedItems
]
def event = [id: &quot;caseworkerUploadDocuments&quot;, summary: &quot;&quot;, description: &quot;&quot;]

def data
def eventData
if (showRelated == &quot;YES&quot;) {
  def relatedSubmission = [value: [code: relSubCode, label: relSubLabel], list_items: relSubItems]
  def relatedDocType = [value: [code: docTypeCode, label: docTypeLabel], list_items: docTypeItems]
  data = [
    cwDoc_ShowRelatedSubmissionsList: &quot;YES&quot;,
    cwDoc_Document: document,
    cwDoc_RelatedSubmission: relatedSubmission,
    cwDoc_RelatedSubmissionsDocumentType: relatedDocType,
    cwDoc_IssueDate: null,
    cwDoc_RelatedParty: relatedParty
  ]
  eventData = [
    cwDoc_ShowRelatedSubmissionsList: &quot;YES&quot;,
    cwDoc_Document: document,
    cwDoc_RelatedSubmission: [value: [code: relSubCode, label: relSubLabel], list_items: relSubItems, valueCode: relSubCode],
    cwDoc_RelatedSubmissionsDocumentType: [value: [code: docTypeCode, label: docTypeLabel], list_items: docTypeItems, valueCode: docTypeCode],
    cwDoc_IssueDate: null,
    cwDoc_RelatedParty: [value: [code: relatedPartyCode, label: relatedPartyLabel], list_items: relatedItems, valueCode: relatedPartyCode, valueLabel: relatedPartyLabel]
  ]
} else {
  def standalone = [value: [code: docTypeCode, label: docTypeLabel], list_items: docTypeItems]
  data = [
    cwDoc_ShowRelatedSubmissionsList: &quot;NO&quot;,
    cwDoc_Document: document,
    cwDoc_StandaloneDocumentType: standalone,
    cwDoc_IssueDate: null,
    cwDoc_RelatedParty: relatedParty
  ]
  eventData = [
    cwDoc_ShowRelatedSubmissionsList: &quot;NO&quot;,
    cwDoc_Document: document,
    cwDoc_StandaloneDocumentType: [value: [code: docTypeCode, label: docTypeLabel], list_items: docTypeItems, valueCode: docTypeCode],
    cwDoc_IssueDate: null,
    cwDoc_RelatedParty: [value: [code: relatedPartyCode, label: relatedPartyLabel], list_items: relatedItems, valueCode: relatedPartyCode, valueLabel: relatedPartyLabel]
  ]
}

vars.put(&quot;uploadValidateBody&quot;, JsonOutput.toJson([
  data: data, event: event, event_data: data, event_token: vars.get(&quot;event_token&quot;), ignore_warning: false, case_reference: vars.get(&quot;Case_ID&quot;)
]))
vars.put(&quot;uploadEventBody&quot;, JsonOutput.toJson([
  data: eventData, event: event, event_token: vars.get(&quot;event_token&quot;), ignore_warning: false
]))</stringProp>
