              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def json = new JsonSlurper().parseText(body)
def findField = { id -&gt; (json.case_fields ?: []).find { it.id == id } }

def showRelated = (findField(&quot;cwDoc_ShowRelatedSubmissionsList&quot;)?.value ?: &quot;YES&quot;).toString()
def related = findField(&quot;cwDoc_RelatedParty&quot;)
def relatedItems = (related?.value?.list_items ?: []) as List
def relatedFirst = relatedItems ? relatedItems[0] : null

def relSub = findField(&quot;cwDoc_RelatedSubmission&quot;)
def relSubItems = (relSub?.value?.list_items ?: []) as List
def noneSub = relSubItems.find { it.code?.toString() == &quot;NONE&quot; } ?: (relSubItems ? relSubItems[-1] : null)

def typeFieldId = (showRelated == &quot;YES&quot;) ? &quot;cwDoc_RelatedSubmissionsDocumentType&quot; : &quot;cwDoc_StandaloneDocumentType&quot;
def docType = findField(typeFieldId)
def docTypeItems = (docType?.value?.list_items ?: []) as List
def wantedCode = vars.get(&quot;docTypeCode&quot;) ?: &quot;POSSESSION_NOTICE&quot;
def matched = docTypeItems.find { it.code?.toString() == wantedCode }
if (!matched &amp;&amp; docTypeItems) matched = docTypeItems[0]

vars.put(&quot;showRelatedSubmissions&quot;, showRelated)
vars.put(&quot;relatedPartyCode&quot;, relatedFirst?.code?.toString() ?: &quot;&quot;)
vars.put(&quot;relatedPartyLabel&quot;, relatedFirst?.label?.toString() ?: &quot;&quot;)
vars.put(&quot;relatedPartyListJson&quot;, JsonOutput.toJson(relatedItems))
vars.put(&quot;relatedSubmissionCode&quot;, noneSub?.code?.toString() ?: &quot;NONE&quot;)
vars.put(&quot;relatedSubmissionLabel&quot;, noneSub?.label?.toString() ?: &quot;Not related to an application or counterclaim&quot;)
vars.put(&quot;relatedSubmissionListJson&quot;, JsonOutput.toJson(relSubItems))
vars.put(&quot;docTypeCode&quot;, matched?.code?.toString() ?: wantedCode)
vars.put(&quot;docTypeLabel&quot;, matched?.label?.toString() ?: wantedCode)
vars.put(&quot;docTypeListJson&quot;, JsonOutput.toJson(docTypeItems))
vars.put(&quot;docTypeFieldId&quot;, typeFieldId)</stringProp>
