            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="CW_SC02_UploadDocument_Extract_Case_Id" enabled="false">
              <stringProp name="TestPlan.comments">Disabled: JSON picker in Map_Case_Id avoids pairing a linked CaseReference with another row STATE.</stringProp>
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">Case_id</stringProp>
              <stringProp name="RegexExtractor.regex">case_id&quot;\s*:\s*&quot;([^&quot;]+)&quot;[\s\S]*?&quot;\[STATE\]&quot;\s*:\s*&quot;CASE_ISSUED</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">NOT FOUND</stringProp>
              <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
              <stringProp name="RegexExtractor.match_number">0</stringProp>
            </RegexExtractor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC02_UploadDocument_Map_Case_Id" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def results = []
try {
    results = (new JsonSlurper().parseText(body).results ?: []) as List
} catch (Exception e) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;Search response not JSON: &quot; + e.message)
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    return
}

def issued = results.findAll { rec -&gt;
    def fields = rec?.case_fields ?: [:]
    def state = (fields[&apos;[STATE]&apos;] ?: &quot;&quot;).toString()
    state == &quot;CASE_ISSUED&quot; &amp;&amp; rec?.case_id
}.collect { it.case_id.toString() }

if (!issued) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;No CASE_ISSUED case in workbasket (count=&quot; + results.size() + &quot;)&quot;)
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    return
}

Collections.shuffle(issued)
def caseId = issued[0]
vars.put(&quot;Case_id&quot;, caseId)
vars.put(&quot;Case_ID&quot;, caseId)
log.info(&quot;[CWDocumentUpload] Picked CASE_ISSUED Case_ID=&quot; + caseId + &quot; from &quot; + issued.size() + &quot;/&quot; + results.size())
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
