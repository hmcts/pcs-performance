            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC01_ManageAmend_Validate_Search_Case">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def expectedCaseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
vars.put(&quot;amendReady&quot;, &quot;false&quot;)
vars.put(&quot;caseTryIndex&quot;, &quot;0&quot;)

if (!expectedCaseId) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;Case_ID missing from CSV&quot;)
  vars.put(&quot;caseIdListJson&quot;, &quot;[]&quot;)
  log.error(&quot;[CWAmend] Case_ID missing from CSV&quot;)
  return
}

def body = prev.getResponseDataAsString() ?: &quot;&quot;
if (prev.getResponseCode() != &quot;200&quot; || !body) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;Find case search failed HTTP=&quot; + prev.getResponseCode())
  vars.put(&quot;caseIdListJson&quot;, &quot;[]&quot;)
  return
}

def results = []
try {
  results = (new JsonSlurper().parseText(body).results ?: []) as List
} catch (Exception e) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;Find case response not JSON: &quot; + e.message)
  vars.put(&quot;caseIdListJson&quot;, &quot;[]&quot;)
  return
}

def found = results.any { (it?.case_id ?: &quot;&quot;).toString() == expectedCaseId }
if (!found) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;Case &quot; + expectedCaseId + &quot; not found in Find case results (count=&quot; + results.size() + &quot;)&quot;)
  vars.put(&quot;caseIdListJson&quot;, &quot;[]&quot;)
  log.error(&quot;[CWAmend] Case not found via SEARCH case_reference=&quot; + expectedCaseId)
  return
}

// Single searched case for amend flow
vars.put(&quot;Case_id&quot;, expectedCaseId)
vars.put(&quot;caseIdListJson&quot;, JsonOutput.toJson([expectedCaseId]))
log.info(&quot;[CWAmend] Find case OK Case_ID=&quot; + expectedCaseId)
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
