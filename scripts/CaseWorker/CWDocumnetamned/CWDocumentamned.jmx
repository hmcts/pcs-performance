            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.ui-start-event-trigger.v2+json;charset=UTF-8</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">experimental</stringProp>
                    <stringProp name="Header.value">true</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CW_SC01_ManageAmend_Extract_Event_Token">
                <stringProp name="JSONPostProcessor.referenceNames">event_token</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.event_token</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
              </JSONPostProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC01_ManageAmend_Pick_Folder_And_Document" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
            import groovy.json.JsonOutput

            def status = prev.getResponseCode() ?: &quot;&quot;
            def body = prev.getResponseDataAsString() ?: &quot;&quot;
            def ids = new JsonSlurper().parseText(vars.get(&quot;caseIdListJson&quot;) ?: &quot;[]&quot;) as List
            def idx = (vars.get(&quot;caseTryIndex&quot;) ?: &quot;0&quot;).toInteger()

            def advanceOrFail = { String reason -&gt;
            def next = idx + 1
            vars.put(&quot;caseTryIndex&quot;, next.toString())
            if (next &lt; ids.size()) {
            vars.put(&quot;Case_ID&quot;, ids[next].toString())
            vars.put(&quot;Case_id&quot;, ids[next].toString())
            vars.put(&quot;amendReady&quot;, &quot;false&quot;)
            prev.setSuccessful(true)
            prev.setResponseMessage(reason + &quot; | retry next case &quot; + ids[next] + &quot; (&quot; + (next + 1) + &quot;/&quot; + ids.size() + &quot;)&quot;)
            log.warn(&quot;[CWAmend] &quot; + reason + &quot; | next=&quot; + ids[next])
            } else {
            vars.put(&quot;amendReady&quot;, &quot;done_fail&quot;)
            prev.setSuccessful(false)
            prev.setResponseMessage(reason + &quot; | no more CASE_ISSUED cases to try (&quot; + ids.size() + &quot;)&quot;)
            log.error(&quot;[CWAmend] &quot; + reason + &quot; | exhausted &quot; + ids.size() + &quot; cases&quot;)
            }
            }

            if (status != &quot;200&quot;) {
            def snippet = body.replaceAll(&quot;\\s+&quot;, &quot; &quot;).take(250)
            advanceOrFail(&quot;amendDocuments trigger HTTP &quot; + status + &quot;: &quot; + snippet)
            return
            }

            def json
            try {
            json = new JsonSlurper().parseText(body)
            } catch (Exception e) {
            advanceOrFail(&quot;amendDocuments response not JSON: &quot; + e.message)
            return
            }

            def fields = (json.case_fields ?: []) as List
            def byId = fields.collectEntries { [(it.id): it] }

            def folders = [
            [code: &quot;STATEMENTS_OF_CASE&quot;, label: &quot;Statements of case&quot;, docField: &quot;statementsOfCaseDocuments&quot;, emptyField: &quot;documentAmend_StatementsOfCaseEmpty&quot;, folderId: &quot;statementsOfCase&quot;],
            [code: &quot;PROPERTY_DOCUMENTS&quot;, label: &quot;Property documents&quot;, docField: &quot;propertyDocuments&quot;, emptyField: &quot;documentAmend_PropertyDocumentsEmpty&quot;, folderId: &quot;propertyDocuments&quot;],
            [code: &quot;EVIDENCE&quot;, label: &quot;Evidence&quot;, docField: &quot;evidenceDocuments&quot;, emptyField: &quot;documentAmend_EvidenceEmpty&quot;, folderId: &quot;evidence&quot;],
            [code: &quot;HEARING_DOCUMENTS&quot;, label: &quot;Hearing documents&quot;, docField: &quot;hearingDocuments&quot;, emptyField: &quot;documentAmend_HearingDocumentsEmpty&quot;, folderId: &quot;hearingDocuments&quot;],
            [code: &quot;ORDERS_AND_NOTICE_OF_HEARINGS&quot;, label: &quot;Orders and Notice of Hearings&quot;, docField: &quot;ordersAndNoticeOfHearingsDocuments&quot;, emptyField: &quot;documentAmend_OrdersAndNoticeOfHearingsEmpty&quot;, folderId: &quot;ordersAndNoticeOfHearings&quot;],
            [code: &quot;APPLICATIONS&quot;, label: &quot;Applications&quot;, docField: &quot;applicationsDocuments&quot;, emptyField: &quot;documentAmend_ApplicationsEmpty&quot;, folderId: &quot;applications&quot;],
            [code: &quot;APPEALS&quot;, label: &quot;Appeals&quot;, docField: &quot;appealsDocuments&quot;, emptyField: &quot;documentAmend_AppealsEmpty&quot;, folderId: &quot;appeals&quot;],
            [code: &quot;CORRESPONDENCE&quot;, label: &quot;Correspondence&quot;, docField: &quot;correspondenceDocuments&quot;, emptyField: &quot;documentAmend_CorrespondenceEmpty&quot;, folderId: &quot;correspondence&quot;],
            [code: &quot;UNCATEGORISED_DOCUMENTS&quot;, label: &quot;Uncategorised documents&quot;, docField: &quot;uncategorisedDocuments&quot;, emptyField: &quot;documentAmend_UncategorisedDocumentsEmpty&quot;, folderId: &quot;uncategorisedDocuments&quot;]
            ]

            def emptyFlags = [:]
            folders.each { f -&gt;
            emptyFlags[f.emptyField] = (byId[f.emptyField]?.value ?: &quot;Yes&quot;).toString()
            }

            def chosen = null
            def items = []
            for (f in folders) {
            def docVal = byId[f.docField]?.value
            def listItems = (docVal?.list_items ?: []) as List
            if (listItems) {
            chosen = f
            items = listItems
            break
            }
            }

            if (!chosen) {
            advanceOrFail(&quot;No documents in any folder for case &quot; + vars.get(&quot;Case_ID&quot;))
            return
            }

            def firstDoc = items[0]
            vars.put(&quot;event_token&quot;, (json.event_token ?: vars.get(&quot;event_token&quot;) ?: &quot;&quot;).toString())
            vars.put(&quot;propertyAddress&quot;, (byId[&quot;documentAmend_PropertyAddressSummary&quot;]?.value ?: &quot;&quot;).toString())
            vars.put(&quot;selectedFolderCode&quot;, chosen.code)
            vars.put(&quot;selectedFolderLabel&quot;, chosen.label)
            vars.put(&quot;selectedFolderId&quot;, chosen.folderId)
            vars.put(&quot;selectedDocField&quot;, chosen.docField)
            vars.put(&quot;selectedDocCode&quot;, firstDoc.code?.toString() ?: &quot;&quot;)
            vars.put(&quot;selectedDocLabel&quot;, firstDoc.label?.toString() ?: &quot;&quot;)
            vars.put(&quot;selectedDocListJson&quot;, JsonOutput.toJson(items))
            vars.put(&quot;emptyFlagsJson&quot;, JsonOutput.toJson(emptyFlags))
            vars.put(&quot;amendReady&quot;, &quot;true&quot;)

            log.info(&quot;[CWAmend] case=&quot; + vars.get(&quot;Case_ID&quot;) + &quot; folder=&quot; + chosen.code + &quot; doc=&quot; + firstDoc.label + &quot; (&quot; + firstDoc.code + &quot;)&quot;)
            </stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="CW_SC01_ManageAmend_Fail_If_No_Amendable_Case">
            <stringProp name="IfController.condition">${__groovy(vars.get(&quot;amendReady&quot;) != &quot;true&quot;,)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="CW_SC01_ManageAmend_No_Amendable_Case">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def ids = vars.get(&quot;caseIdListJson&quot;)
SampleResult.setSuccessful(false)
SampleResult.setResponseCode(&quot;500&quot;)
SampleResult.setResponseMessage(&quot;No amendable document found after trying CASE_ISSUED cases: &quot; + ids)
log.error(&quot;[CWAmend] &quot; + SampleResult.getResponseMessage())
</stringProp>
            </JSR223Sampler>
            <hashTree/>
          </hashTree>
          <IfController guiclass="IfControllerPanel" testclass="IfController" testname="CW_SC01_ManageAmend_Continue_If_Case_Ready">
            <stringProp name="IfController.condition">${__groovy(vars.get(&quot;amendReady&quot;) == &quot;true&quot;,)}</stringProp>
            <boolProp name="IfController.evaluateAll">false</boolProp>
            <boolProp name="IfController.useExpression">true</boolProp>
          </IfController>
          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="CW_SC01_ManageAmend_10_POST_/data/case-types/PCS/validate?pageId=amendDocumentsselectDocument">
              <stringProp name="HTTPSampler.domain">${BASE_URL_1}</stringProp>
              <stringProp name="HTTPSampler.protocol">https</stringProp>
              <stringProp name="HTTPSampler.path">/data/case-types/PCS/validate?pageId=amendDocumentsselectDocument</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
                <collectionProp name="Arguments.arguments">
                  <elementProp name="" elementType="HTTPArgument">
                    <boolProp name="HTTPArgument.always_encode">false</boolProp>
                    <stringProp name="Argument.value">${selectDocumentValidateBody}</stringProp>
                    <stringProp name="Argument.metadata">=</stringProp>
                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC01_ManageAmend_Build_Select_Document_Body" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
  import groovy.json.JsonOutput

  def emptyFlags = new JsonSlurper().parseText(vars.get(&quot;emptyFlagsJson&quot;) ?: &quot;{}&quot;)
  def docItems = new JsonSlurper().parseText(vars.get(&quot;selectedDocListJson&quot;) ?: &quot;[]&quot;)
  def docField = vars.get(&quot;selectedDocField&quot;)
  def docCode = vars.get(&quot;selectedDocCode&quot;)
  def docLabel = vars.get(&quot;selectedDocLabel&quot;)

  def data = [:]
  data.documentAmend_PropertyAddressSummary = vars.get(&quot;propertyAddress&quot;)
  data.documentAmend_SelectedFolder = vars.get(&quot;selectedFolderCode&quot;)
  data[docField] = [
    value: [code: docCode, label: docLabel],
    list_items: docItems
  ]
  emptyFlags.each { k, v -&gt; data[k] = v }
  data.documentAmend_SelectedFolderId = null
  data.documentAmend_SelectedFolderLabel = null
  data.documentAmend_SelectedDocumentId = null
  data.documentAmend_SelectedDocumentFileName = null
  data.documentAmend_SelectedDocumentBaseFileName = null
  data.documentAmend_SelectedDocumentIssueDate = null
  data.documentAmend_RelatedPartyCode = null
  data.documentAmend_RelatedSubmissionCode = null
  data.documentAmend_RelatedSubmissionsDocumentTypeCode = null
  data.documentAmend_StandaloneDocumentTypeCode = null

  def event = [id: &quot;amendDocuments&quot;, summary: &quot;&quot;, description: &quot;&quot;]
  def body = [
    data: data,
    event: event,
    event_data: data,
    event_token: vars.get(&quot;event_token&quot;),
    ignore_warning: false,
    case_reference: vars.get(&quot;Case_ID&quot;)
  ]
  vars.put(&quot;selectDocumentValidateBody&quot;, JsonOutput.toJson(body))
  </stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.case-data-validate.v2+json;charset=UTF-8</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">experimental</stringProp>
                    <stringProp name="Header.value">true</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC01_ManageAmend_Store_Amend_Bodies" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
  import groovy.json.JsonOutput

  def body = prev.getResponseDataAsString() ?: &quot;&quot;
  def json = new JsonSlurper().parseText(body)
  def data = (json.data ?: [:]) as Map

  def asList = { v -&gt; (v instanceof List) ? v : [] }

  def pickValue = { field, preferredCode = null -&gt;
    if (!(field instanceof Map)) return null
    def items = asList(field.list_items)
    def val = field.value
    if (val instanceof Map &amp;&amp; val.code) return [value: [code: val.code, label: val.label], list_items: items]
    if (preferredCode) {
      def m = items.find { it.code?.toString() == preferredCode }
      if (m) return [value: [code: m.code, label: m.label], list_items: items]
    }
    if (items) {
      def first = items[0]
      return [value: [code: first.code, label: first.label], list_items: items]
    }
    return [list_items: items]
  }

  def withCodes = { dyn, includeLabel = false -&gt;
    if (!(dyn instanceof Map)) return dyn
    def out = new LinkedHashMap(dyn)
    if (dyn.value instanceof Map) {
      out.valueCode = dyn.value.code
      if (includeLabel) out.valueLabel = dyn.value.label
    }
    return out
  }

  def showRelated = (data.documentAmend_ShowRelatedSubmissionsList ?: &quot;NO&quot;).toString()
  def relatedSubmission = pickValue(data.documentAmend_RelatedSubmission, &quot;NONE&quot;)
  def relatedParty = pickValue(data.documentAmend_RelatedParty)
  def relatedDocType = pickValue(data.documentAmend_RelatedSubmissionsDocumentType)
  def standaloneDocType = pickValue(data.documentAmend_StandaloneDocumentType)
  def amendedFileName = (data.documentAmend_AmendedFileName ?: vars.get(&quot;selectedDocLabel&quot;) ?: &quot;document&quot;).toString()

  // Prefer values returned by callback for selected folder/doc
  def folderCode = (data.documentAmend_SelectedFolder ?: vars.get(&quot;selectedFolderCode&quot;)).toString()
  def folderId = (data.documentAmend_SelectedFolderId ?: vars.get(&quot;selectedFolderId&quot;)).toString()
  def folderLabel = (data.documentAmend_SelectedFolderLabel ?: vars.get(&quot;selectedFolderLabel&quot;)).toString()
  def docId = (data.documentAmend_SelectedDocumentId ?: vars.get(&quot;selectedDocCode&quot;)).toString()
  def docFileName = (data.documentAmend_SelectedDocumentFileName ?: vars.get(&quot;selectedDocLabel&quot;)).toString()
  def docBase = (data.documentAmend_SelectedDocumentBaseFileName ?: amendedFileName).toString()
  def docField = vars.get(&quot;selectedDocField&quot;)
  def docItems = new JsonSlurper().parseText(vars.get(&quot;selectedDocListJson&quot;) ?: &quot;[]&quot;)
  def emptyFlags = new JsonSlurper().parseText(vars.get(&quot;emptyFlagsJson&quot;) ?: &quot;{}&quot;)

  def selectedDocDyn = withCodes([
    value: [code: docId, label: docFileName],
    list_items: docItems
  ], true)

  def detailsData = [
    documentAmend_AmendedFileName: amendedFileName,
    documentAmend_ShowRelatedSubmissionsList: showRelated,
    documentAmend_RelatedSubmission: relatedSubmission,
    documentAmend_IssueDate: data.documentAmend_SelectedDocumentIssueDate,
    documentAmend_RelatedParty: relatedParty
  ]
  if (showRelated == &quot;YES&quot;) {
    detailsData.documentAmend_RelatedSubmissionsDocumentType = relatedDocType
  } else {
    detailsData.documentAmend_StandaloneDocumentType = standaloneDocType
  }

  def event = [id: &quot;amendDocuments&quot;, summary: &quot;&quot;, description: &quot;&quot;]
  def detailsBody = [
    data: detailsData,
    event: event,
    event_data: detailsData,
    event_token: vars.get(&quot;event_token&quot;),
    ignore_warning: false,
    case_reference: vars.get(&quot;Case_ID&quot;)
  ]
  vars.put(&quot;amendDetailsValidateBody&quot;, JsonOutput.toJson(detailsBody))

  def relatedPartyCode = relatedParty?.value?.code
  def relatedSubmissionCode = relatedSubmission?.value?.code
  def relatedDocTypeCode = (showRelated == &quot;YES&quot;) ? relatedDocType?.value?.code : null
  def standaloneDocTypeCode = (showRelated == &quot;YES&quot;) ? null : standaloneDocType?.value?.code

  def eventData = [:]
  eventData.documentAmend_PropertyAddressSummary = data.documentAmend_PropertyAddressSummary ?: vars.get(&quot;propertyAddress&quot;)
  eventData.documentAmend_SelectedFolder = folderCode
  eventData[docField] = selectedDocDyn
  emptyFlags.each { k, v -&gt; eventData[k] = data[k] ?: v }
  eventData.documentAmend_SelectedFolderId = folderId
  eventData.documentAmend_SelectedFolderLabel = folderLabel
  eventData.documentAmend_SelectedDocumentId = docId
  eventData.documentAmend_SelectedDocumentFileName = docFileName
  eventData.documentAmend_SelectedDocumentBaseFileName = docBase
  eventData.documentAmend_SelectedDocumentIssueDate = data.documentAmend_SelectedDocumentIssueDate
  eventData.documentAmend_RelatedPartyCode = relatedPartyCode
  eventData.documentAmend_RelatedSubmissionCode = relatedSubmissionCode
  eventData.documentAmend_RelatedSubmissionsDocumentTypeCode = relatedDocTypeCode
  eventData.documentAmend_StandaloneDocumentTypeCode = standaloneDocTypeCode
  eventData.documentAmend_AmendedFileName = amendedFileName
  eventData.documentAmend_ShowRelatedSubmissionsList = showRelated
  eventData.documentAmend_RelatedSubmission = withCodes(relatedSubmission, false)
  if (showRelated == &quot;YES&quot;) {
    eventData.documentAmend_RelatedSubmissionsDocumentType = withCodes(relatedDocType, false)
    eventData.documentAmend_StandaloneDocumentType = null
  } else {
    eventData.documentAmend_StandaloneDocumentType = withCodes(standaloneDocType, false)
    eventData.documentAmend_RelatedSubmissionsDocumentType = null
  }
  eventData.documentAmend_IssueDate = data.documentAmend_SelectedDocumentIssueDate
  eventData.documentAmend_RelatedParty = withCodes(relatedParty, true)

  def eventBody = [
    data: eventData,
    event: event,
    event_token: vars.get(&quot;event_token&quot;),
    ignore_warning: false
  ]
  vars.put(&quot;amendEventBody&quot;, JsonOutput.toJson(eventBody))

  log.info(&quot;[CWAmend] details fileName=&quot; + amendedFileName + &quot; showRelated=&quot; + showRelated + &quot; party=&quot; + relatedPartyCode)
  </stringProp>
