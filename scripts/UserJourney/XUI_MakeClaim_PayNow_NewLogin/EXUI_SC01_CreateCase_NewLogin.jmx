              <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">// Get target value
String token27b = vars.get(&quot;XSRF-TOKEN27-b&quot;);

if (token27b == null || token27b.trim().equals(&quot;&quot;)) {
    
    String token27a = vars.get(&quot;XSRF-TOKEN27-a&quot;);
    
    if (token27a != null &amp;&amp; !token27a.trim().equals(&quot;&quot;)) {
        vars.put(&quot;XSRF-TOKEN27-b&quot;, token27a);
        log.info(&quot;XSRF-TOKEN27-b not found, copied value from XSRF-TOKEN27-a&quot;);
    } else {
        log.warn(&quot;Both XSRF-TOKEN27-b and XSRF-TOKEN27-a are empty.&quot;);
    }
} else {
    log.info(&quot;XSRF-TOKEN27-b already exists: &quot; + token27b);
}</stringProp>
              </BeanShellPostProcessor>
