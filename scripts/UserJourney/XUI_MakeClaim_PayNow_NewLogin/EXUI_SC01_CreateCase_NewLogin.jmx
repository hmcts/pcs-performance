                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="script">// Get target value
String token21N = vars.get(&quot;XSRF-TOKEN21&quot;);

if (token21N == null || token21N.trim().equals(&quot;&quot;)) {
    
    String token20N = vars.get(&quot;XSRF-TOKEN20&quot;);
    
    if (token20N != null &amp;&amp; !token20N.trim().equals(&quot;&quot;)) {
        vars.put(&quot;XSRF-TOKEN21&quot;, token20N);
        log.info(&quot;XSRF-TOKEN21 not found, copied value from XSRF-TOKEN20&quot;);
    } else {
        log.warn(&quot;Both XSRF-TOKEN21 and XSRF-TOKEN20 are empty.&quot;);
    }
} else {
    log.info(&quot;XSRF-TOKEN21 already exists: &quot; + token21N);
}</stringProp>
