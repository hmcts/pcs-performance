                <stringProp name="script">// Get target value
String token37c = vars.get(&quot;XSRF-TOKEN37-c&quot;);

if (token37c == null || token37c.trim().equals(&quot;&quot;)) {
    
    String token37b = vars.get(&quot;XSRF-TOKEN37-b&quot;);
    
    if (token37b != null &amp;&amp; !token37b.trim().equals(&quot;&quot;)) {
        vars.put(&quot;XSRF-TOKEN37-c&quot;, token37b);
        log.info(&quot;XSRF-TOKEN37-c not found, copied value from XSRF-TOKEN37-b&quot;);
    } else {
        log.warn(&quot;Both XSRF-TOKEN37-c and XSRF-TOKEN37-b are empty.&quot;);
    }
} else {
    log.info(&quot;XSRF-TOKEN37-c already exists: &quot; + token37c);
}</stringProp>
