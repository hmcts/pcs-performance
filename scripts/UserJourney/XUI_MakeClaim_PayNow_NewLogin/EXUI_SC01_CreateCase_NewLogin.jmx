                <stringProp name="script">// Get values
String token21 = vars.get(&quot;XSRF-TOKEN13-a&quot;);

if (token21 == null || token21.trim().equals(&quot;&quot;)) {
    
    String token20 = vars.get(&quot;XSRF-favicon-1&quot;);
    
    if (token20 != null &amp;&amp; !token20.trim().equals(&quot;&quot;)) {
        vars.put(&quot;XSRF-TOKEN13-a&quot;, token20);
        log.info(&quot;XSRF-TOKEN13-a not found, copied value from XSRF-favicon-1&quot;);
    } else {
        log.warn(&quot;Both XSRF-TOKEN13-a and XSRF-favicon-1 are empty.&quot;);
    }
} else {
    log.info(&quot;XSRF-TOKEN13-a already exists: &quot; + token21);
}</stringProp>
