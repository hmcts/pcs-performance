              <stringProp name="parameters"></stringProp>
              <stringProp name="script">vars.put(&quot;amendEventTriggerJson&quot;, prev.getResponseDataAsString() ?: &quot;&quot;)
def headers = prev.getResponseHeaders() ?: &quot;&quot;
def matcher = (headers =~ /(?i)Set-Cookie: XSRF-TOKEN=([^;\r\n]+)/)
def token = null
while (matcher.find()) { token = matcher.group(1) }
if (!token) { token = vars.get(&quot;xsrf_token&quot;) }
if (token) { vars.put(&quot;xsrf_token&quot;, token) }

</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
