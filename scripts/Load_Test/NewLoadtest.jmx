              <collectionProp name="Asserion.test_strings">
                <stringProp name="1152837671">Manage documents: Remove</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message"></stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
              <boolProp name="Assertion.assume_success">false</boolProp>
              <intProp name="Assertion.test_type">2</intProp>
            </ResponseAssertion>
            <hashTree/>
          </hashTree>
          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="CW_SC03_RemoveDocument_14_Validate_Select_Document" enabled="true">
            <stringProp name="HTTPSampler.domain">${BASE_URL_1}</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/data/case-types/PCS/validate?pageId=removeDocumentselectDocumentToRemove</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${removeValidateBody}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC03_RemoveDocument_Build_Validate_Body" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def emptyFlags = new JsonSlurper().parseText(vars.get(&quot;removeEmptyFlagsJson&quot;) ?: &quot;{}&quot;)
def docItems = new JsonSlurper().parseText(vars.get(&quot;removeDocListJson&quot;) ?: &quot;[]&quot;)
def docField = vars.get(&quot;removeDocField&quot;)
def reasonField = vars.get(&quot;removeReasonField&quot;)
if (!docField || !reasonField) {
    vars.put(&quot;removeValidateBody&quot;, &quot;{}&quot;)
    log.warn(&quot;[CWRemove] skip validate body — missing field names after failed upload&quot;)
    return
}

def data = [:]
data.documentRemoval_PropertyAddressSummary = vars.get(&quot;removePropertyAddress&quot;)
data.documentRemoval_SelectedFolder = vars.get(&quot;removeFolderCode&quot;)
data[docField] = [
  value: [code: vars.get(&quot;removeDocCode&quot;), label: vars.get(&quot;removeDocLabel&quot;)],
  list_items: docItems
]
emptyFlags.each { k, v -&gt; if (k != null) data[k] = v }
data[reasonField] = vars.get(&quot;removeReason&quot;) ?: &quot;Test&quot;
data.documentRemoval_SelectedDocumentId = null
data.documentRemoval_SelectedDocumentFileName = null

def event = [id: &quot;removeDocument&quot;, summary: &quot;&quot;, description: &quot;&quot;]
def body = [
  data: data,
  event: event,
  event_data: data,
  event_token: vars.get(&quot;remove_event_token&quot;),
  ignore_warning: false,
  case_reference: vars.get(&quot;Case_ID&quot;)
]
def jsonBody = JsonOutput.toJson(body)
vars.put(&quot;removeValidateBody&quot;, jsonBody)

</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.case-data-validate.v2+json;charset=UTF-8</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">experimental</stringProp>
                  <stringProp name="Header.value">true</stringProp>
                </elementProp>
              </collectionProp>
