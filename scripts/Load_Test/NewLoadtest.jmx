              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC02_UploadDocument_Map_Case_Id" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

def page = (vars.get(&quot;workbasketPage&quot;) ?: &quot;1&quot;) as int

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def httpCode = prev.getResponseCode() ?: &quot;&quot;
def parsed = null
if (httpCode != &quot;200&quot;) {
    def next = page + 1
    vars.put(&quot;workbasketPage&quot;, next.toString())
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    prev.setSuccessful(true)
    prev.setResponseMessage(&quot;Search HTTP &quot; + httpCode + &quot; page=&quot; + page + &quot;, retry page=&quot; + next)
    log.warn(&quot;[CWDocumentUpload] Search HTTP &quot; + httpCode + &quot; page=&quot; + page + &quot; -&gt; &quot; + next)
    if (page &gt;= 20) {
        vars.put(&quot;casePickStop&quot;, &quot;true&quot;)
    }
    return
}
try {
    parsed = new JsonSlurper().parseText(body)
} catch (Exception e) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;Search response not JSON: &quot; + e.message)
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    vars.put(&quot;casePickStop&quot;, &quot;true&quot;)
    return
}

def results = (parsed?.results ?: []) as List
def pageCases = results.findAll { rec -&gt;
    def id = rec?.case_id?.toString()
    def state = rec?.case_fields?.get(&quot;[STATE]&quot;)
    id &amp;&amp; (state == null || state.toString() == &quot;PENDING_CASE_ISSUED&quot;)
}.collect { it.case_id.toString() }

def jsonTotal = parsed?.total
def headers = prev.getResponseHeaders() ?: &quot;&quot;
def tm = (headers =~ /(?i)X-Total-Count:\\s*(\\d+)/)
def total = tm.find() ? (tm.group(1) as int) : (jsonTotal instanceof Number ? (jsonTotal as int) : -1)
def lastPage = total &gt; 0 ? (int) Math.ceil(total / 25.0) : -1
def pageInfo = &quot;state=PENDING_CASE_ISSUED page=&quot; + page + &quot; resultCount=&quot; + results.size() + &quot; pageCaseCount=&quot; + pageCases.size() + &quot; total=&quot; + total + &quot; lastPage=&quot; + lastPage
log.info(&quot;[CWDocumentUpload] &quot; + pageInfo)

if (!pageCases) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;No PENDING_CASE_ISSUED cases in workbasket | &quot; + pageInfo)
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    vars.put(&quot;casePickStop&quot;, &quot;true&quot;)
    return
}

def usedKey = vars.get(&quot;claimedCasesPropKey&quot;) ?: &quot;CW_CLAIMED_CASE_IDS&quot;
def caseId = null
synchronized (usedKey.intern()) {
    def used = (props.get(usedKey) ?: &quot;&quot;) as String
    def usedSet = used ? (used.split(&quot;,&quot;) as List).findAll { it } as Set : new LinkedHashSet()
    caseId = pageCases.find { !usedSet.contains(it) }
    if (caseId) {
        usedSet.add(caseId)
        props.put(usedKey, usedSet.join(&quot;,&quot;))
    }
}
if (!caseId) {
    if (lastPage &gt; 0 &amp;&amp; page &gt;= lastPage) {
        prev.setSuccessful(false)
        prev.setResponseMessage(&quot;No unused PENDING_CASE_ISSUED case left | &quot; + pageInfo)
        vars.put(&quot;Case_ID&quot;, &quot;&quot;)
        vars.put(&quot;casePickStop&quot;, &quot;true&quot;)
        log.error(&quot;[CWDocumentUpload] All PENDING_CASE_ISSUED cases already claimed | &quot; + pageInfo)
        return
    }
    vars.put(&quot;workbasketPage&quot;, (page + 1).toString())
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    prev.setResponseMessage(&quot;PENDING_CASE_ISSUED page &quot; + page + &quot; exhausted, next page=&quot; + (page + 1) + &quot; | &quot; + pageInfo)
    log.info(&quot;[CWDocumentUpload] page exhausted, next=&quot; + (page + 1) + &quot; | &quot; + pageInfo)
    return
}
def attempts = ((vars.get(&quot;casePickAttempts&quot;) ?: &quot;0&quot;) as int) + 1
vars.put(&quot;casePickAttempts&quot;, attempts.toString())
vars.put(&quot;Case_id&quot;, caseId)
vars.put(&quot;Case_ID&quot;, caseId)
prev.setResponseMessage(&quot;Claimed &quot; + caseId + &quot; | &quot; + pageInfo)
log.info(&quot;[CWDocumentUpload] Claimed PENDING_CASE_ISSUED Case_ID=&quot; + caseId + &quot; | &quot; + pageInfo)
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
