            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC02_UploadDocument_Store_Uploaded_Collection_Id" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper

def raw = prev.getResponseDataAsString() ?: &quot;&quot;
def docUrl = vars.get(&quot;doc_url&quot;) ?: &quot;&quot;
def uuid = &quot;&quot;
def m = (docUrl =~ /([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/)
if (m.find()) uuid = m.group(1)

def collectionId = &quot;&quot;
def categoryId = &quot;&quot;
def storedName = &quot;&quot;
try {
  def json = new JsonSlurper().parseText(raw)
  def found = null
  def walk
  walk = { obj -&gt;
    if (found) return
    if (obj instanceof Map) {
      def val = obj.value
      def url = &quot;&quot;
      if (val instanceof Map) url = (val.document_url ?: &quot;&quot;).toString()
      if (uuid &amp;&amp; url.contains(uuid) &amp;&amp; obj.id) {
        found = obj
        return
      }
      obj.each { k, v -&gt; walk(v) }
    } else if (obj instanceof List) {
      obj.each { walk(it) }
    }
  }
  walk(json.data ?: json)
  if (found) {
    collectionId = found.id?.toString() ?: &quot;&quot;
    categoryId = (found.value?.category_id ?: &quot;&quot;).toString()
    storedName = (found.value?.document_filename ?: &quot;&quot;).toString()
  }
} catch (Exception e) {
  log.warn(&quot;[CWRemove] could not map uploaded collection id: &quot; + e.message)
}

vars.put(&quot;uploadedCollectionId&quot;, collectionId)
vars.put(&quot;uploadedCategoryId&quot;, categoryId)
vars.put(&quot;uploadedStoredFilename&quot;, storedName)
def ok = prev.isSuccessful() &amp;&amp; prev.getResponseCode() == &quot;201&quot;
vars.put(&quot;uploadSucceeded&quot;, ok ? &quot;true&quot; : &quot;false&quot;)
log.info(&quot;[CWRemove] uploaded collectionId=&quot; + collectionId + &quot; file=&quot; + storedName + &quot; uploadSucceeded=&quot; + vars.get(&quot;uploadSucceeded&quot;))

// #region agent log
try { new File(&quot;/Users/priyadharsini/Desktop/Gatling/.cursor/debug-6433cf.log&quot;).append(groovy.json.JsonOutput.toJson([sessionId:&quot;6433cf&quot;,timestamp:System.currentTimeMillis(),location:&quot;CWDocumentUploadAmendRemove.jmx:Submit_Upload&quot;,message:&quot;upload-submit-result&quot;,hypothesisId:&quot;C&quot;,runId:&quot;post-fix&quot;,data:[code:prev.getResponseCode(),success:prev.isSuccessful(),Case_ID:vars.get(&quot;Case_ID&quot;),uploadedCollectionId:vars.get(&quot;uploadedCollectionId&quot;),uploadedStoredFilename:vars.get(&quot;uploadedStoredFilename&quot;),uploadSucceeded:vars.get(&quot;uploadSucceeded&quot;)]]) + &quot;\n&quot;) } catch (Exception ignored) {}
// #endregion
