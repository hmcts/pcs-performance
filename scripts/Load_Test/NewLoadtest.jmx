              <hashTree>
                <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                  <collectionProp name="HeaderManager.headers">
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">Accept</stringProp>
                      <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.ui-start-event-trigger.v2+json;charset=UTF-8</stringProp>
                    </elementProp>
                    <elementProp name="" elementType="Header">
                      <stringProp name="Header.name">experimental</stringProp>
                      <stringProp name="Header.value">true</stringProp>
                    </elementProp>
                  </collectionProp>
                </HeaderManager>
                <hashTree/>
                <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CW_SC02_UploadDocument_Extract_Event_Token" enabled="true">
                  <stringProp name="JSONPostProcessor.referenceNames">event_token</stringProp>
                  <stringProp name="JSONPostProcessor.jsonPathExprs">$.event_token</stringProp>
                  <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
                  <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
                </JSONPostProcessor>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC02_UploadDocument_Store_Trigger_Fields" enabled="true">
                  <stringProp name="cacheKey">false</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper
  import groovy.json.JsonOutput

  def status = prev.getResponseCode() ?: &quot;&quot;
  vars.put(&quot;uploadStartOk&quot;, &quot;false&quot;)
  def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;
  def body = prev.getResponseDataAsString() ?: &quot;&quot;
  def titleOk = body.contains(&quot;Manage documents: Upload&quot;)
  if (status != &quot;200&quot; || !titleOk) {
      vars.put(&quot;uploadSucceeded&quot;, &quot;false&quot;)
      vars.put(&quot;caseHasUploadEvent&quot;, &quot;false&quot;)
      prev.setSuccessful(true)
      prev.setResponseMessage(&quot;Skip Case_ID=&quot; + caseId + &quot; start HTTP &quot; + status + &quot; (trying next PENDING_CASE_ISSUED case)&quot;)
      log.warn(&quot;[CW] Skip start HTTP &quot; + status + &quot; Case_ID=&quot; + caseId + &quot; &quot; + body.take(250))
      return
  }
  vars.put(&quot;uploadStartOk&quot;, &quot;true&quot;)
  vars.put(&quot;caseHasUploadEvent&quot;, &quot;true&quot;)
  def json = new JsonSlurper().parseText(body)

  def findField = { id -&gt;
      def fields = json.case_fields ?: []
      return fields.find { it.id == id }
  }

  def related = findField(&quot;cwDoc_RelatedParty&quot;)
  def docType = findField(&quot;cwDoc_StandaloneDocumentType&quot;)

  def relatedItems = (related?.value?.list_items ?: []) as List
  def docTypeItems = (docType?.value?.list_items ?: []) as List

  def relatedFirst = relatedItems ? relatedItems[0] : null
  def relatedPartyCode = relatedFirst?.code?.toString() ?: &quot;&quot;
  def relatedPartyLabel = relatedFirst?.label?.toString() ?: &quot;&quot;

  def wantedCode = vars.get(&quot;docTypeCode&quot;) ?: &quot;RENT_STATEMENT&quot;
  def matched = docTypeItems.find { it.code?.toString() == wantedCode }
  if (!matched &amp;&amp; docTypeItems) {
      matched = docTypeItems[0]
  }
  def docTypeCode = matched?.code?.toString() ?: wantedCode
  def docTypeLabel = matched?.label?.toString() ?: wantedCode

  vars.put(&quot;relatedPartyCode&quot;, relatedPartyCode)
  vars.put(&quot;relatedPartyLabel&quot;, relatedPartyLabel)
  vars.put(&quot;docTypeCode&quot;, docTypeCode)
  vars.put(&quot;docTypeLabel&quot;, docTypeLabel)
  vars.put(&quot;relatedPartyListJson&quot;, JsonOutput.toJson(relatedItems))
  vars.put(&quot;docTypeListJson&quot;, JsonOutput.toJson(docTypeItems))

  </stringProp>
