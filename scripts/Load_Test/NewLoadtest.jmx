          <stringProp name="HTTPSampler.path">/data/internal/searchCases?ctid=PCS&amp;use_case=WORKBASKET&amp;view=WORKBASKET&amp;state=CASE_ISSUED&amp;page=1</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
