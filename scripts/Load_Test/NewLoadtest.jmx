          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CC_SC01_CreateCaseFlag_Force_Case_Issued_Page" enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def key = &quot;CW_WB_PAGE_&quot; + ctx.getThread().getThreadName()
def iteration = 1
synchronized (key.intern()) {
    iteration = ((props.get(key) ?: &quot;0&quot;) as int) + 1
    props.put(key, iteration.toString())
}
vars.put(&quot;workbasketPage&quot;, iteration.toString())
def path = &quot;/data/internal/searchCases?ctid=PCS&amp;use_case=WORKBASKET&amp;view=WORKBASKET&amp;state=CASE_ISSUED&amp;page=&quot; + iteration
sampler.setPath(path)
sampler.setProperty(&quot;HTTPSampler.path&quot;, path)
log.info(&quot;[CCCreateFlag] CASE_ISSUED workbasket page=&quot; + iteration + &quot; path=&quot; + sampler.getPath())
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
            <collectionProp name="HeaderManager.headers">
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Accept</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Content-Type</stringProp>
                <stringProp name="Header.value">application/json</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">Origin</stringProp>
                <stringProp name="Header.value">https://manage-case.perftest.platform.hmcts.net</stringProp>
              </elementProp>
              <elementProp name="" elementType="Header">
                <stringProp name="Header.name">experimental</stringProp>
                <stringProp name="Header.value">true</stringProp>
              </elementProp>
            </collectionProp>
          </HeaderManager>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Pick Live Workbasket Case" enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def ids = []
try { ids = (new JsonSlurper().parseText(body).results ?: []).collect { it?.case_id?.toString() }.findAll { it } } catch (ignored) {}
vars.put(&quot;wbCaseIds_rawNr&quot;, ids.size().toString())
def claimed = props.get(&quot;__CC_CREATE_CLAIMED_IDS__&quot;)
if (claimed instanceof Set) { ids = ids.findAll { !claimed.contains(it) } }
def cwClaimed = (props.get(&quot;CW_CLAIMED_CASE_IDS&quot;) ?: &quot;&quot;) as String
if (cwClaimed) {
    def claimedSet = cwClaimed.split(&quot;,&quot;) as List
    ids = ids.findAll { !claimedSet.contains(it) }
}
ids.eachWithIndex { id, i -&gt; vars.put(&quot;wbCaseIds_&quot; + (i+1), id) }
vars.put(&quot;wbCaseIds_matchNr&quot;, ids.size().toString())
vars.put(&quot;createFlagsFound&quot;, &quot;false&quot;)


