              <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor event_token" enabled="true">
                <stringProp name="JSONPostProcessor.referenceNames">event_token</stringProp>
                <stringProp name="JSONPostProcessor.jsonPathExprs">$.event_token</stringProp>
                <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
