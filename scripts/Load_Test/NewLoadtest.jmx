            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="JSON Extractor amend_event_token" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">amend_event_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.event_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers"></stringProp>
