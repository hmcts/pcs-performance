        <TransactionController guiclass="TransactionControllerGui" testclass="TransactionController" testname="CC_SC01_AddCaseNote_02_Login" enabled="true">
          <boolProp name="TransactionController.parent">true</boolProp>
          <boolProp name="TransactionController.includeTimers">false</boolProp>
        </TransactionController>
        <hashTree>
