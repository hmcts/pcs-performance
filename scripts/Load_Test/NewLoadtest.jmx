      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp - Reserve shared cases">
        <stringProp name="TestPlan.comments">Runs once before CW document journeys. Reserves Amend CSV Case_IDs so Upload/Remove cannot take them. Harmless if those groups are disabled.</stringProp>
        <intProp name="ThreadGroup.num_threads">1</intProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </SetupThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reserve Amend Case_IDs in shared pool" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer

def toRemove = []
props.propertyNames().each { n -&gt;
    def k = n.toString()
    if (k.startsWith(&quot;CW_WB_PAGE_&quot;) || k == &quot;CW_CLAIMED_CASE_IDS&quot;) {
        toRemove &lt;&lt; k
    }
}
toRemove.each { props.remove(it) }
log.info(&quot;[CWSharedPool] Cleared persisted page counters and claimed-case pool for a fresh run&quot;)

def usedKey = &quot;CW_CLAIMED_CASE_IDS&quot;
def base = FileServer.getFileServer().getBaseDir()
def f = new File(base, &quot;CWDocumentamned_users_Input.csv&quot;)
def ids = []
if (f.exists()) {
    def first = true
    f.eachLine { line -&gt;
        if (first) {
            first = false
            return
        }
        def parts = line.split(&quot;,&quot;, -1)
        if (parts.length &gt;= 2) {
            def id = parts[1].trim()
            if (id) {
                ids &lt;&lt; id
            }
        }
    }
}
synchronized (usedKey.intern()) {
    def used = (props.get(usedKey) ?: &quot;&quot;) as String
    def usedSet = used ? (used.split(&quot;,&quot;) as List).findAll { it } as Set : new LinkedHashSet()
    ids.each { usedSet.add(it) }
    props.put(usedKey, usedSet.join(&quot;,&quot;))
}
log.info(&quot;[CWSharedPool] Reserved &quot; + ids.size() + &quot; Amend CSV Case_IDs so Upload/Remove cannot take them&quot;)
</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
