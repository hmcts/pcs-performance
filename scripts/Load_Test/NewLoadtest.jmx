            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC03_RemoveDocument_Force_Case_Issued_Filter" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def page = vars.get(&quot;workbasketPage&quot;) ?: &quot;1&quot;
vars.put(&quot;PageToChoose&quot;, &quot;state=PENDING_CASE_ISSUED&amp;page=&quot; + page)
def path = &quot;/data/internal/searchCases?ctid=PCS&amp;use_case=WORKBASKET&amp;view=WORKBASKET&amp;state=PENDING_CASE_ISSUED&amp;page=&quot; + page
sampler.setPath(path)
sampler.setProperty(&quot;HTTPSampler.path&quot;, path)
log.info(&quot;[CWDocumentRemove] CASE_ISSUED workbasket filter path=&quot; + sampler.getPath())
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">experimental</stringProp>
                    <stringProp name="Header.value">true</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="CW_SC02_UploadDocument_Extract_Case_Id" enabled="false">
                <stringProp name="TestPlan.comments">Disabled: JSON picker in Map_Case_Id avoids pairing a linked CaseReference with another row STATE.</stringProp>
                <stringProp name="RegexExtractor.useHeaders">false</stringProp>
                <stringProp name="RegexExtractor.refname">Case_id</stringProp>
                <stringProp name="RegexExtractor.regex">case_id&quot;\s*:\s*&quot;([^&quot;]+)&quot;[\s\S]*?&quot;\[STATE\]&quot;\s*:\s*&quot;CASE_ISSUED</stringProp>
                <stringProp name="RegexExtractor.template">$1$</stringProp>
                <stringProp name="RegexExtractor.default">NOT FOUND</stringProp>
                <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
                <stringProp name="RegexExtractor.match_number">0</stringProp>
              </RegexExtractor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC02_UploadDocument_Map_Case_Id" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

def page = (vars.get(&quot;workbasketPage&quot;) ?: &quot;1&quot;) as int

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def httpCode = prev.getResponseCode() ?: &quot;&quot;
def parsed = null
if (httpCode != &quot;200&quot;) {
    def next = page + 1
    vars.put(&quot;workbasketPage&quot;, next.toString())
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    prev.setSuccessful(true)
    prev.setResponseMessage(&quot;Search HTTP &quot; + httpCode + &quot; page=&quot; + page + &quot;, retry page=&quot; + next)
    log.warn(&quot;[CWDocumentRemove] Search HTTP &quot; + httpCode + &quot; page=&quot; + page + &quot; -&gt; &quot; + next)
    if (page &gt;= 20) {
        vars.put(&quot;casePickStop&quot;, &quot;true&quot;)
    }
    return
}
try {
    parsed = new JsonSlurper().parseText(body)
} catch (Exception e) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;Search response not JSON: &quot; + e.message)
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    vars.put(&quot;casePickStop&quot;, &quot;true&quot;)
    return
}

def results = (parsed?.results ?: []) as List
def pageCases = results.findAll { rec -&gt;
    def id = rec?.case_id?.toString()
    def state = rec?.case_fields?.get(&quot;[STATE]&quot;)
    id &amp;&amp; (state == null || state.toString() == &quot;PENDING_CASE_ISSUED&quot;)
}.collect { it.case_id.toString() }

def jsonTotal = parsed?.total
def lastPage = jsonTotal instanceof Number ? (int) Math.ceil((jsonTotal as int) / 25.0) : -1
def pageInfo = &quot;state=PENDING_CASE_ISSUED page=&quot; + page + &quot; resultCount=&quot; + results.size() + &quot; pageCaseCount=&quot; + pageCases.size() + &quot; total=&quot; + jsonTotal + &quot; lastPage=&quot; + lastPage
log.info(&quot;[CWDocumentRemove] &quot; + pageInfo)

if (!pageCases) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;No PENDING_CASE_ISSUED cases in workbasket | &quot; + pageInfo)
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    vars.put(&quot;casePickStop&quot;, &quot;true&quot;)
    return
}

def usedKey = vars.get(&quot;claimedCasesPropKey&quot;) ?: &quot;CW_CLAIMED_CASE_IDS&quot;
def caseId = null
synchronized (usedKey.intern()) {
    def used = (props.get(usedKey) ?: &quot;&quot;) as String
    def usedSet = used ? (used.split(&quot;,&quot;) as List).findAll { it } as Set : new LinkedHashSet()
    caseId = pageCases.find { !usedSet.contains(it) }
    if (caseId) {
        usedSet.add(caseId)
        props.put(usedKey, usedSet.join(&quot;,&quot;))
    }
}
if (!caseId) {
    if (lastPage &gt; 0 &amp;&amp; page &gt;= lastPage) {
        prev.setSuccessful(false)
        prev.setResponseMessage(&quot;No unused PENDING_CASE_ISSUED case left | &quot; + pageInfo)
        vars.put(&quot;Case_ID&quot;, &quot;&quot;)
        vars.put(&quot;casePickStop&quot;, &quot;true&quot;)
        log.error(&quot;[CWDocumentRemove] All PENDING_CASE_ISSUED cases already claimed | &quot; + pageInfo)
        return
    }
    vars.put(&quot;workbasketPage&quot;, (page + 1).toString())
    vars.put(&quot;Case_ID&quot;, &quot;&quot;)
    prev.setResponseMessage(&quot;PENDING_CASE_ISSUED page &quot; + page + &quot; exhausted, next page=&quot; + (page + 1) + &quot; | &quot; + pageInfo)
    log.info(&quot;[CWDocumentRemove] page exhausted, next=&quot; + (page + 1) + &quot; | &quot; + pageInfo)
    return
}
def attempts = ((vars.get(&quot;casePickAttempts&quot;) ?: &quot;0&quot;) as int) + 1
vars.put(&quot;casePickAttempts&quot;, attempts.toString())
vars.put(&quot;Case_id&quot;, caseId)
vars.put(&quot;Case_ID&quot;, caseId)
log.info(&quot;[CWDocumentRemove] Claimed PENDING_CASE_ISSUED Case_ID=&quot; + caseId + &quot; | &quot; + pageInfo)
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="CW_SC02_UploadDocument_Assert_Search_Results" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="-1659698930">&quot;results&quot;</stringProp>
                </collectionProp>
                <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">2</intProp>
                <stringProp name="Assertion.custom_message"></stringProp>
              </ResponseAssertion>
