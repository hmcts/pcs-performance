            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build Case Link Event Body" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def linkingId = vars.get(&quot;Linking_Case_ID&quot;)
def created = vars.get(&quot;linkingCaseCreatedDate&quot;) ?: &quot;2026-05-14T17:36:41.445&quot;
def caseType = vars.get(&quot;linkingCaseType&quot;) ?: &quot;PCS&quot;
def eventToken = vars.get(&quot;event_token&quot;)
def reason = &apos;{&quot;value&quot;:{&quot;Reason&quot;:&quot;CLRC002&quot;,&quot;OtherDescription&quot;:&quot;&quot;}}&apos;
def linkEntry = &apos;{&quot;id&quot;:&quot;&apos; + linkingId + &apos;&quot;,&quot;value&quot;:{&quot;CaseReference&quot;:&quot;&apos; + linkingId + &apos;&quot;,&quot;CaseType&quot;:&quot;&apos; + caseType + &apos;&quot;,&quot;CreatedDateTime&quot;:&quot;&apos; + created + &apos;&quot;,&quot;ReasonForLink&quot;:[&apos; + reason + &apos;]}}&apos;
vars.put(&quot;caseLinkEventBody&quot;, &apos;{&quot;data&quot;:{&quot;caseLinks&quot;:[&apos; + linkEntry + &apos;]},&quot;event&quot;:{&quot;id&quot;:&quot;createCaseLink&quot;,&quot;summary&quot;:&quot;&quot;,&quot;description&quot;:&quot;&quot;},&quot;event_token&quot;:&quot;&apos; + eventToken + &apos;&quot;,&quot;ignore_warning&quot;:false}&apos;)</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.create-event.v2+json;charset=UTF-8</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Origin</stringProp>
                    <stringProp name="Header.value">https://manage-case.perftest.platform.hmcts.net</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">experimental</stringProp>
