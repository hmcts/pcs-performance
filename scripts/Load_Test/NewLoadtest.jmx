        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="CSV Data Set Config" enabled="true">
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="filename">CCNotes_ccnoteuserdetails_Input.csv</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">true</boolProp>
          <stringProp name="shareMode">shareMode.group</stringProp>
          <boolProp name="stopThread">false</boolProp>
          <stringProp name="variableNames">solicitor_username,Case_ID,admin_username</stringProp>
        </CSVDataSet>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Normalize Username And Case ID" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def solicitor = (vars.get(&quot;solicitor_username&quot;) ?: &quot;&quot;).trim()
if (solicitor &amp;&amp; !solicitor.contains(&quot;@&quot;)) {
    solicitor = solicitor + &quot;@test.com&quot;
}
vars.put(&quot;solicitor_username&quot;, solicitor)
vars.put(&quot;username&quot;, solicitor)

def caseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
vars.put(&quot;Case_ID&quot;, caseId)

def admin = (vars.get(&quot;admin_username&quot;) ?: &quot;&quot;).trim()
if (!admin &amp;&amp; solicitor =~ /pcs-solicitor(\\d+)/) {
    def num = (solicitor =~ /pcs-solicitor(\\d+)/)[0][1] as int
    def adminNum = num &gt;= 500 ? (num - 100) : (num + 300)
    if (adminNum &gt; 419) { adminNum = 400 + ((adminNum - 401) % 19) + 1 }
    admin = &quot;PCS-CTSC-Admin&quot; + adminNum + &quot;@hmcts.net&quot;
}
vars.put(&quot;admin_username&quot;, admin)
vars.put(&quot;cc_case_ready&quot;, &quot;false&quot;)

def shared = (props.get(&quot;__CC_SHARED_CASE_ID__&quot;) ?: &quot;&quot;).toString().trim()
if (shared) {
    vars.put(&quot;Case_ID&quot;, shared)
    caseId = shared
}



log.info(&quot;Thread: &quot; + Thread.currentThread().getName())
log.info(&quot;Solicitor: &quot; + vars.get(&quot;solicitor_username&quot;))
log.info(&quot;Case_ID: &quot; + vars.get(&quot;Case_ID&quot;))
log.info(&quot;Admin: &quot; + vars.get(&quot;admin_username&quot;))
log.info(&quot;Active user: &quot; + vars.get(&quot;username&quot;))
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="TestPlan.comments">Prepares each CSV row before login. Completes solicitor email (@test.com if missing), copies it to username, trims Case_ID, and sets admin_username (from CSV, or derived from the solicitor number). Sets cc_case_ready=false until search finds the case.</stringProp>
        </JSR223Sampler>
