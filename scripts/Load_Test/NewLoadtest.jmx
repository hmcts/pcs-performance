            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC02_UploadDocument_Resolve_File_Path" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import org.apache.jmeter.services.FileServer
def uf = vars.get(&apos;uploadFile&apos;) ?: &apos;5mb.pdf&apos;
def base = FileServer.getFileServer().getBaseDir()
def f = new File(uf)
if (!f.isAbsolute()) {
    f = new File(base, uf)
}
vars.put(&apos;uploadFileAbs&apos;, f.canonicalPath)
</stringProp>
