        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Normalize Username And Case ID" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def username = (vars.get(&quot;username&quot;) ?: &quot;&quot;).trim()
if (username &amp;&amp; !username.contains(&quot;@&quot;)) {
    username = username + &quot;@hmcts.net&quot;
}
vars.put(&quot;username&quot;, username)
def caseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
vars.put(&quot;Case_ID&quot;, caseId)
vars.put(&quot;Caseid&quot;, caseId)
vars.put(&quot;flagComment&quot;, (vars.get(&quot;flagComment&quot;) ?: &quot;&quot;).trim() ?: &quot;Testing&quot;)
def startMs = (props.get(&quot;START.MS&quot;) ?: System.currentTimeMillis()).toString()
synchronized (org.apache.jmeter.JMeter.class) {
    if (props.get(&quot;__CC_CREATE_RUN_ID__&quot;)?.toString() != startMs) {
        props.put(&quot;__CC_CREATE_RUN_ID__&quot;, startMs)
        props.put(&quot;__CC_CREATE_CLAIMED_IDS__&quot;, java.util.Collections.synchronizedSet(new LinkedHashSet()))
        props.put(&quot;__CC_SHARED_CASE_READY__&quot;, &quot;false&quot;)
    }
}
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
