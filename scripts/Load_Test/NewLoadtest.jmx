                <stringProp name="script">def page = vars.get(&quot;workbasketPage&quot;) ?: &quot;1&quot;
vars.put(&quot;PageToChoose&quot;, &quot;state=PENDING_CASE_ISSUED&amp;page=&quot; + page)
def path = &quot;/data/internal/searchCases?ctid=PCS&amp;use_case=WORKBASKET&amp;view=WORKBASKET&amp;state=PENDING_CASE_ISSUED&amp;page=&quot; + page
sampler.setPath(path)
