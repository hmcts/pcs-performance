            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC01_ManageAmend_Force_Case_Issued_Page" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def key = &quot;CW_WB_PAGE_&quot; + ctx.getThread().getThreadName()
def iteration = 1
synchronized (key.intern()) {
    iteration = ((props.get(key) ?: &quot;0&quot;) as int) + 1
    props.put(key, iteration.toString())
}
vars.put(&quot;workbasketPage&quot;, iteration.toString())
vars.put(&quot;PageToChoose&quot;, &quot;state=CASE_ISSUED&amp;page=&quot; + iteration)
def path = &quot;/data/internal/searchCases?ctid=PCS&amp;use_case=WORKBASKET&amp;view=WORKBASKET&amp;state=CASE_ISSUED&amp;page=&quot; + iteration
sampler.setPath(path)
sampler.setProperty(&quot;HTTPSampler.path&quot;, path)
log.info(&quot;[CWAmend] CASE_ISSUED workbasket page=&quot; + iteration + &quot; path=&quot; + sampler.getPath())
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">experimental</stringProp>
                  <stringProp name="Header.value">true</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <RegexExtractor guiclass="RegexExtractorGui" testclass="RegexExtractor" testname="CW_SC01_ManageAmend_Extract_Case_Id" enabled="false">
              <stringProp name="TestPlan.comments">Random case in Pending Case Issued. Change PENDING_CASE_ISSUED to CASE_ISSUED to match PR #39 pattern.</stringProp>
              <stringProp name="RegexExtractor.useHeaders">false</stringProp>
              <stringProp name="RegexExtractor.refname">Case_id</stringProp>
              <stringProp name="RegexExtractor.regex">case_id&quot;\s*:\s*&quot;([^&quot;]+)&quot;[\s\S]*?&quot;\[STATE\]&quot;\s*:\s*&quot;CASE_ISSUED</stringProp>
              <stringProp name="RegexExtractor.template">$1$</stringProp>
              <stringProp name="RegexExtractor.default">NOT FOUND</stringProp>
              <boolProp name="RegexExtractor.default_empty_value">false</boolProp>
              <stringProp name="RegexExtractor.match_number">-1</stringProp>
