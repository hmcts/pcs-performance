            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Accept Direct Case Open If Found" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def code = prev.getResponseCode() ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def expected = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
def ok = (code == &quot;200&quot; &amp;&amp; expected &amp;&amp; body.contains(expected))
if (ok) {
    vars.put(&quot;cc_case_ready&quot;, &quot;true&quot;)
    prev.setSuccessful(true)
} else {
    prev.setSuccessful(true)
}

</stringProp>
