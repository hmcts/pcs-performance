              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def status = prev.getResponseCode() ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
if (status != &quot;200&quot;) {
  vars.put(&quot;amendReady&quot;, &quot;false&quot;)
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;amendDocuments trigger HTTP &quot; + status)
  return
}

def json
try {
  json = new JsonSlurper().parseText(body)
} catch (Exception e) {
  vars.put(&quot;amendReady&quot;, &quot;false&quot;)
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;amendDocuments response not JSON: &quot; + e.message)
  return
}

def fields = (json.case_fields ?: []) as List
def byId = fields.collectEntries { [(it.id): it] }

def folders = [
  [code: &quot;STATEMENTS_OF_CASE&quot;, label: &quot;Statements of case&quot;, docField: &quot;statementsOfCaseDocuments&quot;, emptyField: &quot;documentAmend_StatementsOfCaseEmpty&quot;, folderId: &quot;statementsOfCase&quot;],
  [code: &quot;PROPERTY_DOCUMENTS&quot;, label: &quot;Property documents&quot;, docField: &quot;propertyDocuments&quot;, emptyField: &quot;documentAmend_PropertyDocumentsEmpty&quot;, folderId: &quot;propertyDocuments&quot;],
  [code: &quot;EVIDENCE&quot;, label: &quot;Evidence&quot;, docField: &quot;evidenceDocuments&quot;, emptyField: &quot;documentAmend_EvidenceEmpty&quot;, folderId: &quot;evidence&quot;],
  [code: &quot;HEARING_DOCUMENTS&quot;, label: &quot;Hearing documents&quot;, docField: &quot;hearingDocuments&quot;, emptyField: &quot;documentAmend_HearingDocumentsEmpty&quot;, folderId: &quot;hearingDocuments&quot;],
  [code: &quot;ORDERS_AND_NOTICE_OF_HEARINGS&quot;, label: &quot;Orders and Notice of Hearings&quot;, docField: &quot;ordersAndNoticeOfHearingsDocuments&quot;, emptyField: &quot;documentAmend_OrdersAndNoticeOfHearingsEmpty&quot;, folderId: &quot;ordersAndNoticeOfHearings&quot;],
  [code: &quot;APPLICATIONS&quot;, label: &quot;Applications&quot;, docField: &quot;applicationsDocuments&quot;, emptyField: &quot;documentAmend_ApplicationsEmpty&quot;, folderId: &quot;applications&quot;],
  [code: &quot;APPEALS&quot;, label: &quot;Appeals&quot;, docField: &quot;appealsDocuments&quot;, emptyField: &quot;documentAmend_AppealsEmpty&quot;, folderId: &quot;appeals&quot;],
  [code: &quot;CORRESPONDENCE&quot;, label: &quot;Correspondence&quot;, docField: &quot;correspondenceDocuments&quot;, emptyField: &quot;documentAmend_CorrespondenceEmpty&quot;, folderId: &quot;correspondence&quot;],
  [code: &quot;UNCATEGORISED_DOCUMENTS&quot;, label: &quot;Uncategorised documents&quot;, docField: &quot;uncategorisedDocuments&quot;, emptyField: &quot;documentAmend_UncategorisedDocumentsEmpty&quot;, folderId: &quot;uncategorisedDocuments&quot;]
]

def emptyFlags = [:]
folders.each { f -&gt;
  emptyFlags[f.emptyField] = (byId[f.emptyField]?.value ?: &quot;Yes&quot;).toString()
}

def wantedName = vars.get(&quot;uploadedStoredFilename&quot;) ?: vars.get(&quot;doc_filename&quot;) ?: &quot;&quot;
def docUrl = vars.get(&quot;doc_url&quot;) ?: &quot;&quot;
def uploadedDocId = &quot;&quot;
def idMatch = (docUrl =~ /([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})/)
if (idMatch.find()) {
  uploadedDocId = idMatch.group(1)
}
def uploadedCollectionId = vars.get(&quot;uploadedCollectionId&quot;) ?: &quot;&quot;
def chosen = null
def items = []
def picked = null
def pickHow = &quot;none&quot;

if (uploadedCollectionId) {
  for (f in folders) {
    def listItems = (byId[f.docField]?.value?.list_items ?: []) as List
    def match = listItems.find { it.code?.toString() == uploadedCollectionId }
    if (match) {
      chosen = f
      items = listItems
      picked = match
      pickHow = &quot;upload-collection-id&quot;
      break
    }
  }
}

if (!chosen &amp;&amp; uploadedDocId) {
  for (f in folders) {
    def listItems = (byId[f.docField]?.value?.list_items ?: []) as List
    def match = listItems.find { it.code?.toString() == uploadedDocId }
    if (match) {
      chosen = f
      items = listItems
      picked = match
      pickHow = &quot;upload-doc-id&quot;
      break
    }
  }
}

if (!chosen &amp;&amp; wantedName) {
  for (f in folders) {
    def listItems = (byId[f.docField]?.value?.list_items ?: []) as List
    def match = listItems.find { (it.label ?: &quot;&quot;).toString() == wantedName }
    if (match) {
      chosen = f
      items = listItems
      picked = match
      pickHow = &quot;upload-stored-filename&quot;
      break
    }
  }
}

def origName = vars.get(&quot;doc_filename&quot;) ?: &quot;&quot;
def origBase = origName.replaceAll(/\.[^.]+$/, &quot;&quot;)
if (!chosen &amp;&amp; origBase) {
  for (f in folders) {
    def listItems = (byId[f.docField]?.value?.list_items ?: []) as List
    def matches = listItems.findAll { (it.label ?: &quot;&quot;).toString().contains(origBase) }
    if (matches) {
      chosen = f
      items = listItems
      picked = matches[0]
      pickHow = &quot;upload-filename-stem&quot;
      break
    }
  }
}

if (!chosen) {
  vars.put(&quot;amendReady&quot;, &quot;false&quot;)
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;Uploaded document not found for amend. collectionId=&quot; + uploadedCollectionId + &quot; filename=&quot; + wantedName)
  return
}

vars.put(&quot;event_token&quot;, (json.event_token ?: vars.get(&quot;event_token&quot;) ?: &quot;&quot;).toString())
vars.put(&quot;propertyAddress&quot;, (byId[&quot;documentAmend_PropertyAddressSummary&quot;]?.value ?: &quot;&quot;).toString())
vars.put(&quot;selectedFolderCode&quot;, chosen.code)
vars.put(&quot;selectedFolderLabel&quot;, chosen.label)
vars.put(&quot;selectedFolderId&quot;, chosen.folderId)
vars.put(&quot;selectedDocField&quot;, chosen.docField)
vars.put(&quot;selectedDocCode&quot;, picked.code?.toString() ?: &quot;&quot;)
vars.put(&quot;selectedDocLabel&quot;, picked.label?.toString() ?: &quot;&quot;)
vars.put(&quot;selectedDocListJson&quot;, JsonOutput.toJson(items))
vars.put(&quot;emptyFlagsJson&quot;, JsonOutput.toJson(emptyFlags))
vars.put(&quot;amendReady&quot;, &quot;true&quot;)

log.info(&quot;[CWAmend] case=&quot; + vars.get(&quot;Case_ID&quot;) + &quot; folder=&quot; + chosen.code + &quot; doc=&quot; + picked.label + &quot; how=&quot; + pickHow)

// #region agent log
try { new File(&quot;/Users/priyadharsini/Desktop/Gatling/.cursor/debug-6433cf.log&quot;).append(groovy.json.JsonOutput.toJson([sessionId:&quot;6433cf&quot;,timestamp:System.currentTimeMillis(),location:&quot;CWDocumentUploadAmendRemove.jmx:Amend_Pick&quot;,message:&quot;amend-pick-result&quot;,hypothesisId:&quot;D&quot;,runId:&quot;post-fix&quot;,data:[code:prev.getResponseCode(),success:prev.isSuccessful(),Case_ID:vars.get(&quot;Case_ID&quot;),amendReady:vars.get(&quot;amendReady&quot;),selectedDocCode:vars.get(&quot;selectedDocCode&quot;),selectedDocLabel:vars.get(&quot;selectedDocLabel&quot;),selectedFolderCode:vars.get(&quot;selectedFolderCode&quot;)]]) + &quot;\n&quot;) } catch (Exception ignored) {}
// #endregion
</stringProp>
