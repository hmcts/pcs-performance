              <stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString() ?: &quot;&quot;
if (prev.getResponseCode() == &quot;200&quot; &amp;&amp; body) {
    def json = new JsonSlurper().parseText(body)
    def caseType = &quot;PCS&quot;
    if (json.case_type_id instanceof Map &amp;&amp; json.case_type_id.id) {
        caseType = json.case_type_id.id.toString()
    } else if (json.case_type_id instanceof String) {
        caseType = json.case_type_id
    } else if (json.case_type instanceof Map &amp;&amp; json.case_type.id) {
        caseType = json.case_type.id.toString()
    }
    vars.put(&quot;linkingCaseType&quot;, caseType)
    def created = json.created_date?.toString()
    if (!created) { created = json.last_modified?.toString() }
    if (created) { vars.put(&quot;linkingCaseCreatedDate&quot;, created) }
}</stringProp>
