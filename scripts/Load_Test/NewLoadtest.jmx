            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC01_ManageAmend_Validate_Search_Case" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def expectedCaseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
vars.put(&quot;amendReady&quot;, &quot;false&quot;)
vars.put(&quot;caseTryIndex&quot;, &quot;0&quot;)

def body = prev.getResponseDataAsString() ?: &quot;&quot;
if (prev.getResponseCode() != &quot;200&quot; || !body) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;CASE_ISSUED workbasket search failed HTTP=&quot; + prev.getResponseCode())
  vars.put(&quot;caseIdListJson&quot;, &quot;[]&quot;)
  return
}

def results = []
try {
  results = (new JsonSlurper().parseText(body).results ?: []) as List
} catch (Exception e) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;CASE_ISSUED workbasket response not JSON: &quot; + e.message)
  vars.put(&quot;caseIdListJson&quot;, &quot;[]&quot;)
  return
}

def pageCases = results.collect { (it?.case_id ?: &quot;&quot;).toString() }.findAll { it }
if (!pageCases) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;No CASE_ISSUED cases in workbasket (count=&quot; + results.size() + &quot;)&quot;)
  vars.put(&quot;caseIdListJson&quot;, &quot;[]&quot;)
  return
}

def usedKey = &quot;CW_CLAIMED_CASE_IDS&quot;
def used = (props.get(usedKey) ?: &quot;&quot;) as String
def usedSet = used ? (used.split(&quot;,&quot;) as List).findAll { it } as Set : new LinkedHashSet()
def ids = []
if (expectedCaseId &amp;&amp; pageCases.contains(expectedCaseId) &amp;&amp; !usedSet.contains(expectedCaseId)) {
  ids &lt;&lt; expectedCaseId
}
pageCases.each { id -&gt;
  if (!ids.contains(id) &amp;&amp; !usedSet.contains(id)) {
    ids &lt;&lt; id
  }
}
if (!ids) {
  ids = pageCases
}

vars.put(&quot;Case_ID&quot;, ids[0].toString())
vars.put(&quot;Case_id&quot;, ids[0].toString())
vars.put(&quot;caseIdListJson&quot;, JsonOutput.toJson(ids))
prev.setResponseMessage(&quot;Amend pool from CASE_ISSUED list size=&quot; + ids.size() + &quot; first=&quot; + ids[0])
log.info(&quot;[CWAmend] CASE_ISSUED pool size=&quot; + ids.size() + &quot; first=&quot; + ids[0])
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
