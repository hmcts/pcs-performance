          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Publish Shared Case ID" enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def code = prev.getResponseCode() ?: &quot;&quot;
def caseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
def user = (vars.get(&quot;username&quot;) ?: &quot;&quot;).trim()
def ready = (code == &quot;201&quot; &amp;&amp; caseId)
if (ready) {
    props.put(&quot;__CC_SHARED_CASE_ID__&quot;, caseId)
    props.put(&quot;__CC_SHARED_USERNAME__&quot;, user)
    props.put(&quot;__CC_SHARED_CASE_READY__&quot;, &quot;true&quot;)
    synchronized (org.apache.jmeter.JMeter.class) {
        if (!props.containsKey(&quot;__CC_USED_CASE_IDS__&quot;)) {
            props.put(&quot;__CC_USED_CASE_IDS__&quot;, java.util.Collections.synchronizedSet(new LinkedHashSet()))
        }
    }
    def used = props.get(&quot;__CC_USED_CASE_IDS__&quot;) as Set
    synchronized (used) { used.add(caseId) }
} else {
    props.put(&quot;__CC_SHARED_CASE_READY__&quot;, &quot;false&quot;)
}

</stringProp>
