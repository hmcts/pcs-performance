              <stringProp name="script">int count = Integer.parseInt(vars.get(&quot;caseId_matchNr&quot;));

int randomIndex = 1 + (int)(Math.random() * count);

String selectedCaseId = vars.get(&quot;caseId_&quot; + randomIndex);

vars.put(&quot;selectedCaseId&quot;, selectedCaseId);

