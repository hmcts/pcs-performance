        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Select Found CreateFlags Case" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def found = &quot;true&quot;.equals(vars.get(&quot;createFlagsFound&quot;))
def foundId = (vars.get(&quot;foundCaseId&quot;) ?: &quot;&quot;).trim()
def user = vars.get(&quot;username&quot;) ?: &quot;-&quot;
def tried = vars.get(&quot;wbCaseIds_matchNr&quot;) ?: &quot;0&quot;
def raw = vars.get(&quot;wbCaseIds_rawNr&quot;) ?: &quot;?&quot;
if (found &amp;&amp; foundId) {
    vars.put(&quot;Case_ID&quot;, foundId)
    vars.put(&quot;Caseid&quot;, foundId)
    SampleResult.setSuccessful(true)
    SampleResult.setResponseMessage(&quot;using Case_ID &quot; + foundId + &quot; user=&quot; + user)
} else {
    SampleResult.setSuccessful(false)
    SampleResult.setStopThread(true)
    SampleResult.setResponseMessage(&quot;No workbasket case allowed createFlags for &quot; + user + &quot; (search=&quot; + raw + &quot; try=&quot; + tried + &quot;)&quot;)
    props.put(&quot;__CC_SHARED_CASE_READY__&quot;, &quot;false&quot;)
}

</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
