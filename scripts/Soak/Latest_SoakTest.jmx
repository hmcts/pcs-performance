                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Store Event Trigger JSON" enabled="true">
                  <stringProp name="cacheKey">false</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">vars.put(&quot;eventTriggerJson&quot;, prev.getResponseDataAsString() ?: &quot;&quot;)
def headers = prev.getResponseHeaders() ?: &quot;&quot;
def matcher = (headers =~ /(?i)Set-Cookie: XSRF-TOKEN=([^;\r\n]+)/)
def token = null
while (matcher.find()) { token = matcher.group(1) }
if (!token) { token = vars.get(&quot;xsrf_token&quot;) }
if (token) { vars.put(&quot;xsrf_token&quot;, token) }
</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
                <hashTree/>
                <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Create case flags event" enabled="false">
                  <collectionProp name="Asserion.test_strings">
                    <stringProp name="-1127474405">Create case flags</stringProp>
                  </collectionProp>
                  <stringProp name="Assertion.custom_message">CC_SC01_CreateCaseFlag_06_Start_CreateFlags failed: create flags event not returned</stringProp>
                  <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
                  <boolProp name="Assertion.assume_success">false</boolProp>
                  <intProp name="Assertion.test_type">2</intProp>
                </ResponseAssertion>
                <hashTree/>
                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Accept CreateFlags If Available" enabled="true">
                  <stringProp name="cacheKey">false</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">def code = prev.getResponseCode() ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def caseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
def ok = (code == &quot;200&quot; &amp;&amp; body.contains(&quot;Create case flags&quot;) &amp;&amp; caseId)
if (ok) {
    synchronized (org.apache.jmeter.JMeter.class) {
        if (!props.containsKey(&quot;__CC_CREATE_CLAIMED_IDS__&quot;)) {
            props.put(&quot;__CC_CREATE_CLAIMED_IDS__&quot;, java.util.Collections.synchronizedSet(new LinkedHashSet()))
        }
        def claimed = props.get(&quot;__CC_CREATE_CLAIMED_IDS__&quot;) as Set
        if (claimed.contains(caseId)) {
            ok = false
        } else {
            claimed.add(caseId)
        }
    }
}
if (ok) {
    vars.put(&quot;createFlagsFound&quot;, &quot;true&quot;)
    vars.put(&quot;foundCaseId&quot;, caseId)
    prev.setSuccessful(true)
} else {
    prev.setSuccessful(true)
    prev.setResponseMessage(&quot;skip createFlags HTTP=&quot; + code)
}

</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
