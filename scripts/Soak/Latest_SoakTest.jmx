              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC05_ManageParties_Add_Pick_Dropdown_Address" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper

def mode = vars.get(&quot;addressPickMode&quot;) ?: &quot;add&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def json
try {
  json = new JsonSlurper().parseText(body)
} catch (Exception e) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;Address lookup not JSON: &quot; + e.message)
  return
}
def results = (json.results ?: []) as List
if (!results) {
  prev.setSuccessful(false)
  prev.setResponseMessage(&quot;No dropdown addresses for postcode &quot; + (vars.get(&quot;postcode&quot;) ?: &quot;&quot;))
  return
}

def titleCase = { s -&gt;
  if (s == null) return &quot;&quot;
  def t = s.toString().trim()
  if (!t) return &quot;&quot;
  t.toLowerCase().split(/[\s]+/).collect { w -&gt;
    w ? (w.substring(0, 1).toUpperCase() + w.substring(1)) : w
  }.join(&quot; &quot;)
}

def idx
synchronized (props) {
  def key = &quot;CW_PARTY_ADDR_COUNTER&quot;
  def cur = props.get(key)
  idx = (cur == null || cur.toString().trim().isEmpty()) ? 0 : (cur as int)
  props.put(key, String.valueOf(idx + 1))
}
def dpa = (results[idx % results.size()]?.DPA) ?: [:]

def sub = (dpa.SUB_BUILDING_NAME ?: &quot;&quot;).toString().trim()
def bname = (dpa.BUILDING_NAME ?: &quot;&quot;).toString().trim()
def bnum = (dpa.BUILDING_NUMBER ?: &quot;&quot;).toString().trim()
def street = titleCase(dpa.THOROUGHFARE_NAME ?: &quot;&quot;)
def depStreet = titleCase(dpa.DEPENDENT_THOROUGHFARE_NAME ?: &quot;&quot;)
def locality = titleCase(dpa.DEPENDENT_LOCALITY ?: &quot;&quot;)

def line1 = [bnum, street].findAll { it }.join(&quot; &quot;).trim()
if (bname) {
  line1 = [titleCase(bname), line1].findAll { it }.join(&quot;, &quot;)
}
if (!line1) {
  def first = (dpa.ADDRESS ?: &quot;&quot;).toString().split(&quot;,&quot;)[0]
  line1 = titleCase(first)
}

def line2 = [titleCase(sub), depStreet, locality].findAll { it }.join(&quot;, &quot;)
def town = titleCase(dpa.POST_TOWN ?: vars.get(&quot;addPartyPostTown&quot;) ?: &quot;London&quot;)
def pc = (dpa.POSTCODE ?: vars.get(&quot;postcode&quot;) ?: vars.get(&quot;addPartyPostCode&quot;) ?: &quot;&quot;).toString()

if (mode == &quot;update&quot;) {
  vars.put(&quot;updatePartyAddressLine1&quot;, line1)
  vars.put(&quot;updatePartyAddressLine2&quot;, line2)
  vars.put(&quot;updatePartyPostTown&quot;, town)
  vars.put(&quot;updatePartyPostCode&quot;, pc)
} else {
  vars.put(&quot;addPartyAddressLine1&quot;, line1)
  vars.put(&quot;addPartyAddressLine2&quot;, line2)
  vars.put(&quot;addPartyPostTown&quot;, town)
  vars.put(&quot;addPartyPostCode&quot;, pc)
}
log.info(&quot;[CWParties] &quot; + mode + &quot; dropdown address[&quot; + (idx % results.size()) + &quot;/&quot; + results.size() + &quot;]=&quot; + line1 + &quot; | &quot; + line2 + &quot; | &quot; + town + &quot; &quot; + pc)
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
