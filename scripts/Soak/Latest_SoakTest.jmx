              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CW_SC05_ManageParties_Build_Add_Details_Body" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonOutput
def event = [id: &quot;manageParties&quot;, summary: &quot;&quot;, description: &quot;&quot;]
def address = [
  AddressLine1: vars.get(&quot;addPartyAddressLine1&quot;) ?: &quot;9 Second Avenue&quot;,
  AddressLine2: vars.get(&quot;addPartyAddressLine2&quot;) ?: &quot;&quot;,
  AddressLine3: &quot;&quot;,
  PostTown: vars.get(&quot;addPartyPostTown&quot;) ?: &quot;London&quot;,
  County: &quot;&quot;,
  Country: &quot;United Kingdom&quot;,
  PostCode: vars.get(&quot;addPartyPostCode&quot;) ?: vars.get(&quot;postcode&quot;) ?: &quot;W3 7RX&quot;
]
def details = [
  addParty_ClaimantOrganisationName: vars.get(&quot;addPartyOrgName&quot;) ?: &quot;Test&quot;,
  addParty_ClaimantFirstName: vars.get(&quot;addPartyFirstName&quot;) ?: &quot;Performance&quot;,
  addParty_ClaimantLastName: vars.get(&quot;addPartyLastName&quot;) ?: &quot;Testing&quot;,
  addParty_ClaimantAddress: address,
  addParty_ClaimantEmail: null,
  addParty_ClaimantPhoneNumber: null
]
def options = [
  addParty_ManagePartyOptions: &quot;ADD_PARTY&quot;,
  addParty_AddPartyType: (vars.get(&quot;addPartyType&quot;) ?: &quot;CLAIMANT&quot;),
  updateParty_PreviouslySelectedPartyId: null,
  updateParty_UpdatePartyType: null
]
def eventData = options + details
vars.put(&quot;addDetailsValidateBody&quot;, JsonOutput.toJson([
  data: details, event: event, event_data: eventData,
  event_token: vars.get(&quot;event_token&quot;), ignore_warning: false,
  case_reference: vars.get(&quot;Case_ID&quot;)
]))
vars.put(&quot;addEventBody&quot;, JsonOutput.toJson([
  data: eventData, event: event, event_token: vars.get(&quot;event_token&quot;), ignore_warning: false
]))
</stringProp>
