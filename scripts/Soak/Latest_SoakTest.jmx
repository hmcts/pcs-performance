          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="CW_SC02_UploadDocument_08_Start_Upload_Documents" enabled="true">
            <stringProp name="HTTPSampler.domain">${BASE_URL_1}</stringProp>
            <stringProp name="HTTPSampler.protocol">https</stringProp>
            <stringProp name="HTTPSampler.path">/data/internal/cases/${Case_ID}/event-triggers/caseworkerUploadDocuments?ignore-warning=false</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">GET</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
              <collectionProp name="Arguments.arguments"/>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.ui-start-event-trigger.v2+json;charset=UTF-8</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">experimental</stringProp>
                  <stringProp name="Header.value">true</stringProp>
                </elementProp>
              </collectionProp>
            </HeaderManager>
            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CW_SC02_UploadDocument_Extract_Event_Token" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">event_token</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.event_token</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC02_UploadDocument_Store_Trigger_Fields" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def status = prev.getResponseCode() ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def json = [:]
try {
json = new JsonSlurper().parseText(body)
} catch (Exception e) {
log.warn(&quot;[CW] start upload not JSON HTTP &quot; + status + &quot; &quot; + e.message)
}
def findField = { id -&gt; (json.case_fields ?: []).find { it.id == id } }

def showRelated = (findField(&quot;cwDoc_ShowRelatedSubmissionsList&quot;)?.value ?: &quot;YES&quot;).toString()
def related = findField(&quot;cwDoc_RelatedParty&quot;)
def relatedItems = (related?.value?.list_items ?: []) as List
def relatedFirst = relatedItems ? relatedItems[0] : null

def relSub = findField(&quot;cwDoc_RelatedSubmission&quot;)
def relSubItems = (relSub?.value?.list_items ?: []) as List
def noneSub = relSubItems.find { it.code?.toString() == &quot;NONE&quot; } ?: (relSubItems ? relSubItems[-1] : null)

def typeFieldId = (showRelated == &quot;YES&quot;) ? &quot;cwDoc_RelatedSubmissionsDocumentType&quot; : &quot;cwDoc_StandaloneDocumentType&quot;
def docType = findField(typeFieldId)
def docTypeItems = (docType?.value?.list_items ?: []) as List
def wantedCode = vars.get(&quot;docTypeCode&quot;) ?: &quot;POSSESSION_NOTICE&quot;
def matched = docTypeItems.find { it.code?.toString() == wantedCode }
if (!matched &amp;&amp; docTypeItems) matched = docTypeItems[0]

vars.put(&quot;showRelatedSubmissions&quot;, showRelated)
vars.put(&quot;relatedPartyCode&quot;, relatedFirst?.code?.toString() ?: &quot;&quot;)
vars.put(&quot;relatedPartyLabel&quot;, relatedFirst?.label?.toString() ?: &quot;&quot;)
vars.put(&quot;relatedPartyListJson&quot;, JsonOutput.toJson(relatedItems))
vars.put(&quot;relatedSubmissionCode&quot;, noneSub?.code?.toString() ?: &quot;NONE&quot;)
vars.put(&quot;relatedSubmissionLabel&quot;, noneSub?.label?.toString() ?: &quot;Not related to an application or counterclaim&quot;)
vars.put(&quot;relatedSubmissionListJson&quot;, JsonOutput.toJson(relSubItems))
vars.put(&quot;docTypeCode&quot;, matched?.code?.toString() ?: wantedCode)
vars.put(&quot;docTypeLabel&quot;, matched?.label?.toString() ?: wantedCode)
vars.put(&quot;docTypeListJson&quot;, JsonOutput.toJson(docTypeItems))
vars.put(&quot;docTypeFieldId&quot;, typeFieldId)
vars.put(&quot;uploadStartOk&quot;, (status == &quot;200&quot; &amp;&amp; body.contains(&quot;Manage documents: Upload&quot;)) ? &quot;true&quot; : &quot;false&quot;)
</stringProp>
