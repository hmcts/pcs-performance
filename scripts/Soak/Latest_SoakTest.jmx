              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="CW_SC05_ManageParties_Store_Trigger_Fields" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def json = [:]
try {
  json = new JsonSlurper().parseText(body)
} catch (Exception e) {
  log.warn(&quot;[CWParties] manageParties trigger not JSON: &quot; + e.message)
}
def findField = { id -&gt; (json.case_fields ?: []).find { it.id == id } }
def partyField = findField(&quot;updateParty_PartyToUpdate&quot;)
def items = (partyField?.value?.list_items ?: []) as List
vars.put(&quot;partyListJson&quot;, JsonOutput.toJson(items))

def wanted = vars.get(&quot;addPartyOrgName&quot;) ?: &quot;Test&quot;
def picked = items.find { (it.label ?: &quot;&quot;).toString().contains(wanted) }
if (!picked &amp;&amp; items) picked = items[-1]
vars.put(&quot;updatePartyCode&quot;, picked?.code?.toString() ?: &quot;&quot;)
vars.put(&quot;updatePartyLabel&quot;, picked?.label?.toString() ?: &quot;&quot;)
def label = (picked?.label ?: &quot;&quot;).toString().toUpperCase()
vars.put(&quot;updatePartyType&quot;, label.contains(&quot;DEFENDANT&quot;) ? &quot;DEFENDANT&quot; : &quot;CLAIMANT&quot;)
log.info(&quot;[CWParties] parties=&quot; + items.size() + &quot; picked=&quot; + vars.get(&quot;updatePartyLabel&quot;))
</stringProp>
