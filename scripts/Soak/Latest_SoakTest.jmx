              <hashTree/>
              <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="CC_SC01_ManageCaseFlag_13_Verify_Amended_Flag" enabled="true">
                <stringProp name="HTTPSampler.path">/data/internal/cases/${Case_ID}</stringProp>
                <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
