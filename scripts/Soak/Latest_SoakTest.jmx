                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
def event = [id: &quot;manageParties&quot;, summary: &quot;&quot;, description: &quot;&quot;]
def items = []
try { items = new JsonSlurper().parseText(vars.get(&quot;partyListJson&quot;) ?: &quot;[]&quot;) } catch (Exception e) { items = [] }
def code = vars.get(&quot;updatePartyCode&quot;) ?: &quot;&quot;
def label = vars.get(&quot;updatePartyLabel&quot;) ?: &quot;&quot;
def ptype = vars.get(&quot;updatePartyType&quot;) ?: &quot;CLAIMANT&quot;
def partyToUpdate = [value: [code: code, label: label], list_items: items]
def address = [
  AddressLine1: vars.get(&quot;updatePartyAddressLine1&quot;) ?: &quot;10 Second Avenue&quot;,
  AddressLine2: vars.get(&quot;updatePartyAddressLine2&quot;) ?: &quot;&quot;,
  AddressLine3: &quot;&quot;,
  PostTown: vars.get(&quot;updatePartyPostTown&quot;) ?: vars.get(&quot;addPartyPostTown&quot;) ?: &quot;London&quot;,
  County: &quot;&quot;,
  Country: &quot;United Kingdom&quot;,
  PostCode: vars.get(&quot;updatePartyPostCode&quot;) ?: vars.get(&quot;postcode&quot;) ?: &quot;W3 7RX&quot;
]
def details = [
  updateParty_UpdatePartyAddress: address,
  updateParty_UpdatePartyEmail: vars.get(&quot;updatePartyEmail&quot;) ?: &quot;pcs-solicitor141@test.com&quot;,
  updateParty_PhoneNumber: &quot;&quot;
]
def eventData = [
  addParty_ManagePartyOptions: &quot;UPDATE&quot;,
  updateParty_PartyToUpdate: partyToUpdate,
  updateParty_PreviouslySelectedPartyId: code,
  updateParty_UpdatePartyType: ptype
] + details
vars.put(&quot;updateDetailsValidateBody&quot;, JsonOutput.toJson([
  data: details, event: event, event_data: eventData,
  event_token: vars.get(&quot;event_token&quot;), ignore_warning: false,
  case_reference: vars.get(&quot;Case_ID&quot;)
]))
vars.put(&quot;updateEventBody&quot;, JsonOutput.toJson([
  data: eventData, event: event, event_token: vars.get(&quot;event_token&quot;), ignore_warning: false
]))
</stringProp>
