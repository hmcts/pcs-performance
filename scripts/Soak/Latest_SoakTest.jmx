            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="CW_SC01_ManageAmend_Extract_Event_Token" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">event_token</stringProp>
