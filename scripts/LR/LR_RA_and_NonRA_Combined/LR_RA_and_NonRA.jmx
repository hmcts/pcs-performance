            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="APITest_05_04_Link Defendant Solicitor to Party" enabled="true">
              <stringProp name="HTTPSampler.domain">${PcsApiInternal}</stringProp>
              <stringProp name="HTTPSampler.protocol">http</stringProp>
              <stringProp name="HTTPSampler.path">/testing-support/link-defendant-solicitor-to-party/${CASEID}/${DefendantPartyID}</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">POST</stringProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
              <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate caseRef and defendant partyId" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">def cr = vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;
def pid = vars.get(&quot;DefendantPartyID&quot;) ?: &quot;&quot;
vars.put(&quot;CASEID&quot;, cr)
vars.put(&quot;caseRef&quot;, cr)
vars.put(&quot;partyId&quot;, pid)
if (!(cr ==~ /^[0-9]{16}$/)) {
  throw new Exception(&quot;caseRef invalid: Must be the 16-digit CASEID of the case just created.&quot;)
}
if (!(pid ==~ /(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)) {
  throw new Exception(&quot;partyId invalid: Must be the defendant partyId from that same case.&quot;)
}
</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">accept</stringProp>
                    <stringProp name="Header.value">*/*</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Bearer ${idamToken}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">ServiceAuthorization</stringProp>
                    <stringProp name="Header.value">Bearer ${S2S_TOKEN_PCS_API}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="LINK returned 200" enabled="true">
                <collectionProp name="Asserion.test_strings"/>
                <collectionProp name="Assertion.test_strings">
                  <stringProp name="49586">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Write LR Board CSV" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">// Only write successful, unique CaseID rows (skip failed re-links / duplicates)
if (prev.getResponseCode() != &quot;200&quot;) {
  return
}
def caseIdOut = vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;
if (!caseIdOut) {
  return
}
def stamp = vars.get(&quot;outputStamp&quot;)
if (!stamp) stamp = new Date().format(&quot;yyyyMMdd-HHmmss&quot;)
def writtenKey = &quot;lrBoardWrittenCaseIds_&quot; + stamp
def written = props.get(writtenKey)
if (written == null) {
  written = java.util.Collections.synchronizedSet(new java.util.HashSet())
  props.put(writtenKey, written)
}
if (!written.add(caseIdOut)) {
  return
}
def baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
def csvFile = new File(baseDir, &quot;LR_Board_Output_&quot; + stamp + &quot;.csv&quot;)
if (!csvFile.exists()) {
  csvFile.write(&quot;ClaimantID,ClaimantPartyID,CaseID,DefendantsolicitorEmail_NonRA,DefendantPartyID,LinkedCaseID\n&quot;)
}
def claimantId = vars.get(&quot;UsernameSolicitor&quot;) ?: vars.get(&quot;username&quot;) ?: &quot;&quot;
def claimantParty = vars.get(&quot;ResponsiblePartyID&quot;) ?: vars.get(&quot;PartyID&quot;) ?: &quot;&quot;
def DefendantsolicitorEmail_NonRA = vars.get(&quot;DefendantsolicitorEmail_NonRA&quot;) ?: &quot;&quot;
def defendantParty = vars.get(&quot;DefendantPartyID&quot;) ?: &quot;&quot;
csvFile.append(claimantId + &quot;,&quot; + claimantParty + &quot;,&quot; + caseIdOut + &quot;,&quot; + DefendantsolicitorEmail_NonRA + &quot;,&quot; + defendantParty + &quot;,&quot; + caseIdOut + &quot;\n&quot;)
</stringProp>
