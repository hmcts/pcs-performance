            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract Defendant Party ID" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def found = []
def walk
walk = { node, path -&gt;
if (node instanceof Map) {
  node.each { k, v -&gt;
    def p = path + &quot;.&quot; + k
    def kl = k.toString().toLowerCase()
    if (kl.contains(&quot;defendant&quot;) || path.toLowerCase().contains(&quot;defendant&quot;)) {
      if (v instanceof String &amp;&amp; v ==~ /[0-9a-fA-F-]{36}/) found &lt;&lt; v
      if (v instanceof Map &amp;&amp; v.id instanceof String &amp;&amp; v.id ==~ /[0-9a-fA-F-]{36}/) found &lt;&lt; v.id
    }
    walk(v, p)
  }
} else if (node instanceof List) {
  node.eachWithIndex { v, i -&gt; walk(v, path + &quot;[&quot; + i + &quot;]&quot;) }
}
}
try {
walk(new JsonSlurper().parseText(body), &quot;root&quot;)
} catch (Exception ignored) {}
if (found) vars.put(&quot;DefendantPartyID&quot;, found[0])
vars.put(&quot;CASEID&quot;, vars.get(&quot;id&quot;) ?: &quot;&quot;)
vars.put(&quot;UsernameSolicitor&quot;, vars.get(&quot;username&quot;) ?: &quot;&quot;)
</stringProp>
            </JSR223PostProcessor>
