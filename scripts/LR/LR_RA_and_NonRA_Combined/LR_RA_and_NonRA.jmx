              <stringProp name="HTTPSampler.path">/case-users?case_ids=${CASEID}&amp;user_ids=${userId}</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
              <stringProp name="HTTPSampler.implementation">HttpClient4</stringProp>
            </HTTPSamplerProxy>
            <hashTree>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Bearer ${idamToken}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">ServiceAuthorization</stringProp>
                    <stringProp name="Header.value">Bearer ${S2S_TOKEN_PCS_API}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="case-users 200" enabled="true">
                <collectionProp name="Asserion.test_strings"/>
                <collectionProp name="Assertion.test_strings">
                  <stringProp name="49586">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert DEFENDANTSOLICITOR role" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
def code = prev.getResponseCode()
def roles = []
if (code != &quot;200&quot;) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;case-users returned &quot; + code)
} else {
  def parsed = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: &quot;{}&quot;)
  def uid = vars.get(&quot;userId&quot;)
  def mine = (parsed.case_users ?: []).findAll { it.user_id?.toString() == uid }
  roles = mine.collect { it.case_role }
  if (!roles.contains(&quot;[DEFENDANTSOLICITOR]&quot;)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Missing [DEFENDANTSOLICITOR] roles=&quot; + roles)
  }
}
