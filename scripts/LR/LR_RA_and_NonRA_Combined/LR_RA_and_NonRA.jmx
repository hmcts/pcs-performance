            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Validate caseRef and defendant partyId" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">def cr = vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;
def pid = vars.get(&quot;DefendantPartyID&quot;) ?: &quot;&quot;
vars.put(&quot;CASEID&quot;, cr)
vars.put(&quot;caseRef&quot;, cr)
vars.put(&quot;partyId&quot;, pid)
if (!(cr ==~ /^[0-9]{16}$/)) {
  throw new Exception(&quot;caseRef invalid: Must be the 16-digit CASEID of the case just created.&quot;)
}
if (!(pid ==~ /(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/)) {
  throw new Exception(&quot;partyId invalid: Must be the defendant partyId from that same case.&quot;)
}
</stringProp>
              </JSR223PreProcessor>
