        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Reset case vars each iteration" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">[&quot;CASEID&quot;,&quot;id&quot;,&quot;DefendantPartyID&quot;,&quot;PartyID&quot;,&quot;ResponsiblePartyID&quot;,&quot;event_token&quot;,&quot;CreateClaim-event_token&quot;,&quot;ccdPartyRetry&quot;,&quot;feePartyRetry&quot;].each { vars.put(it, &quot;&quot;) }
vars.put(&quot;cyaNeedRetry&quot;, &quot;true&quot;)
vars.put(&quot;cyaHttpOk&quot;, &quot;false&quot;)
vars.put(&quot;cyaSubmitTry&quot;, &quot;0&quot;)
vars.put(&quot;loginNeedRetry&quot;, &quot;true&quot;)
vars.put(&quot;loginHttpOk&quot;, &quot;false&quot;)
vars.put(&quot;loginSubmitTry&quot;, &quot;0&quot;)
vars.put(&quot;wbNeedRetry&quot;, &quot;true&quot;)
vars.put(&quot;wbTry&quot;, &quot;0&quot;)
vars.put(&quot;scNeedRetry&quot;, &quot;true&quot;)
vars.put(&quot;scTry&quot;, &quot;0&quot;)
def email = (vars.get(&quot;SolicitorClaimantEmail_XUI&quot;) ?: &quot;&quot;).trim().toLowerCase()
if (!email) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseMessage(&quot;No SolicitorClaimantEmail_XUI from CSV&quot;)
  SampleResult.setStopThread(true)
  return
}
def key = &quot;usedCreateEmails_&quot; + (vars.get(&quot;outputStamp&quot;) ?: &quot;run&quot;)
def used = props.get(key)
if (used == null) {
  used = java.util.Collections.synchronizedSet(new java.util.HashSet())
  props.put(key, used)
}
if (!used.add(email)) {
  log.info(&quot;Reusing solicitor email for load: &quot; + email)
}
vars.put(&quot;UsernameSolicitor&quot;, email)
SampleResult.setIgnore()
</stringProp>
        </JSR223Sampler>
