            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract IdAM login tokens from redirect chain" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">def collect(sr) {
  if (sr == null) return &quot;&quot;
  def s = (sr.getUrlAsString() ?: &quot;&quot;) + &quot;\n&quot; + (sr.getResponseHeaders() ?: &quot;&quot;) + &quot;\n&quot; + (sr.getResponseDataAsString() ?: &quot;&quot;)
  sr.getSubResults()?.each { s += &quot;\n&quot; + collect(it) }
  return s
}
def src = collect(prev)
def grab = { pat -&gt; def m = (src =~ pat); m.find() ? m.group(1) : null }
def nonce = grab(/nonce=([^&amp;\s&quot;&apos;&lt;&gt;]+)/)
def code = grab(/code_challenge=([^&amp;\s&quot;&apos;&lt;&gt;]+)/)
def csrf = grab(/name=[&apos;&quot;]_csrf[&apos;&quot;][^&gt;]*value=[&apos;&quot;]([^&apos;&quot;]+)[&apos;&quot;]/) ?: grab(/_csrf&quot; value=&quot;([^&quot;]+)&quot;/)
if (nonce) { vars.put(&quot;noncex&quot;, nonce) }
if (code) { vars.put(&quot;codex&quot;, code) }
if (csrf) { vars.put(&quot;csrfx&quot;, csrf) }
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Accept CUI 200 or 422" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def allowed = [&apos;200&apos;,&apos;302&apos;,&apos;303&apos;,&apos;422&apos;]
def walk
walk = { sr -&gt;
  if (sr == null) return
  if (sr.getResponseCode() in allowed) { sr.setSuccessful(true) }
  sr.getSubResults()?.each { walk(it) }
}
walk(prev)
</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
