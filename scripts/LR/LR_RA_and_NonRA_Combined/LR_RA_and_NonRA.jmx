            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Decode Password" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Base64

String encoded = vars.get(&quot;encodedPassword&quot;)
if (encoded != null) {
    String password = new String(Base64.getDecoder().decode(encoded), &quot;UTF-8&quot;)
    password = password.replace(&apos;\u00A0&apos;, &apos; &apos;).trim()
    vars.put(&quot;password&quot;, password)
}
def nonce = vars.get(&quot;noncex&quot;) ?: &quot;&quot;
def code = vars.get(&quot;codex&quot;) ?: &quot;&quot;
def csrf = vars.get(&quot;csrfx&quot;) ?: &quot;&quot;
if (!nonce || nonce.contains(&quot;${&quot;) || nonce == &quot;NOT_FOUND&quot; || !csrf || csrf == &quot;NOT_FOUND&quot; || !code || code == &quot;NOT_FOUND&quot;) {
    log.error(&quot;CUI login tokens missing noncex=&quot; + nonce + &quot; codex=&quot; + code + &quot; csrfx=&quot; + csrf)
}
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="CUI IdAM login 200/302" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def code = prev.getResponseCode()
if (code in [&apos;200&apos;,&apos;302&apos;,&apos;303&apos;]) { prev.setSuccessful(true) }
</stringProp>
            </JSR223Assertion>
            <hashTree/>
