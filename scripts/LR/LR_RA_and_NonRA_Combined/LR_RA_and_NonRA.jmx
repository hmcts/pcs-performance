            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Build evidence uploadedDocuments" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Base64
import java.nio.charset.StandardCharsets
def json = &apos;{&quot;index&quot;:0,&quot;id&quot;:&quot;&apos; + vars.get(&apos;evidenceDocId&apos;) + &apos;&quot;,&quot;document_filename&quot;:&quot;&apos; + vars.get(&apos;evidenceDocName&apos;) + &apos;&quot;,&quot;sizeInBytes&quot;:&apos; + vars.get(&apos;evidenceDocSize&apos;) + &apos;,&quot;content_type&quot;:&quot;&apos; + vars.get(&apos;evidenceDocType&apos;) + &apos;&quot;}&apos;
vars.put(&apos;evidenceDocPayload&apos;, Base64.getEncoder().encodeToString(json.getBytes(StandardCharsets.UTF_8)))
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
