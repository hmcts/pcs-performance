              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Assert DEFENDANTSOLICITOR role" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
def code = prev.getResponseCode()
def roles = []
if (code != &quot;200&quot;) {
  AssertionResult.setFailure(true)
  AssertionResult.setFailureMessage(&quot;case-users returned &quot; + code)
} else {
  def parsed = new JsonSlurper().parseText(prev.getResponseDataAsString() ?: &quot;{}&quot;)
  def uid = vars.get(&quot;userId&quot;)
  def mine = (parsed.case_users ?: []).findAll { it.user_id?.toString() == uid }
  roles = mine.collect { it.case_role }
  if (!roles.contains(&quot;[DEFENDANTSOLICITOR]&quot;)) {
    AssertionResult.setFailure(true)
    AssertionResult.setFailureMessage(&quot;Missing [DEFENDANTSOLICITOR] roles=&quot; + roles)
  }
}
</stringProp>
