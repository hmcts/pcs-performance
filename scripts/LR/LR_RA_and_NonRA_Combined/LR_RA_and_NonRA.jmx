            <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="script">// Get target value
String token13b = vars.get(&quot;XSRF-TOKEN13-b&quot;);

if (token13b == null || token13b.trim().equals(&quot;&quot;)) {
  
  String token13a = vars.get(&quot;XSRF-TOKEN13-a&quot;);
  
  if (token13a != null &amp;&amp; !token13a.trim().equals(&quot;&quot;)) {
      vars.put(&quot;XSRF-TOKEN13-b&quot;, token13a);
      log.info(&quot;XSRF-TOKEN13-b not found, copied value from XSRF-TOKEN13-a&quot;);
  } else {
      log.warn(&quot;Both XSRF-TOKEN13-b and XSRF-TOKEN13-a are empty.&quot;);
  }
} else {
  log.info(&quot;XSRF-TOKEN13-b already exists: &quot; + token13b);
}</stringProp>
            </BeanShellPostProcessor>
