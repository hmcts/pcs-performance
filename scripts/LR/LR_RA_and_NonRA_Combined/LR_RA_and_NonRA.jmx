              <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="decode" enabled="true">
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <boolProp name="resetInterpreter">false</boolProp>
                <stringProp name="script">import java.util.Base64;
import java.nio.charset.StandardCharsets;



String encodedPwd = vars.get(&quot;encodedPassword&quot;);
if (encodedPwd == null || encodedPwd.trim().isEmpty()) {
  encodedPwd = vars.get(&quot;password&quot;);
}
log.info(&quot;Encoded Password: &quot; + encodedPwd);
try {
  String decodedPwd = new String(Base64.getDecoder().decode(encodedPwd.trim()), StandardCharsets.UTF_8);
  vars.put(&quot;password&quot;, decodedPwd);
  log.info(&quot;Decoded Password: &quot; + decodedPwd);
} catch (Exception e) {
  log.info(&quot;Password already decoded or not Base64; using as-is: &quot; + encodedPwd);
}</stringProp>
              </BeanShellPreProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Retry EnterPassword on connection reset" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">int tryN = (vars.get(&quot;loginSubmitTry&quot;) ?: &quot;0&quot;).toInteger() + 1
vars.put(&quot;loginSubmitTry&quot;, String.valueOf(tryN))
String rc = prev.getResponseCode() ?: &quot;&quot;
int code = 0
try { if (rc.isInteger()) code = rc.toInteger() } catch (Exception ignored) {}
String msg = ((prev.getResponseMessage() ?: &quot;&quot;) + &quot; &quot; + (prev.getResponseDataAsString() ?: &quot;&quot;)).toLowerCase()
boolean transientFail = (!prev.isSuccessful() || prev.getErrorCount() &gt; 0) &amp;&amp; (
  msg.contains(&quot;connection reset&quot;) ||
  msg.contains(&quot;socketexception&quot;) ||
  msg.contains(&quot;timeout&quot;) ||
  code in [408, 429, 502, 503, 504]
)
boolean loginOk = prev.isSuccessful() &amp;&amp; !transientFail
vars.put(&quot;loginHttpOk&quot;, loginOk ? &quot;true&quot; : &quot;false&quot;)
if (loginOk || tryN &gt;= 4) {
  vars.put(&quot;loginNeedRetry&quot;, &quot;false&quot;)
} else {
  vars.put(&quot;loginNeedRetry&quot;, &quot;true&quot;)
  prev.setSuccessful(true)
  prev.setResponseMessage(&quot;Transient login/callback failure; retrying (&quot; + tryN + &quot;): &quot; + (prev.getResponseMessage() ?: &quot;&quot;).take(180))
  log.warn(prev.getResponseMessage())
  sleep(3000 + ctx.getThreadNum() * 1000)
}
</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
          </hashTree>
