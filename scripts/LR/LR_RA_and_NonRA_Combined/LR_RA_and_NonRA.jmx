                    <stringProp name="Header.value">*/*</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Bearer ${idamToken}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">ServiceAuthorization</stringProp>
                    <stringProp name="Header.value">Bearer ${S2S_TOKEN_PCS_API}</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="LINK returned 200" enabled="true">
                <collectionProp name="Asserion.test_strings"/>
                <collectionProp name="Assertion.test_strings">
                  <stringProp name="49586">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
                <boolProp name="Assertion.assume_success">false</boolProp>
                <intProp name="Assertion.test_type">8</intProp>
              </ResponseAssertion>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Write LR Board CSV" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">// Only write successful, unique CaseID rows (skip failed re-links / duplicates)
if (prev.getResponseCode() != &quot;200&quot;) {
  return
}
def caseIdOut = vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;
if (!caseIdOut) {
  return
}
def stamp = vars.get(&quot;outputStamp&quot;)
if (!stamp) stamp = new Date().format(&quot;yyyyMMdd-HHmmss&quot;)
def writtenKey = &quot;lrBoardWrittenCaseIds_&quot; + stamp
def written = props.get(writtenKey)
if (written == null) {
  written = java.util.Collections.synchronizedSet(new java.util.HashSet())
  props.put(writtenKey, written)
}
if (!written.add(caseIdOut)) {
  return
}
def baseDir = org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()
def csvFile = new File(baseDir, &quot;LR_Board_Output_&quot; + stamp + &quot;.csv&quot;)
if (!csvFile.exists()) {
  csvFile.write(&quot;ClaimantID,ClaimantPartyID,CaseID,DefendantsolicitorEmailRA,DefendantPartyID,LinkedCaseID,SolicitorClaimantEmail_XUI\n&quot;)
}
def claimantEmail = vars.get(&quot;SolicitorClaimantEmail_XUI&quot;) ?: vars.get(&quot;UsernameSolicitor&quot;) ?: &quot;&quot;
def claimantParty = vars.get(&quot;ResponsiblePartyID&quot;) ?: vars.get(&quot;PartyID&quot;) ?: &quot;&quot;
def defendantEmail = vars.get(&quot;DefendantsolicitorEmailRA&quot;) ?: &quot;&quot;
def defendantParty = vars.get(&quot;DefendantPartyID&quot;) ?: &quot;&quot;
csvFile.append(claimantEmail + &quot;,&quot; + claimantParty + &quot;,&quot; + caseIdOut + &quot;,&quot; + defendantEmail + &quot;,&quot; + defendantParty + &quot;,&quot; + caseIdOut + &quot;,&quot; + claimantEmail + &quot;\n&quot;)
</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
          </hashTree>
