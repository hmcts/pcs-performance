            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Count CYA attempt" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">int n = (vars.get(&quot;cyaSubmitTry&quot;) ?: &quot;0&quot;) as int
vars.put(&quot;cyaSubmitTry&quot;, String.valueOf(n + 1))
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Retry CYA 502/503/504" enabled="false">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def code = prev.getResponseCode() ?: &quot;&quot;
int tryN = (vars.get(&quot;cyaSubmitTry&quot;) ?: &quot;1&quot;) as int
def retryable = [&quot;502&quot;, &quot;503&quot;, &quot;504&quot;, &quot;408&quot;, &quot;429&quot;].contains(code)
def body = prev.getResponseDataAsString() ?: &quot;&quot;
if (code in [&quot;200&quot;, &quot;201&quot;] &amp;&amp; body.contains(&apos;&quot;id&quot;&apos;)) {
  vars.put(&quot;cyaHttpOk&quot;, &quot;true&quot;)
  vars.put(&quot;cyaNeedRetry&quot;, &quot;false&quot;)
} else if (retryable &amp;&amp; tryN &lt; 8) {
  vars.put(&quot;cyaHttpOk&quot;, &quot;false&quot;)
  vars.put(&quot;cyaNeedRetry&quot;, &quot;true&quot;)
  prev.setSuccessful(true)
  prev.setResponseMessage(&quot;Retryable &quot; + code + &quot; attempt &quot; + tryN + &quot;/8&quot;)
  sleep(8000L + (tryN * 2000L) + (ctx.getThreadNum() * 2000L))
} else {
  vars.put(&quot;cyaNeedRetry&quot;, &quot;false&quot;)
  if (!(code in [&quot;200&quot;, &quot;201&quot;])) {
    prev.setSuccessful(false)
    vars.put(&quot;cyaHttpOk&quot;, &quot;false&quot;)
  } else {
    vars.put(&quot;cyaHttpOk&quot;, &quot;true&quot;)
  }
}
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
