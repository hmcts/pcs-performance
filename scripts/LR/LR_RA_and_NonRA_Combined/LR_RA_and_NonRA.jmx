              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Retry or ignore work-basket errors" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">int n = (vars.get(&quot;wbTry&quot;) ?: &quot;0&quot;) as int
n++
vars.put(&quot;wbTry&quot;, String.valueOf(n))
def code = prev.getResponseCode() ?: &quot;&quot;
def retryable = [&quot;401&quot;,&quot;500&quot;,&quot;502&quot;,&quot;503&quot;,&quot;504&quot;,&quot;408&quot;,&quot;429&quot;].contains(code) || !prev.isSuccessful()
if (code in [&quot;200&quot;, &quot;201&quot;, &quot;204&quot;]) {
  vars.put(&quot;wbNeedRetry&quot;, &quot;false&quot;)
} else if (retryable &amp;&amp; n &lt; 4) {
  vars.put(&quot;wbNeedRetry&quot;, &quot;true&quot;)
  prev.setSuccessful(true)
  prev.setResponseMessage(&quot;Retry work-basket &quot; + code + &quot; &quot; + n + &quot;/4&quot;)
  log.warn(prev.getResponseMessage())
  sleep(2000L + (ctx.getThreadNum() * 500L))
} else {
  vars.put(&quot;wbNeedRetry&quot;, &quot;false&quot;)
  if (!(code in [&quot;200&quot;, &quot;201&quot;, &quot;204&quot;])) {
    prev.setSuccessful(true)
    prev.setResponseMessage(&quot;Ignored work-basket &quot; + code + &quot; so create-case continues&quot;)
    log.warn(prev.getResponseMessage())
  }
}
</stringProp>
              </JSR223PostProcessor>
