                <stringProp name="script">def n = (vars.get(&quot;ccdPartyRetry&quot;) ?: &quot;0&quot;) as int
vars.put(&quot;ccdPartyRetry&quot;, String.valueOf(n + 1))
</stringProp>
              </JSR223PreProcessor>
