              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract claimant Party ID" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def partyFromJson = &quot;&quot;
try {
def parsed = new JsonSlurper().parseText(body)
def first = parsed instanceof List ? (parsed ? parsed[0] : [:]) : parsed
if (first instanceof Map) {
  partyFromJson = (first.responsiblePartyId ?: first.partyId ?: first.party_id ?: &quot;&quot;).toString()
  def taskRaw = first.taskData
  if ((!partyFromJson) &amp;&amp; taskRaw) {
    def inner = (taskRaw instanceof String) ? new JsonSlurper().parseText(taskRaw) : taskRaw
    if (inner instanceof Map) {
      partyFromJson = (inner.responsiblePartyId ?: inner.partyId ?: inner.party_id ?: &quot;&quot;).toString()
    }
  }
}
} catch (Exception ignored) {}
if (partyFromJson) {
vars.put(&quot;ResponsiblePartyID&quot;, partyFromJson)
vars.put(&quot;PartyID&quot;, partyFromJson)
}
vars.put(&quot;CASEID&quot;, vars.get(&quot;id&quot;) ?: &quot;&quot;)
vars.put(&quot;UsernameSolicitor&quot;, vars.get(&quot;SolicitorClaimantEmail_XUI&quot;) ?: &quot;&quot;)
</stringProp>
              </JSR223PostProcessor>
