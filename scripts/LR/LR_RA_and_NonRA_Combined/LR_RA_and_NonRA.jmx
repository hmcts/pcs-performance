              <ConstantTimer guiclass="ConstantTimerGui" testclass="ConstantTimer" testname="Wait for party id" enabled="true">
                <stringProp name="ConstantTimer.delay">${PartyIdWaitMs}</stringProp>
              </ConstantTimer>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">ServiceAuthorization</stringProp>
                    <stringProp name="Header.value">Bearer ${S2S_TOKEN_CCD}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Authorization</stringProp>
                    <stringProp name="Header.value">Bearer ${claimantIdamToken}</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Experimental</stringProp>
                    <stringProp name="Header.value">true</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract Defendant Party ID from CCD" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
def uuidRe = ~/(?i)^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def found = []
def partyKeys = []
def defFieldIds = 0
def walk
walk = { node, path, inDef -&gt;
if (node instanceof Map) {
  def fieldId = (node.id ?: &quot;&quot;).toString().toLowerCase()
  if (fieldId.contains(&quot;defendant&quot;)) defFieldIds++
  def ctx = inDef || fieldId.contains(&quot;defendant&quot;) || path.toLowerCase().contains(&quot;defendant&quot;)
  node.each { k, v -&gt;
    def kl = k.toString().toLowerCase()
    def p = path + &quot;.&quot; + k
    def here = ctx || kl.contains(&quot;defendant&quot;)
    if (v instanceof String &amp;&amp; (v ==~ uuidRe)) {
      if (kl.contains(&quot;party&quot;) || kl == &quot;id&quot; &amp;&amp; here) found &lt;&lt; v
      if (kl.contains(&quot;party&quot;)) partyKeys &lt;&lt; v
    }
    if (v instanceof Map &amp;&amp; v.id instanceof String &amp;&amp; (v.id ==~ uuidRe) &amp;&amp; here) found &lt;&lt; v.id
    if (v instanceof String &amp;&amp; (v.trim().startsWith(&quot;{&quot;) || v.trim().startsWith(&quot;[&quot;))) {
      try { walk(new JsonSlurper().parseText(v), p + &quot;.json&quot;, here) } catch (Exception ignored) {}
    }
    walk(v, p, here)
  }
} else if (node instanceof List) {
  node.eachWithIndex { v, i -&gt; walk(v, path + &quot;[&quot; + i + &quot;]&quot;, inDef) }
}
}
try { walk(new JsonSlurper().parseText(body), &quot;root&quot;, false) } catch (Exception ignored) {}
found = found.unique()
def claimant = vars.get(&quot;ResponsiblePartyID&quot;) ?: vars.get(&quot;PartyID&quot;) ?: &quot;&quot;
def defendant = found.find { it &amp;&amp; it != claimant } ?: &quot;&quot;
if (defendant) vars.put(&quot;DefendantPartyID&quot;, defendant)
vars.put(&quot;CASEID&quot;, vars.get(&quot;id&quot;) ?: &quot;&quot;)
</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Write CreateCase CSV" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer
String claimant = vars.get(&quot;SolicitorClaimantEmail_XUI&quot;) ?: &quot;&quot;
String defendant = vars.get(&quot;DefendantsolicitorEmailRA&quot;) ?: &quot;&quot;
String caseId = vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;
String partyId = vars.get(&quot;PartyID&quot;) ?: &quot;NOT_FOUND&quot;
File dir = new File(FileServer.getFileServer().getBaseDir())
String stamp = vars.get(&quot;outputStamp&quot;)
if (!stamp) stamp = new Date().format(&quot;yyyyMMdd-HHmmss&quot;)
File out = new File(dir, &quot;output_CreateCase_&quot; + stamp + &quot;.csv&quot;)
if (!out.exists()) out.write(&quot;caseID,SolicitorClaimantEmail_XUI,DefendantsolicitorEmailRA,partyID\n&quot;)
out.append(caseId + &quot;,&quot; + claimant + &quot;,&quot; + defendant + &quot;,&quot; + partyId + &quot;\n&quot;)
SampleResult.setIgnore()
</stringProp>
        </JSR223Sampler>
