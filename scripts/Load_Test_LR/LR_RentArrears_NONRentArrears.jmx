        <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="NOC_Input_LR" enabled="true">
          <stringProp name="filename">${__BeanShell(import org.apache.jmeter.services.FileServer; FileServer.getFileServer().getBaseDir() + File.separator +&quot;NOC_Input_LR_RA.csv&quot;)}</stringProp>
          <stringProp name="fileEncoding">UTF-8</stringProp>
          <stringProp name="variableNames">CASEID,DefendantsolicitorEmailRA</stringProp>
          <stringProp name="delimiter">,</stringProp>
          <stringProp name="shareMode">shareMode.group</stringProp>
          <boolProp name="ignoreFirstLine">true</boolProp>
          <boolProp name="quotedData">false</boolProp>
          <boolProp name="recycle">false</boolProp>
          <boolProp name="stopThread">true</boolProp>
        </CSVDataSet>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Map RA case CSV for NOC" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">def c = (vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;caseID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;).replaceAll(&quot;[^0-9]&quot;, &quot;&quot;).trim()
vars.put(&quot;CASEID&quot;, c)
vars.put(&quot;Caseid&quot;, c)
vars.put(&quot;id&quot;, c)
if (!vars.get(&quot;firstName&quot;)) { vars.put(&quot;firstName&quot;, &quot;Test&quot;) }
if (!vars.get(&quot;lastName&quot;)) { vars.put(&quot;lastName&quot;, &quot;Test&quot;) }
def nocUser = (vars.get(&quot;DefendantsolicitorEmailRA&quot;) ?: &quot;&quot;).trim()
if (nocUser.contains(&quot;@&quot;)) { vars.put(&quot;username&quot;, nocUser) }
SampleResult.setIgnore()
</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Prepare NOC case and answers" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def c = (vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;).replaceAll(&quot;[^0-9]&quot;, &quot;&quot;).trim()
vars.put(&quot;Caseid&quot;, c)
vars.put(&quot;CASEID&quot;, c)
if (!vars.get(&quot;firstName&quot;)) { vars.put(&quot;firstName&quot;, &quot;Test&quot;) }
if (!vars.get(&quot;lastName&quot;)) { vars.put(&quot;lastName&quot;, &quot;Test&quot;) }
def nocUser = (vars.get(&quot;DefendantsolicitorEmailRA&quot;) ?: &quot;&quot;).trim()
if (!nocUser) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseMessage(&quot;No DefendantsolicitorEmailRA for NOC login&quot;)
  SampleResult.setStopThread(true)
}
</stringProp>
        </JSR223Sampler>
        <hashTree/>
