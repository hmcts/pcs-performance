              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Retry ViewCase until 200" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def c = prev.getResponseCode()
vars.put(&quot;viewCaseRc&quot;, c ?: &quot;&quot;)
if (c == &quot;200&quot; || c == &quot;404&quot;) { prev.setSuccessful(true) }
if (c != &quot;200&quot;) { Thread.sleep(2000) }
</stringProp>
              </JSR223Assertion>
