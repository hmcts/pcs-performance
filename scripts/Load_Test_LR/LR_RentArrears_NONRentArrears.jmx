              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def code = prev.getResponseCode()
if (code in [&apos;200&apos;,&apos;302&apos;,&apos;303&apos;]) { prev.setSuccessful(true) }
</stringProp>
            </JSR223Assertion>
            <hashTree/>
          </hashTree>
