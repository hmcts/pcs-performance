            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Build legalRep contact payload" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
def raw = prev.getResponseDataAsString() ?: &quot;&quot;
if (!raw.trim().startsWith(&quot;{&quot;)) {
  log.error(&quot;legalRep trigger not JSON for case &quot; + vars.get(&quot;Caseid&quot;) + &quot; code=&quot; + prev.getResponseCode())
  vars.put(&quot;lrEventToken&quot;, &quot;&quot;)
  vars.put(&quot;lrContactDataJson&quot;, &quot;{}&quot;)
  return
}
def json = new JsonSlurper().parseText(raw)
def token = (json.event_token ?: &quot;&quot;).toString()
vars.put(&quot;lrEventToken&quot;, token)
def fields = [:]
(json.case_fields ?: []).each { f -&gt; fields[f.id] = f.value }
def email = (fields.originalEmailAddress ?: vars.get(&quot;DefendantsolicitorEmailRA&quot;) ?: &quot;&quot;).toString()
def orgAddr = fields.legalRepresentativeOrganisationAddress ?: [:]
def data = [
  reference: null,
  originalEmailAddress: email,
  useEmailAddress: &quot;YES&quot;,
  organisationAddressFound: (fields.organisationAddressFound ?: &quot;Yes&quot;),
  legalRepresentativeOrganisationAddress: orgAddr,
  formattedContactAddress: (fields.formattedContactAddress ?: &quot;&quot;),
  organisationId: (fields.organisationId ?: &quot;&quot;),
  differentPostalAddress: &quot;NO&quot;,
  provideContactPhoneNumber: &quot;NO&quot;
]
vars.put(&quot;lrContactDataJson&quot;, JsonOutput.toJson(data))
if (!token) { log.error(&quot;lrEventToken missing for case &quot; + vars.get(&quot;Caseid&quot;)) }
</stringProp>
            </JSR223PostProcessor>
