            <hashTree/>
            <JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="uploadDocId" enabled="true">
              <stringProp name="JSONPostProcessor.referenceNames">uploadDocId;uploadDocName;uploadDocSize;uploadDocType</stringProp>
              <stringProp name="JSONPostProcessor.jsonPathExprs">$.document.id;$.document.document_filename;$.document.sizeInBytes;$.document.content_type</stringProp>
              <stringProp name="JSONPostProcessor.match_numbers">1;1;1;1</stringProp>
              <stringProp name="JSONPostProcessor.defaultValues">NOT_FOUND;NOT_FOUND;NOT_FOUND;NOT_FOUND</stringProp>
            </JSONPostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Build uploadedDocuments" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Base64
import java.nio.charset.StandardCharsets
def json = &apos;{&quot;index&quot;:0,&quot;id&quot;:&quot;&apos; + vars.get(&apos;uploadDocId&apos;) + &apos;&quot;,&quot;document_filename&quot;:&quot;&apos; + vars.get(&apos;uploadDocName&apos;) + &apos;&quot;,&quot;sizeInBytes&quot;:&apos; + vars.get(&apos;uploadDocSize&apos;) + &apos;,&quot;content_type&quot;:&quot;&apos; + vars.get(&apos;uploadDocType&apos;) + &apos;&quot;}&apos;
vars.put(&apos;uploadedDocPayload&apos;, Base64.getEncoder().encodeToString(json.getBytes(StandardCharsets.UTF_8)))
</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
