            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract CUI csrf from start-now SSO chain" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">def samples = []
def walk
walk = { sr -&gt;
  if (sr == null) return
  samples &lt;&lt; sr
  sr.getSubResults()?.each { walk(it) }
}
walk(prev)
def token = null
samples.reverseEach { sr -&gt;
  if (token) return
  def u = (sr.getUrlAsString() ?: &quot;&quot;)
  def body = (sr.getResponseDataAsString() ?: &quot;&quot;)
  if (!(u.contains(&quot;respond-to-claim&quot;) || u.contains(&quot;pcs.perftest&quot;))) return
  def m = (body =~ /name=[&apos;&quot;]_csrf[&apos;&quot;][^&gt;]*value=[&apos;&quot;]([^&apos;&quot;]+)[&apos;&quot;]/)
  if (m.find()) { token = m.group(1); return }
  m = (body =~ /_csrf&quot; value=&quot;([^&quot;]+)&quot;/)
  if (m.find()) { token = m.group(1) }
}
if (token) {
  vars.put(&quot;csrf1x&quot;, token)
  vars.put(&quot;csrfx&quot;, token)
}
vars.put(&quot;cuiNeedResume&quot;, &quot;false&quot;)
</stringProp>
            </JSR223PostProcessor>
