        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Prepare NOC case and answers" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def c = (vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;).replaceAll(&quot;[^0-9]&quot;, &quot;&quot;).trim()
vars.put(&quot;Caseid&quot;, c)
vars.put(&quot;CASEID&quot;, c)
if (!vars.get(&quot;firstName&quot;)) { vars.put(&quot;firstName&quot;, &quot;Test&quot;) }
if (!vars.get(&quot;lastName&quot;)) { vars.put(&quot;lastName&quot;, &quot;Test&quot;) }
def nocUser = (vars.get(&quot;DefendantsolicitorEmail_NonRA&quot;) ?: &quot;&quot;).trim()
if (!nocUser) {
  SampleResult.setSuccessful(false)
  SampleResult.setResponseMessage(&quot;No DefendantsolicitorEmail_NonRA for NOC login&quot;)
  SampleResult.setStopThread(true)
}
</stringProp>
        </JSR223Sampler>
