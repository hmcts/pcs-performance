        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Prepare Non Rent Arrears from NOC case" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def caseId = (vars.get(&quot;Caseid&quot;) ?: vars.get(&quot;CASEID&quot;) ?: vars.get(&quot;id&quot;) ?: &quot;&quot;).replaceAll(&quot;[^0-9]&quot;, &quot;&quot;).trim()
vars.put(&quot;Caseid&quot;, caseId)
vars.put(&quot;CASEID&quot;, caseId)
def user = (vars.get(&quot;DefendantsolicitorEmail_NonRA&quot;) ?: &quot;&quot;).trim()
vars.put(&quot;username&quot;, user)
SampleResult.setResponseData((&quot;Caseid=&quot; + caseId + &quot; username=&quot; + user).getBytes(&quot;UTF-8&quot;))
</stringProp>
        </JSR223Sampler>
