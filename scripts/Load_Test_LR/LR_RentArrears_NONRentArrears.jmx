            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="Accept CUI logout 200 302 or 303" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def allowed = [&apos;200&apos;,&apos;302&apos;,&apos;303&apos;]
def walk
walk = { sr -&gt;
  if (sr == null) return
  if (sr.getResponseCode() in allowed) { sr.setSuccessful(true) }
  sr.getSubResults()?.each { walk(it) }
}
walk(prev)
</stringProp>
            </JSR223Assertion>
