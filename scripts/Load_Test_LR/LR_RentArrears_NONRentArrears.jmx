                  <stringProp name="File.mimetype">application/vnd.openxmlformats-officedocument.wordprocessingml.document</stringProp>
                  <stringProp name="File.path">${__BeanShell(import org.apache.jmeter.services.FileServer; FileServer.getFileServer().getBaseDir() + File.separator + &quot;1mb.docx&quot;)}</stringProp>
                  <stringProp name="File.paramname">documents</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
