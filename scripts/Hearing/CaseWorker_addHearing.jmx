            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract cancel hearing fields" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
def json = new JsonSlurper().parseText(prev.getResponseDataAsString())
def data = [:]
if (json.data instanceof Map) {
    data.putAll(json.data)
}
(json.case_fields ?: []).each { cf -&gt;
    if (cf?.id != null &amp;&amp; !data.containsKey(cf.id)) {
        data[cf.id] = cf.value
    }
}
if (json.event_token) {
    vars.put(&apos;event_token2&apos;, json.event_token.toString())
}
def hid = data.hearing_HearingId?.toString() ?: vars.get(&apos;HearingId&apos;) ?: &apos;&apos;
vars.put(&apos;HearingId&apos;, hid)
vars.put(&apos;hearingId&apos;, hid)
vars.put(&apos;hearingSummaryMarkdownJson&apos;, JsonOutput.toJson(data.hearing_HearingSummaryMarkdown))
if (data.hearingLocation) {
    vars.put(&apos;hearingLocation&apos;, data.hearingLocation.toString())
}
log.info(&quot;Cancel HearingId=&quot; + vars.get(&apos;HearingId&apos;))
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
