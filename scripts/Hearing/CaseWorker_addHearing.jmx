              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def response = prev.getResponseDataAsString()
def json = new JsonSlurper().parseText(response)

// CCD start-event payload uses case_fields[], not a top-level data object
def data = [:]
if (json.data instanceof Map) {
    data.putAll(json.data)
}
(json.case_fields ?: []).each { cf -&gt;
    if (cf?.id != null &amp;&amp; !data.containsKey(cf.id)) {
        data[cf.id] = cf.value
    }
}

vars.put(&apos;hearingType&apos;, data.hearing_Type?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingNoticeWording&apos;, data.hearing_NoticeWording?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingDate&apos;, data.hearing_Date?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingDurationHours&apos;, data.hearing_DurationHours?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingDurationMinutes&apos;, data.hearing_DurationMinutes?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingDurationDays&apos;, data.hearing_DurationDays?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingNotes&apos;, data.hearing_Notes?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingIssueNotice&apos;, data.hearing_IssueNotice?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingIsWithoutNotice&apos;, data.hearing_IsWithoutNotice?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingAdditionalInformation&apos;, data.hearing_AdditionalInformation?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingId&apos;, data.hearing_HearingId?.toString() ?: &apos;&apos;)
vars.put(&apos;HearingId&apos;, data.hearing_HearingId?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingOtherType&apos;, data.hearing_OtherHearingType?.toString() ?: &apos;&apos;)
vars.put(&apos;hearingCancellationReason&apos;, data.hearing_CancellationReason?.toString() ?: &apos;&apos;)
if (data.hearingLocation) {
    vars.put(&apos;hearingLocation&apos;, data.hearingLocation.toString())
}

def items = []
def pms = data.partyMultiSelectionList
if (pms instanceof Map &amp;&amp; pms.list_items) {
    items = pms.list_items
} else if (vars.get(&apos;Code1&apos;) &amp;&amp; vars.get(&apos;Code1&apos;) != &apos;not found&apos;) {
    items = [[code: vars.get(&apos;Code1&apos;), label: vars.get(&apos;PartyLabel1&apos;)]]
    if (vars.get(&apos;Code2&apos;) &amp;&amp; vars.get(&apos;Code2&apos;) != &apos;not found&apos;) {
        items.add([code: vars.get(&apos;Code2&apos;), label: vars.get(&apos;PartyLabel2&apos;)])
    }
}
def selected = items
if (pms instanceof Map &amp;&amp; pms.value instanceof List &amp;&amp; pms.value) {
    selected = pms.value
}
vars.put(&apos;partyListItemsJson&apos;, JsonOutput.toJson(items ?: []))
vars.put(&apos;partyListValueJson&apos;, JsonOutput.toJson(selected ?: []))
vars.put(&apos;hearingSummaryMarkdownJson&apos;, JsonOutput.toJson(data.hearing_HearingSummaryMarkdown))
if (!vars.get(&apos;hearingId&apos;)) {
    vars.put(&apos;hearingId&apos;, &apos;&apos;)
}

// =====================================================
// Case information
// =====================================================

vars.put(&apos;defendantNames&apos;, data.defendantNames?.toString() ?: &apos;&apos;)
vars.put(&apos;claimantNames&apos;, data.claimantNames?.toString() ?: &apos;&apos;)
vars.put(&apos;caseNamePublic&apos;, data.caseNamePublic?.toString() ?: &apos;&apos;)
vars.put(&apos;caseNameHmctsInternal&apos;, data.caseNameHmctsInternal?.toString() ?: &apos;&apos;)
vars.put(&apos;caseNameHmctsRestricted&apos;, data.caseNameHmctsRestricted?.toString() ?: &apos;&apos;)
vars.put(&apos;propertyPostCode&apos;, data.postCode?.toString() ?: &apos;&apos;)

// =====================================================
// Extract CASE_REFERENCE from caseTitleMarkdown
// Example:
// &quot;Case number: ${[CASE_REFERENCE]}&quot;
// =====================================================

def caseTitle = data.caseTitleMarkdown?.toString() ?: &apos;&apos;

def caseReferenceMatcher = caseTitle =~ /Case number:\s*([^&lt;\n]+)/
if (caseReferenceMatcher.find()) {
vars.put(&apos;caseReference&apos;, caseReferenceMatcher.group(1).trim())
} else {
vars.put(&apos;caseReference&apos;, &apos;&apos;)
}

// =====================================================
// Extract first defendant
// =====================================================

def defendant = data.allDefendants?.getAt(0)

if (defendant) {
vars.put(&apos;defendantId&apos;, defendant.id?.toString() ?: &apos;&apos;)


def defendantValue = defendant.value

vars.put(&apos;defendantFirstName&apos;, defendantValue?.firstName?.toString() ?: &apos;&apos;)
vars.put(&apos;defendantLastName&apos;, defendantValue?.lastName?.toString() ?: &apos;&apos;)

vars.put(
    &apos;defendantFullName&apos;,
    &quot;${defendantValue?.firstName ?: &apos;&apos;} ${defendantValue?.lastName ?: &apos;&apos;}&quot;.trim()
)

}

// =====================================================
// Extract all parties
// =====================================================

def parties = data.parties ?: []

vars.put(&apos;partyCount&apos;, parties.size().toString())

// First party
if (parties.size() &gt; 0) {
def party1 = parties[0]
vars.put(&apos;party1Id&apos;, party1.id?.toString() ?: &apos;&apos;)
vars.put(&apos;party1OrgName&apos;, party1.value?.orgName?.toString() ?: &apos;&apos;)
}

// Second party
if (parties.size() &gt; 1) {
def party2 = parties[1]
vars.put(&apos;party2Id&apos;, party2.id?.toString() ?: &apos;&apos;)

def party2Value = party2.value

vars.put(
    &apos;party2Name&apos;,
    &quot;${party2Value?.firstName ?: &apos;&apos;} ${party2Value?.lastName ?: &apos;&apos;}&quot;.trim()
)

}

// =====================================================
// Case management location
// =====================================================

vars.put(
&apos;caseManagementRegion&apos;,
data.caseManagementLocation?.region?.toString() ?: &apos;&apos;
)

vars.put(
&apos;caseManagementBaseLocation&apos;,
data.caseManagementLocation?.baseLocation?.toString() ?: &apos;&apos;
)

// =====================================================
// Log extracted values
// =====================================================

log.info(&quot;===== Extracted manageHearing values =====&quot;)
log.info(&quot;caseReference = ${vars.get(&apos;caseReference&apos;)}&quot;)
log.info(&quot;hearingType = ${vars.get(&apos;hearingType&apos;)}&quot;)
log.info(&quot;hearingNoticeWording = ${vars.get(&apos;hearingNoticeWording&apos;)}&quot;)
log.info(&quot;hearingDate = ${vars.get(&apos;hearingDate&apos;)}&quot;)
log.info(&quot;hearingId = ${vars.get(&apos;hearingId&apos;)}&quot;)
log.info(&quot;defendantId = ${vars.get(&apos;defendantId&apos;)}&quot;)
log.info(&quot;defendantFullName = ${vars.get(&apos;defendantFullName&apos;)}&quot;)
log.info(&quot;party2Id = ${vars.get(&apos;party2Id&apos;)}&quot;)
log.info(&quot;caseManagementRegion = ${vars.get(&apos;caseManagementRegion&apos;)}&quot;)
log.info(&quot;caseManagementBaseLocation = ${vars.get(&apos;caseManagementBaseLocation&apos;)}&quot;)
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
