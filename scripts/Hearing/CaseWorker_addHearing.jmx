              <stringProp name="TestPlan.comments">hearing_HearingSummaryMarkdown&quot;,&quot;label&quot;:&quot;&quot;,&quot;hidden&quot;:null,&quot;value&quot;:&quot;&lt;p class=\&quot;body govuk-!-font-weight-bold\&quot;&gt;You’re viewing the next scheduled hearing for this case.&lt;/p&gt;\n\n&lt;h3 class=\&quot;govuk-heading-s govuk-!-margin-bottom-1\&quot;&gt;Hearing location:&lt;/h3&gt;\n&lt;p class=\&quot;body\&quot;&gt;Central London County Court&lt;/p&gt;\n\n&lt;h3 class=\&quot;govuk-heading-s govuk-!-margin-bottom-1\&quot;&gt;Which type of hearing is this?&lt;/h3&gt;\n&lt;p class=\&quot;body\&quot;&gt;Possession first hearing&lt;/p&gt;\n\n&lt;h3 class=\&quot;govuk-heading-s govuk-!-margin-bottom-1\&quot;&gt;When is the hearing?&lt;/h3&gt;\n&lt;p class=\&quot;body\&quot;&gt;2 February 2027, 11:00am&lt;/p&gt;\n\n&lt;h3 class=\&quot;govuk-heading-s govuk-!-margin-bottom-1\&quot;&gt;Hearing duration&lt;/h3&gt;\n&lt;p class=\&quot;body\&quot;&gt;1 hour 15 minutes&lt;/p&gt;\n\n&lt;h3 class=\&quot;govuk-heading-s govuk-!-margin-bottom-1\&quot;&gt;Hearing notes&lt;/h3&gt;\n&lt;p class=\&quot;body\&quot;&gt;hearing testing for further discussion on claim issues&lt;/p&gt;\n\n&lt;p class=\&quot;body govuk-!-margin-bottom-2\&quot;&gt;&amp;nbsp;&lt;/p&gt;\n&quot;,&quot;metadata</stringProp>
            </RegexExtractor>
