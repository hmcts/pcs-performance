                  </elementProp>
                </collectionProp>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build AddCaseNote Bodies" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def prefix = vars.get(&quot;noteTextPrefix&quot;) ?: &quot;Testing&quot;
def noteText = prefix + &quot;-&quot; + ctx.getThread().getThreadName() + &quot;-&quot; + System.currentTimeMillis()
vars.put(&quot;noteText&quot;, noteText)
def caseId = vars.get(&quot;Case_ID&quot;)
def eventToken = vars.get(&quot;event_token&quot;)
def esc = { s -&gt; s.replace(&apos;\\&apos;, &apos;\\\\&apos;).replace(&apos;&quot;&apos;, &apos;\\&quot;&apos;) }
def n = esc(noteText)
vars.put(&quot;addCaseNoteValidateBody&quot;, &apos;{&quot;data&quot;:{&quot;note&quot;:&quot;&apos; + n + &apos;&quot;},&quot;event&quot;:{&quot;id&quot;:&quot;addCaseNote&quot;,&quot;summary&quot;:&quot;&quot;,&quot;description&quot;:&quot;&quot;},&quot;event_data&quot;:{&quot;note&quot;:&quot;&apos; + n + &apos;&quot;},&quot;event_token&quot;:&quot;&apos; + eventToken + &apos;&quot;,&quot;ignore_warning&quot;:false,&quot;case_reference&quot;:&quot;&apos; + caseId + &apos;&quot;}&apos;)
vars.put(&quot;addCaseNoteEventBody&quot;, &apos;{&quot;data&quot;:{&quot;note&quot;:&quot;&apos; + n + &apos;&quot;},&quot;event&quot;:{&quot;id&quot;:&quot;addCaseNote&quot;,&quot;summary&quot;:&quot;&quot;,&quot;description&quot;:&quot;&quot;},&quot;event_token&quot;:&quot;&apos; + eventToken + &apos;&quot;,&quot;ignore_warning&quot;:false}&apos;)</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.case-data-validate.v2+json;charset=UTF-8</stringProp>
