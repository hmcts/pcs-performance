              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Validate Case Search Result" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
  import java.text.SimpleDateFormat

  def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
  def auditPath = new File(scriptHome, vars.get(&quot;auditLogPath&quot;) ?: &quot;CCNotes_audit.log&quot;).absolutePath
  def auditFile = new File(auditPath)
  def threadName = ctx.getThread().getThreadName()
  def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
  def expectedCaseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
  vars.put(&quot;cc_case_ready&quot;, &quot;false&quot;)

  def writeAudit = { level, event, extra -&gt;
      def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
      def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
      def line = &quot;[&quot; + ts + &quot;] [&quot; + level + &quot;] event=&quot; + event + &quot; | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=&quot; + expectedCaseId + &quot; | &quot; + extra
      auditFile.append(line + &quot;\n&quot;)
      if (level == &quot;FAIL&quot;) {
          def errorPath = props.get(&quot;__CC_ERROR_LOG_PATH__&quot;)
          if (errorPath) { new File(errorPath).append(line + &quot;\n&quot;, &quot;UTF-8&quot;) }
          log.error(line)
      } else {
          log.info(line)
      }
  }

  def iterKey = &quot;__cc_iteration_&quot; + threadName
  def iteration = (props.get(iterKey) ?: &quot;0&quot;).toInteger() + 1
  props.put(iterKey, iteration.toString())
  vars.put(&quot;cc_iteration&quot;, iteration.toString())
  writeAudit(&quot;INFO&quot;, &quot;RUN_START&quot;, &quot;starting iteration &quot; + iteration)

  def responseBody = prev.getResponseDataAsString() ?: &quot;&quot;
  if (prev.getResponseCode() != &quot;200&quot; || !responseBody) {
      writeAudit(&quot;FAIL&quot;, &quot;CASE_SEARCH&quot;, &quot;case search failed HTTP=&quot; + prev.getResponseCode())
      return
  }

  def results = (new JsonSlurper().parseText(responseBody).results ?: [])
  def ids = results.collect { it?.case_id?.toString() }.findAll { it }.unique()
  if (!ids) {
      if (expectedCaseId) {
          writeAudit(&quot;INFO&quot;, &quot;CASE_SEARCH&quot;, &quot;no search hits; continuing with csvCase_ID=&quot; + expectedCaseId)
      } else {
          writeAudit(&quot;FAIL&quot;, &quot;CASE_SEARCH&quot;, &quot;solicitor has no searchable PCS cases (count=0)&quot;)
          prev.setSuccessful(false)
          prev.setResponseMessage(&quot;No cases returned for solicitor search&quot;)
          return
      }
  }

  def claimedKey = &quot;__CC_NOTES_CLAIMED_IDS__&quot;
  synchronized (org.apache.jmeter.JMeter.class) {
      if (!props.containsKey(claimedKey)) {
          props.put(claimedKey, java.util.Collections.synchronizedSet(new LinkedHashSet()))
      }
  }
  def claimed = props.get(claimedKey) as Set
  def chosen = null
  synchronized (claimed) {
      if (expectedCaseId) {
          chosen = expectedCaseId
      } else {
          chosen = ids.find { !claimed.contains(it) } ?: ids[0]
      }
      claimed.add(chosen)
  }
  vars.put(&quot;Case_ID&quot;, chosen)
  vars.put(&quot;cc_case_ready&quot;, &quot;true&quot;)
  writeAudit(&quot;PASS&quot;, &quot;CASE_FOUND&quot;, &quot;Case_ID=&quot; + chosen + &quot; | csvCase_ID=&quot; + expectedCaseId + &quot; | searchCount=&quot; + ids.size())</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
