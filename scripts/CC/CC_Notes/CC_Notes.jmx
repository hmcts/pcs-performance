          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="/data/case-types/PCS/validate?pageId=addCaseNoteaddCaseNote" enabled="true">
              <stringProp name="HTTPSampler.path">/data/case-types/PCS/validate?pageId=addCaseNoteaddCaseNote</stringProp>
