        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="JSR223 Sampler" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">def solicitor = (vars.get(&quot;solicitor_username&quot;) ?: &quot;&quot;).trim()
if (solicitor &amp;&amp; !solicitor.contains(&quot;@&quot;)) {
    solicitor = solicitor + &quot;@test.com&quot;
}
vars.put(&quot;solicitor_username&quot;, solicitor)
vars.put(&quot;username&quot;, solicitor)

def caseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
vars.put(&quot;Case_ID&quot;, caseId)

def admin = (vars.get(&quot;admin_username&quot;) ?: &quot;&quot;).trim()
if (!admin &amp;&amp; solicitor =~ /pcs-solicitor(\\d+)/) {
    def num = (solicitor =~ /pcs-solicitor(\\d+)/)[0][1] as int
    def adminNum = num &gt;= 500 ? (num - 100) : (num + 300)
    if (adminNum &gt; 419) { adminNum = 400 + ((adminNum - 401) % 19) + 1 }
    admin = &quot;PCS-CTSC-Admin&quot; + adminNum + &quot;@hmcts.net&quot;
}
vars.put(&quot;admin_username&quot;, admin)
vars.put(&quot;cc_case_ready&quot;, &quot;false&quot;)

log.info(&quot;Thread: &quot; + Thread.currentThread().getName())
log.info(&quot;Solicitor: &quot; + vars.get(&quot;solicitor_username&quot;))
log.info(&quot;Case_ID: &quot; + vars.get(&quot;Case_ID&quot;))
log.info(&quot;Admin: &quot; + vars.get(&quot;admin_username&quot;))
log.info(&quot;Active user: &quot; + vars.get(&quot;username&quot;))
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
