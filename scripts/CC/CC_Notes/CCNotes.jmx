              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="08 Log Verify Result" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import java.text.SimpleDateFormat

def code = prev.getResponseCode() ?: &apos;unknown&apos;
def caseId = vars.get(&quot;Case_ID&quot;)
def noteText = vars.get(&quot;noteText&quot;) ?: &quot;&quot;
def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
def threadName = ctx.getThread().getThreadName()
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def noteFound = noteText &amp;&amp; body.contains(&apos;&quot;note&quot;:&quot;&apos; + noteText + &apos;&quot;&apos;)
def ok = prev.isSuccessful() &amp;&amp; noteFound
def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
def auditPath = new File(scriptHome, vars.get(&quot;auditLogPath&quot;) ?: &quot;Logs/CCNotes-audit.log&quot;).absolutePath
def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
def completeKey = &quot;cc_run_complete_&quot; + threadName + &quot;_&quot; + iteration

if (ok &amp;&amp; !props.get(completeKey)) {
    props.put(completeKey, &quot;true&quot;)
    new File(auditPath).append(&quot;[&quot; + ts + &quot;] [PASS] event=NOTE_VERIFIED | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | Case_ID=&quot; + caseId + &quot; | noteText=&quot; + noteText + &quot;\n&quot;)
    new File(auditPath).append(&quot;[&quot; + ts + &quot;] [PASS] event=RUN_COMPLETE | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | Case_ID=&quot; + caseId + &quot; | noteText=&quot; + noteText + &quot;\n&quot;)
    log.info(&quot;[PASS] NOTE_VERIFIED noteText=&quot; + noteText)
} else if (!ok) {
    def line = &quot;[&quot; + ts + &quot;] [FAIL] event=NOTE_VERIFY_FAIL | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | Case_ID=&quot; + caseId + &quot; | noteText=&quot; + noteText + &quot; | HTTP=&quot; + code + &quot; | noteFound=&quot; + noteFound
    new File(auditPath).append(line + &quot;\n&quot;)
    def errorPath = props.get(&quot;__CC_ERROR_LOG_PATH__&quot;)
    if (errorPath) { new File(errorPath).append(line + &quot;\n&quot;, &quot;UTF-8&quot;) }
    log.error(line)
    prev.setSuccessful(false)
}</stringProp>
