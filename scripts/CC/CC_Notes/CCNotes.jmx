            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract OAuth from IDAM URL" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def url = prev.getURL()?.toString() ?: &quot;&quot;

def extractParam = { u, param -&gt;
    def m = (u =~ /[?&amp;]${param}=([^&amp;]+)/)
    return m.find() ? java.net.URLDecoder.decode(m.group(1), &quot;UTF-8&quot;) : null
}

def urlNonce = extractParam(url, &quot;nonce&quot;)
def urlState = extractParam(url, &quot;state&quot;)
def urlChallenge = extractParam(url, &quot;code_challenge&quot;)

if (urlNonce) { vars.put(&quot;nonce&quot;, urlNonce) }
if (urlState) { vars.put(&quot;state&quot;, urlState) }
if (urlChallenge) { vars.put(&quot;code_challenge&quot;, urlChallenge) }
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="DEBUG Login Hop Logger" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// #region agent log
def logPaths = [
    &quot;/Users/priyadharsini/Desktop/apache-jmeter-5.6.3/bin/jmeterscripts/Sanity/CC/CC_Notes/.cursor/debug-ac8222.log&quot;,
    &quot;/Users/priyadharsini/Desktop/apache-jmeter-5.6.3/bin/jmeterscripts/Sanity/CC/CC_Notes/Logs/debug-ac8222.log&quot;,
    &quot;/Users/priyadharsini/Desktop/apache-jmeter-5.6.3/bin/jmeterscripts/Sanity/CC/CC_Notes/Logs/CCNotes-audit.log&quot;
]
def esc = { v -&gt; (v == null ? &quot;&quot; : v.toString()).replace(&apos;\\\\&apos;, &apos;\\\\\\\\&apos;).replace(&apos;&quot;&apos;, &apos;\\\\&quot;&apos;).replace(&apos;\n&apos;, &apos; &apos;).replace(&apos;\r&apos;, &apos;&apos;) }
def writeLog = { hyp, msg, dataMap -&gt;
    def dataParts = dataMap.collect { k, v -&gt; &quot;\&quot;${esc(k)}\&quot;:\&quot;${esc(v)}\&quot;&quot; }.join(&quot;,&quot;)
    def line = &quot;{\&quot;sessionId\&quot;:\&quot;ac8222\&quot;,\&quot;runId\&quot;:\&quot;post-fix\&quot;,\&quot;hypothesisId\&quot;:\&quot;${esc(hyp)}\&quot;,\&quot;location\&quot;:\&quot;CCNotes.jmx:GET /auth/login\&quot;,\&quot;message\&quot;:\&quot;${esc(msg)}\&quot;,\&quot;data\&quot;:{${dataParts}},\&quot;timestamp\&quot;:${System.currentTimeMillis()}}\n&quot;
    def auditLine = &quot;[DEBUG-ac8222] hyp=&quot; + hyp + &quot; msg=&quot; + msg + &quot; data=&quot; + dataMap.toString() + &quot;\n&quot;
    logPaths.each { p -&gt;
        try {
            def f = new File(p)
            f.parentFile?.mkdirs()
            if (p.endsWith(&quot;CCNotes-audit.log&quot;)) {
                f.append(auditLine, &quot;UTF-8&quot;)
            } else {
                f.append(line, &quot;UTF-8&quot;)
            }
        } catch (Exception e) {
            log.warn(&quot;DEBUG log write failed for &quot; + p + &quot;: &quot; + e.message)
        }
    }
    log.info(&quot;[DEBUG-ac8222] &quot; + hyp + &quot; &quot; + msg + &quot; &quot; + dataMap)
}

def finalUrl = prev.getURL()?.toString() ?: &quot;&quot;
def code = prev.getResponseCode() ?: &quot;&quot;
def reqHeaders = prev.getRequestHeaders() ?: &quot;&quot;
def respBody = prev.getResponseDataAsString() ?: &quot;&quot;
def cookieData = (prev.getCookies() ?: &quot;&quot;).toString()
def hasReferer = (reqHeaders =~ /(?im)^Referer:/).find()
def hopUrls = []
def hopCodes = []
try {
    def subs = prev.getSubResults()
    if (subs != null) {
        subs.each { s -&gt;
            hopUrls &lt;&lt; (s.getURL()?.toString() ?: &quot;&quot;)
            hopCodes &lt;&lt; (s.getResponseCode() ?: &quot;&quot;)
        }
    }
} catch (Exception ignore) {}
hopUrls &lt;&lt; finalUrl
hopCodes &lt;&lt; code
def cookieNames = []
cookieData.split(/;\s*/).each { part -&gt;
    def i = part.indexOf(&apos;=&apos;)
    if (i &gt; 0) { cookieNames &lt;&lt; part.substring(0, i).trim() }
}

writeLog(&quot;A&quot;, &quot;referer_check&quot;, [hasReferer: hasReferer, responseCode: code])
writeLog(&quot;B&quot;, &quot;redirect_chain&quot;, [hopCount: hopUrls.size(), hopUrls: hopUrls.take(6).join(&quot; | &quot;), hopCodes: hopCodes.take(6).join(&quot;,&quot;), finalUrl: finalUrl, hasAuthorize: hopUrls.any { it.contains(&quot;/o/authorize&quot;) }, landsOnEnterEmail: finalUrl.contains(&quot;/enter-email&quot;)])
writeLog(&quot;C&quot;, &quot;cookie_names&quot;, [cookieNames: cookieNames.unique().join(&quot;,&quot;), cookieCount: cookieNames.unique().size()])

// Hypothesis F: session cookies from /login hop (esp idam.request) must be stored
def setCookieNames = []
try {
    def collectSC = { sample -&gt;
        def rh = sample?.getResponseHeaders() ?: &quot;&quot;
        rh.eachLine { line -&gt;
            if (line.toLowerCase().startsWith(&quot;set-cookie:&quot;)) {
                def raw = line.substring(11).trim()
                def n = raw.tokenize(&quot;;&quot;)[0].tokenize(&quot;=&quot;)[0].trim()
                if (n) setCookieNames &lt;&lt; n
            }
        }
    }
    def subs = prev.getSubResults()
    if (subs != null) { subs.each { collectSC(it) } }
    collectSC(prev)
} catch (Exception ignore) {}
writeLog(&quot;F&quot;, &quot;set_cookie_names&quot;, [setCookieNames: setCookieNames.unique().join(&quot;,&quot;), hasIdamRequest: setCookieNames.any { it.equalsIgnoreCase(&quot;idam.request&quot;) }, hasIdamUI: setCookieNames.any { it.equalsIgnoreCase(&quot;Idam.UI&quot;) }])

writeLog(&quot;D&quot;, &quot;page_markers&quot;, [responseCode: code, hasEnterEmailText: respBody.contains(&quot;Enter your email address&quot;), hasCannotAccess: respBody.contains(&quot;cannot access HMCTS Access&quot;), csrfIsNotFound: ((vars.get(&quot;csrf&quot;) ?: &quot;&quot;) == &quot;NOT_FOUND&quot;)])
writeLog(&quot;E&quot;, &quot;policy_context&quot;, [samplerLabel: prev.getSampleLabel(), success: prev.isSuccessful()])
// #endregion
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
