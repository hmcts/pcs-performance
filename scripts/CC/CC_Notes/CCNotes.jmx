              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract OAuth from IDAM URL" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def url = prev.getURL()?.toString() ?: &quot;&quot;

def extractParam = { u, param -&gt;
    def m = (u =~ /[?&amp;]${param}=([^&amp;]+)/)
    return m.find() ? java.net.URLDecoder.decode(m.group(1), &quot;UTF-8&quot;) : null
}

def urlNonce = extractParam(url, &quot;nonce&quot;)
def urlState = extractParam(url, &quot;state&quot;)
def urlChallenge = extractParam(url, &quot;code_challenge&quot;)

if (urlNonce) { vars.put(&quot;nonce&quot;, urlNonce) }
if (urlState) { vars.put(&quot;state&quot;, urlState) }
if (urlChallenge) { vars.put(&quot;code_challenge&quot;, urlChallenge) }
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
