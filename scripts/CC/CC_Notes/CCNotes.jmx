            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate State, Nonce &amp; PKCE" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import java.util.Base64
import java.text.SimpleDateFormat

def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
def auditPath = new File(scriptHome, vars.get(&quot;auditLogPath&quot;) ?: &quot;Logs/CCNotes-audit.log&quot;).absolutePath
def auditFile = new File(auditPath)
def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
def threadName = ctx.getThread().getThreadName()

synchronized (org.apache.jmeter.JMeter.class) {
    if (!props.get(&quot;ccAuditLogStarted&quot;)) {
        props.put(&quot;ccAuditLogStarted&quot;, &quot;true&quot;)
        auditFile.append(&quot;=== CCNotes Audit Log | started &quot; + new Date() + &quot; ===\n\n&quot;)
    }
}

// Clean username
String username = vars.get(&quot;username&quot;)
if (!username) {
    username = vars.get(&quot;solicitor_username&quot;)
    if (username) { vars.put(&quot;username&quot;, username) }
}
if (username != null) {
    username = username.replace(&apos;\u00A0&apos;, &apos;&apos;).trim()
    vars.put(&quot;username&quot;, username)
}

def mapKey = &quot;cc_thread_user_&quot; + threadName
if (!props.get(mapKey) &amp;&amp; username) {
    def mapLine = &quot;[&quot; + ts + &quot;] [INFO] event=THREAD_USER | thread=&quot; + threadName + &quot; | user=&quot; + username
    auditFile.append(mapLine + &quot;\n&quot;)
    log.info(mapLine)
    props.put(mapKey, username)
}

if (username) {
    def loginLine = &quot;[&quot; + ts + &quot;] [INFO] event=ITERATION_LOGIN | thread=&quot; + threadName + &quot; | user=&quot; + username
    auditFile.append(loginLine + &quot;\n&quot;)
    log.info(loginLine)
    log.info(&quot;Username = [&quot; + username + &quot;] for &quot; + threadName)
}

// Decode password — OAuth state/nonce/challenge come from IDAM redirect URL
String encoded = vars.get(&quot;encodedPassword&quot;)
if (encoded != null) {
    String password = new String(
        Base64.getDecoder().decode(encoded),
        &quot;UTF-8&quot;
    )
    password = password.replace(&apos;\u00A0&apos;, &apos;&apos;).trim()
    vars.put(&quot;password&quot;, password)
    log.info(&quot;Password decoded successfully&quot;)
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Validate Login and Log Status" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">//=====================================================
// HMCTS Login Validation
//=====================================================

log.info(&quot;========== LOGIN VALIDATION START ==========&quot;)

//-----------------------------------------------------
// Validate Correlation Variables
//-----------------------------------------------------

def checks = [
    &quot;Username&quot;      : vars.get(&quot;username&quot;),
    &quot;CSRF Token&quot;    : vars.get(&quot;csrf&quot;),
    &quot;OAuth State&quot;   : vars.get(&quot;state&quot;),
    &quot;OAuth Nonce&quot;   : vars.get(&quot;nonce&quot;),
    &quot;PKCE Challenge&quot;: vars.get(&quot;code_challenge&quot;)
]

checks.each { key, value -&gt;

    if (value == null || value.trim().isEmpty()) {
        log.error(&quot;[FAIL] &quot; + key + &quot; : MISSING&quot;)
    } else {

        switch(key) {

            case &quot;Username&quot;:
                log.info(&quot;[PASS] Username loaded from CSV : &quot; + value)
                break

            case &quot;CSRF Token&quot;:
                log.info(&quot;[PASS] CSRF Token extracted successfully&quot;)
                break

            case &quot;OAuth State&quot;:
                log.info(&quot;[PASS] OAuth State extracted from IDAM redirect&quot;)
                break

            case &quot;OAuth Nonce&quot;:
                log.info(&quot;[PASS] OAuth Nonce extracted from IDAM redirect&quot;)
                break

            case &quot;PKCE Challenge&quot;:
                log.info(&quot;[PASS] PKCE Code Challenge extracted from IDAM redirect&quot;)
                break
        }
    }
}

//-----------------------------------------------------
// Validate Login Response
//-----------------------------------------------------

String responseCode = prev.getResponseCode()
String responseBody = prev.getResponseDataAsString().toLowerCase()

log.info(&quot;HTTP Response Code : &quot; + responseCode)

def finalUrl = prev.getURL()?.toString() ?: &quot;&quot;


if (responseCode == &quot;302&quot;) {

    log.info(&quot;[PASS] LOGIN SUCCESSFUL&quot;)
}
else if (responseCode == &quot;200&quot;) {

    if (responseBody.contains(&quot;sign in&quot;) ||
        responseBody.contains(&quot;&lt;title&gt;sign in&quot;) ||
        responseBody.contains(&quot;login-submit-btn&quot;) ||
        responseBody.contains(&quot;expired-login-link&quot;) ||
        finalUrl.contains(&quot;expired-login-link&quot;)) {

        log.error(&quot;[FAIL] LOGIN FAILED&quot;)
        log.error(&quot;Reason : Login page or expired login link returned by application.&quot;)
        log.error(&quot;Possible causes:&quot;)
        log.error(&quot;   • Invalid username or password&quot;)
        log.error(&quot;   • Invalid CSRF token&quot;)
        log.error(&quot;   • Missing or expired session cookie&quot;)
        log.error(&quot;   • Invalid State or Nonce&quot;)
        log.error(&quot;   • Invalid PKCE Code Challenge&quot;)
    }
    else {

        log.info(&quot;[PASS] Login completed successfully (HTTP 200).&quot;)
    }
}
else {

    log.error(&quot;[FAIL] Unexpected HTTP Response&quot;)
    log.error(&quot;HTTP Response Code : &quot; + responseCode)
}

log.info(&quot;========== LOGIN VALIDATION END ==========&quot;)

def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
def auditPath = new File(scriptHome, vars.get(&quot;auditLogPath&quot;) ?: &quot;Logs/CCNotes-audit.log&quot;).absolutePath
def ts = new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
def threadName = ctx.getThread().getThreadName()
def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
def loginOk = (responseCode == &quot;302&quot;) || (responseCode == &quot;200&quot; &amp;&amp; !(responseBody.contains(&quot;sign in&quot;) || responseBody.contains(&quot;login-submit-btn&quot;) || responseBody.contains(&quot;expired-login-link&quot;) || finalUrl.contains(&quot;expired-login-link&quot;)))
def loginLevel = loginOk ? &quot;PASS&quot; : &quot;FAIL&quot;
def loginDetail = loginOk ? &quot;login successful&quot; : (&quot;login failed HTTP=&quot; + responseCode)
def loginLine = &quot;[&quot; + ts + &quot;] [&quot; + loginLevel + &quot;] event=LOGIN | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=- | Linking_Case_ID=- | &quot; + loginDetail
new File(auditPath).append(loginLine + &quot;\n&quot;)
if (loginOk) {
    log.info(loginLine)
} else {
    def errorPath = props.get(&quot;__CC_ERROR_LOG_PATH__&quot;)
    if (errorPath) { new File(errorPath).append(loginLine + &quot;\n&quot;, &quot;UTF-8&quot;) }
    log.error(loginLine)
}

if ((username ?: &quot;&quot;).contains(&quot;PCS-CTSC-Admin&quot;)) {
    vars.put(&quot;admin_login_ok&quot;, loginOk ? &quot;true&quot; : &quot;false&quot;)
}

// Extract oauth code from redirect chain for GET /oauth2/callback step
def oauthCode = null
prev.getSubResults()?.each { sub -&gt;
    def u = sub.getURL()?.toString() ?: &quot;&quot;
    def m = (u =~ /[?&amp;]code=([^&amp;]+)/)
    if (m.find()) {
        oauthCode = java.net.URLDecoder.decode(m.group(1), &quot;UTF-8&quot;)
    }
}
if (oauthCode) {
    vars.put(&quot;oauth_code&quot;, oauthCode)
    log.info(&quot;[PASS] OAuth code captured for callback step&quot;)
} else {
    log.warn(&quot;[WARN] OAuth code not found in redirect chain; GET /oauth2/callback may fail&quot;)
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
