            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Base64

String encoded = vars.get(&quot;encodedPassword&quot;)
if (encoded != null) {
    String password = new String(Base64.getDecoder().decode(encoded), &quot;UTF-8&quot;)
    password = password.replace(&apos;\u00A0&apos;, &apos;&apos;).trim()
    vars.put(&quot;password&quot;, password)
}
</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="DEBUG Password Login Logger" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// #region agent log
def logPath = &quot;/Users/priyadharsini/Desktop/apache-jmeter-5.6.3/bin/jmeterscripts/Sanity/CC/CC_Notes/.cursor/debug-ac8222.log&quot;
def esc = { v -&gt; (v == null ? &quot;&quot; : v.toString()).replace(&apos;\\\\&apos;, &apos;\\\\\\\\&apos;).replace(&apos;&quot;&apos;, &apos;\\\\&quot;&apos;).replace(&apos;\n&apos;, &apos; &apos;) }
def csrf = vars.get(&quot;csrf&quot;) ?: &quot;&quot;
def pwd = vars.get(&quot;password&quot;) ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def line = &quot;{\&quot;sessionId\&quot;:\&quot;ac8222\&quot;,\&quot;runId\&quot;:\&quot;post-fix\&quot;,\&quot;hypothesisId\&quot;:\&quot;G\&quot;,\&quot;location\&quot;:\&quot;CCNotes.jmx:POST /enter-password\&quot;,\&quot;message\&quot;:\&quot;password_post\&quot;,\&quot;data\&quot;:{\&quot;responseCode\&quot;:\&quot;${esc(prev.getResponseCode())}\&quot;,\&quot;csrfLen\&quot;:\&quot;${csrf.length()}\&quot;,\&quot;csrfNotFound\&quot;:\&quot;${csrf == \&quot;NOT_FOUND\&quot;}\&quot;,\&quot;passwordLen\&quot;:\&quot;${pwd.length()}\&quot;,\&quot;hasPassword\&quot;:\&quot;${pwd.length() &gt; 0}\&quot;,\&quot;finalUrl\&quot;:\&quot;${esc(prev.getURL()?.toString())}\&quot;,\&quot;hasCannotAccess\&quot;:\&quot;${body.contains(\&quot;cannot access\&quot;)}\&quot;,\&quot;success\&quot;:\&quot;${prev.isSuccessful()}\&quot;},\&quot;timestamp\&quot;:${System.currentTimeMillis()}}\n&quot;
try { new File(logPath).append(line, &quot;UTF-8&quot;) } catch (Exception e) { log.warn(e.message) }
log.info(&quot;[DEBUG-ac8222] G password_post code=&quot; + prev.getResponseCode() + &quot; csrfLen=&quot; + csrf.length() + &quot; pwdLen=&quot; + pwd.length())
// #endregion
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="DEBUG c2c500 Password Logger" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// #region agent log
def logPath = &quot;/Users/priyadharsini/Desktop/Gatling/xui-performance/.cursor/debug-c2c500.log&quot;
def safe = { v -&gt; String.valueOf(v ?: &quot;&quot;).replace(&apos;&quot;&apos;, &quot;&apos;&quot;).replace(&apos;\n&apos;,&apos; &apos;).replace(&apos;\r&apos;,&apos;&apos;) }
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def line = &apos;{&quot;sessionId&quot;:&quot;c2c500&quot;,&quot;runId&quot;:&quot;ccnotes-fix&quot;,&quot;hypothesisId&quot;:&quot;A&quot;,&quot;location&quot;:&quot;CCNotes.jmx:NewLogin/enter-password&quot;,&quot;message&quot;:&quot;password_post&quot;,&quot;data&quot;:{&quot;responseCode&quot;:&quot;&apos; + safe(prev.getResponseCode()) + &apos;&quot;,&quot;finalUrl&quot;:&quot;&apos; + safe(prev.getURL()?.toString()) + &apos;&quot;,&quot;hasManageCases&quot;:&quot;&apos; + (body.contains(&quot;Manage cases&quot;) || body.contains(&quot;HMCTS Manage cases&quot;)) + &apos;&quot;,&quot;success&quot;:&quot;&apos; + prev.isSuccessful() + &apos;&quot;,&quot;user&quot;:&quot;&apos; + safe(vars.get(&quot;username&quot;)) + &apos;&quot;},&quot;timestamp&quot;:&apos; + System.currentTimeMillis() + &apos;}\n&apos;
try { def f=new File(logPath); f.parentFile?.mkdirs(); f.append(line,&apos;UTF-8&apos;) } catch (Exception e) { log.warn(e.message) }
log.info(&quot;[DEBUG-c2c500] password_post &quot; + prev.getResponseCode())
// #endregion
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
