try { def f=new File(logPath); f.parentFile?.mkdirs(); f.append(line,&apos;UTF-8&apos;) } catch (Exception e) { log.warn(e.message) }
log.info(&quot;[DEBUG-c2c500] password_post &quot; + prev.getResponseCode())
// #endregion
