            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract OAuth from IDAM URL" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def url = prev.getURL()?.toString() ?: &quot;&quot;

def extractParam = { u, param -&gt;
    def m = (u =~ /[?&amp;]${param}=([^&amp;]+)/)
    return m.find() ? java.net.URLDecoder.decode(m.group(1), &quot;UTF-8&quot;) : null
}

def urlNonce = extractParam(url, &quot;nonce&quot;)
def urlState = extractParam(url, &quot;state&quot;)
def urlChallenge = extractParam(url, &quot;code_challenge&quot;)

if (urlNonce) { vars.put(&quot;nonce&quot;, urlNonce) }
if (urlState) { vars.put(&quot;state&quot;, urlState) }
if (urlChallenge) { vars.put(&quot;code_challenge&quot;, urlChallenge) }
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="DEBUG Login Hop Logger" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// #region agent log
def logPath = &quot;/Users/priyadharsini/Desktop/Gatling/xui-performance/.cursor/debug-c2c500.log&quot;
def esc = { v -&gt; (v == null ? &quot;&quot; : v.toString()).replace(&apos;\\&apos;, &apos;\\\\&apos;).replace(&apos;&quot;&apos;, &apos;\\&quot;&apos;).replace(&apos;\n&apos;, &apos; &apos;).replace(&apos;\r&apos;, &apos;&apos;) }
def writeLog = { hyp, msg, dataMap -&gt;
    def dataParts = dataMap.collect { k, v -&gt; &quot;\&quot;${esc(k)}\&quot;:\&quot;${esc(v)}\&quot;&quot; }.join(&quot;,&quot;)
    def line = &quot;{\&quot;sessionId\&quot;:\&quot;c2c500\&quot;,\&quot;runId\&quot;:\&quot;pre-fix\&quot;,\&quot;hypothesisId\&quot;:\&quot;${esc(hyp)}\&quot;,\&quot;location\&quot;:\&quot;CreateCaseFlag.jmx:GET /auth/login\&quot;,\&quot;message\&quot;:\&quot;${esc(msg)}\&quot;,\&quot;data\&quot;:{${dataParts}},\&quot;timestamp\&quot;:${System.currentTimeMillis()}}\n&quot;
    try {
        def f = new File(logPath)
        f.parentFile?.mkdirs()
        f.append(line, &quot;UTF-8&quot;)
    } catch (Exception e) { log.warn(&quot;DEBUG log write failed: &quot; + e.message) }
    log.info(&quot;[DEBUG-c2c500] &quot; + hyp + &quot; &quot; + msg + &quot; &quot; + dataMap)
}
def finalUrl = prev.getURL()?.toString() ?: &quot;&quot;
def code = prev.getResponseCode() ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def csrf = vars.get(&quot;csrf&quot;) ?: &quot;&quot;
writeLog(&quot;A&quot;, &quot;auth_login_landed&quot;, [responseCode: code, finalUrl: finalUrl, landsOnEnterEmail: finalUrl.contains(&quot;/enter-email&quot;), hasEnterEmailText: body.contains(&quot;Enter your email address&quot;), csrfNotFound: (csrf == &quot;NOT_FOUND&quot;), csrfLen: csrf.length(), success: prev.isSuccessful()])
// #endregion
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
