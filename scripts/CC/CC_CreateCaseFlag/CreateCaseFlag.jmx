            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="DEBUG Enter Email Logger" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// #region agent log
def logPath = &quot;/Users/priyadharsini/Desktop/Gatling/xui-performance/.cursor/debug-c2c500.log&quot;
def esc = { v -&gt; (v == null ? &quot;&quot; : v.toString()).replace(&apos;\\&apos;, &apos;\\\\&apos;).replace(&apos;&quot;&apos;, &apos;\\&quot;&apos;).replace(&apos;\n&apos;, &apos; &apos;) }
def loc = prev.getResponseHeaders()?.readLines()?.find { it.toLowerCase().startsWith(&quot;location:&quot;) } ?: &quot;&quot;
def line = &quot;{\&quot;sessionId\&quot;:\&quot;c2c500\&quot;,\&quot;runId\&quot;:\&quot;pre-fix\&quot;,\&quot;hypothesisId\&quot;:\&quot;C\&quot;,\&quot;location\&quot;:\&quot;CreateCaseFlag.jmx:POST /enter-email\&quot;,\&quot;message\&quot;:\&quot;enter_email_post\&quot;,\&quot;data\&quot;:{\&quot;responseCode\&quot;:\&quot;${esc(prev.getResponseCode())}\&quot;,\&quot;location\&quot;:\&quot;${esc(loc)}\&quot;,\&quot;csrf\&quot;:\&quot;${esc((vars.get(\&quot;csrf\&quot;) ?: \&quot;\&quot;).take(8))}\&quot;,\&quot;success\&quot;:\&quot;${prev.isSuccessful()}\&quot;},\&quot;timestamp\&quot;:${System.currentTimeMillis()}}\n&quot;
try { new File(logPath).parentFile?.mkdirs(); new File(logPath).append(line, &quot;UTF-8&quot;) } catch (Exception e) { log.warn(e.message) }
log.info(&quot;[DEBUG-c2c500] C enter_email code=&quot; + prev.getResponseCode())
// #endregion
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
