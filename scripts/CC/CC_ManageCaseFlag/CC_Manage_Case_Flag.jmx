                <stringProp name="parameters"></stringProp>
                <stringProp name="script">vars.put(&quot;eventTriggerJson&quot;, prev.getResponseDataAsString() ?: &quot;&quot;)
def headers = prev.getResponseHeaders() ?: &quot;&quot;
def matcher = (headers =~ /(?i)Set-Cookie: XSRF-TOKEN=([^;\r\n]+)/)
def token = null
while (matcher.find()) { token = matcher.group(1) }
if (!token) { token = vars.get(&quot;xsrf_token&quot;) }
if (token) { vars.put(&quot;xsrf_token&quot;, token) }
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Handle CreateFlags Availability" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def code = prev.getResponseCode() ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;-&quot;
def hasLabel = body.contains(&quot;Create case flags&quot;)
def available = (code == &quot;200&quot; &amp;&amp; hasLabel)
vars.put(&quot;createFlagsAvailable&quot;, available ? &quot;true&quot; : &quot;false&quot;)
if (code == &quot;422&quot;) {
    prev.setSuccessful(true)
    prev.setResponseMessage(&quot;createFlags not available (HTTP 422) - continuing to amendFlags&quot;)
    vars.put(&quot;createFlagsSkipReason&quot;, &quot;HTTP_422_event_not_available&quot;)
} else if (!available) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;createFlags unexpected HTTP=&quot; + code)
    vars.put(&quot;createFlagsSkipReason&quot;, &quot;unexpected_http_&quot; + code)
} else {
    vars.put(&quot;createFlagsSkipReason&quot;, &quot;&quot;)
}
</stringProp>
