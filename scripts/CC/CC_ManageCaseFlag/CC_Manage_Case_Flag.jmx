        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Normalize Username And Case ID" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">// Normalize CSV row for journey + end CSV
def username = (vars.get(&quot;username&quot;) ?: &quot;&quot;).trim()
if (username &amp;&amp; !username.contains(&quot;@&quot;)) {
    username = username + &quot;@hmcts.net&quot;
}
vars.put(&quot;username&quot;, username)

def caseId = (vars.get(&quot;Case_ID&quot;) ?: vars.get(&quot;Caseid&quot;) ?: &quot;&quot;).trim()
vars.put(&quot;Case_ID&quot;, caseId)
vars.put(&quot;Caseid&quot;, caseId)
vars.put(&quot;cc_case_ready&quot;, caseId ? &quot;true&quot; : &quot;false&quot;)
vars.put(&quot;flagComment&quot;, (vars.get(&quot;flagComment&quot;) ?: &quot;&quot;).trim() ?: &quot;Testing&quot;)
vars.put(&quot;updatedFlagComment&quot;, (vars.get(&quot;updatedFlagComment&quot;) ?: &quot;&quot;).trim() ?: &quot;Updated&quot;)
vars.put(&quot;createFlagsAvailable&quot;, &quot;false&quot;)

def shared = (props.get(&quot;__CC_SHARED_CASE_ID__&quot;) ?: &quot;&quot;).toString().trim()
def sharedUser = (props.get(&quot;__CC_SHARED_USERNAME__&quot;) ?: &quot;&quot;).toString().trim()
if (shared) {
    vars.put(&quot;Case_ID&quot;, shared)
    vars.put(&quot;Caseid&quot;, shared)
    caseId = shared
}
if (sharedUser) { vars.put(&quot;username&quot;, sharedUser); username = sharedUser }


</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
