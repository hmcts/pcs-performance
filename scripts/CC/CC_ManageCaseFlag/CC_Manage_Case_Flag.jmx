            <hashTree/>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Build AmendFlags Event Body" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.text.SimpleDateFormat
import java.util.TimeZone

vars.put(&quot;amendFlagsBodyReady&quot;, &quot;false&quot;)
vars.put(&quot;amendFlagsSkipReason&quot;, &quot;&quot;)
vars.put(&quot;amendSubmitOk&quot;, &quot;false&quot;)

def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;-&quot;
def xsrfToken = vars.get(&quot;xsrf_token&quot;)
def eventToken = vars.get(&quot;amend_event_token&quot;)
def triggerJson = vars.get(&quot;amendEventTriggerJson&quot;)
def flagComment = vars.get(&quot;flagComment&quot;) ?: &quot;Testing&quot;
def updatedFlagComment = vars.get(&quot;updatedFlagComment&quot;) ?: &quot;Updated&quot;

if (!xsrfToken) {
    def reason = &quot;xsrf_token missing - cannot submit amendFlags event&quot;
    vars.put(&quot;amendFlagsSkipReason&quot;, reason)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(reason)
    return
}

if (!eventToken || !triggerJson) {
    def reason = &quot;amend_event_token or amendEventTriggerJson missing - run step 11 first&quot;
    vars.put(&quot;amendFlagsSkipReason&quot;, reason)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(reason)
    return
}

def trigger = new JsonSlurper().parseText(triggerJson)
def fieldMap = [:]
(trigger.case_fields ?: []).each { cf -&gt;
    if (cf?.id) { fieldMap[cf.id] = cf.value }
}

def cloneValue = { value -&gt; value == null ? null : new JsonSlurper().parseText(JsonOutput.toJson(value)) }
def parties = cloneValue(fieldMap.parties ?: [])
def allDefendants = cloneValue(fieldMap.allDefendants ?: [])
parties = (parties ?: []).sort { a, b -&gt;
    def aDef = a?.value?.containsKey(&quot;defendantFlags&quot;) ? 0 : 1
    def bDef = b?.value?.containsKey(&quot;defendantFlags&quot;) ? 0 : 1
    aDef &lt;=&gt; bDef
}

def existingCaseFlags = cloneValue(fieldMap.caseFlags ?: [:]) ?: [:]
def existingDetails = (existingCaseFlags.details ?: []).collect { cloneValue(it) }

def isCaseLevel = { detail -&gt;
    def paths = detail?.value?.path ?: []
    return paths.any { it?.value == &quot;Case&quot; }
}

def amended = false
existingDetails = (existingDetails ?: []).collect { d -&gt;
    try {
        if (d?.value?.flagCode == &quot;CF0002&quot; &amp;&amp; d?.value?.status == &quot;Active&quot; &amp;&amp; isCaseLevel(d)) {
            d.value.flagComment = updatedFlagComment
            d.value.flagUpdateComment = &quot;Updated flag comment from &quot; + flagComment
            def sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSS&apos;Z&apos;&quot;)
            sdf.setTimeZone(TimeZone.getTimeZone(&quot;UTC&quot;))
            d.value.dateTimeModified = sdf.format(new Date())
            amended = true
        }
    } catch (ignored) {}
    return d
}

if (!amended) {
    def reason = &quot;No active CF0002 case-level flag found to amend for case &quot; + caseId
    vars.put(&quot;amendFlagsSkipReason&quot;, reason)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(reason)
    return
}

existingCaseFlags.details = existingDetails

def payload = [
    data: [
        caseFlags: existingCaseFlags,
        parties: parties,
        allDefendants: allDefendants
    ],
    event: [id: &quot;amendFlags&quot;, summary: &quot;&quot;, description: &quot;&quot;],
    event_token: eventToken,
    ignore_warning: false
]

def body = JsonOutput.toJson(payload)
vars.put(&quot;amendFlagsEventBody&quot;, body)
vars.put(&quot;amendFlagsBodyReady&quot;, &quot;true&quot;)
vars.put(&quot;amendFlagsSkipReason&quot;, &quot;&quot;)
log.info(&quot;AmendFlags payload built | updatedFlagComment=&quot; + updatedFlagComment)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
