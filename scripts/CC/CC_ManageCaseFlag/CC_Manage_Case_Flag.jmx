                <stringProp name="script">import java.util.Base64

String value = vars.get(&quot;password&quot;)
if (value == null || value.trim().isEmpty()) {
    return
}
try {
    String decoded = new String(Base64.getDecoder().decode(value.trim()), &quot;UTF-8&quot;)
    decoded = decoded.replace(&apos;\u00A0&apos;, &apos;&apos;).trim()
    vars.put(&quot;password&quot;, decoded)
} catch (Exception ignored) {
    // already decoded in this thread
}</stringProp>
