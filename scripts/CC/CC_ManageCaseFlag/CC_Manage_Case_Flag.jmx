//vars.put(&quot;cc_case_ready&quot;, &quot;true&quot;)


import groovy.json.JsonSlurper
import java.text.SimpleDateFormat

def expectedCaseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).trim()
def username = vars.get(&quot;username&quot;) ?: &quot;-&quot;
vars.put(&quot;cc_case_ready&quot;, &quot;false&quot;)

def reason = &quot;unknown&quot;

if (!expectedCaseId) {
    reason = &quot;Case_ID_missing_from_CSV&quot;
    log.error(&quot;[FAIL] Case_ID missing from CSV&quot;)
} else {
    def threadName = ctx.getThread().getThreadName()
    def iterKey = &quot;__cc_iteration_&quot; + threadName
    def iteration = (props.get(iterKey) ?: &quot;0&quot;).toInteger() + 1
    props.put(iterKey, iteration.toString())
    vars.put(&quot;cc_iteration&quot;, iteration.toString())

    def responseBody = prev.getResponseDataAsString() ?: &quot;&quot;
    if (prev.getResponseCode() != &quot;200&quot; || !responseBody) {
        reason = &quot;search_http_fail_&quot; + prev.getResponseCode()
        log.error(&quot;[FAIL] Case search HTTP=&quot; + prev.getResponseCode() + &quot; Case_ID=&quot; + expectedCaseId)
    } else {
        def json = new JsonSlurper().parseText(responseBody)
        def foundId = (json?.case_id ?: &quot;&quot;).toString()
        if (foundId != expectedCaseId) {
            reason = &quot;case_id_mismatch_or_not_found&quot;
            log.error(&quot;[FAIL] Case_ID=&quot; + expectedCaseId + &quot; not returned by Case ID search (got=&quot; + foundId + &quot;)&quot;)
        } else {
            vars.put(&quot;cc_case_ready&quot;, &quot;true&quot;)
            reason = &quot;found_by_case_id&quot;
            log.info(&quot;[PASS] Case_ID=&quot; + expectedCaseId + &quot; found by Case ID search&quot;)
        }
    }
}

def scriptHome = props.get(&quot;SCRIPT_HOME&quot;)
if (!scriptHome) {
    scriptHome = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
    props.put(&quot;SCRIPT_HOME&quot;, scriptHome)
}
def out = new File(scriptHome, &quot;ManageCaseFlag_case-search-status_Output.csv&quot;)
if (!out.exists()) {
    out.write(&quot;timestamp,username,Case_ID,status,reason\n&quot;, &quot;UTF-8&quot;)
}
def status = &quot;true&quot;.equals(vars.get(&quot;cc_case_ready&quot;)) ? &quot;PASS&quot; : &quot;FAIL&quot;
def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;).format(new Date())
out.append(&quot;${ts},${username},${expectedCaseId},${status},${reason}\n&quot;, &quot;UTF-8&quot;)
log.info(&quot;[CASE_SEARCH] ${status} | user=${username} | Case_ID=${expectedCaseId} | ${reason}&quot;)</stringProp>
