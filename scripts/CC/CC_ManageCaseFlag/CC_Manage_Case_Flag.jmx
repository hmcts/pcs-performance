            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="CC_SC01_ManageCaseFlag_11_Start_AmendFlags">
              <stringProp name="HTTPSampler.path">/data/internal/cases/${Case_ID}/event-triggers/amendFlags?ignore-warning=false</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
