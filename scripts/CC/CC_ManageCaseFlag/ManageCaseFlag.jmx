            <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Complex Case flag refdata" enabled="true">
              <collectionProp name="Asserion.test_strings">
                <stringProp name="1984277221">CF0002</stringProp>
              </collectionProp>
              <stringProp name="Assertion.custom_message">CC_SC01_ManageCaseFlag_07_Get_Flag_RefData failed: Complex Case flag CF0002 not found</stringProp>
              <stringProp name="Assertion.test_field">Assertion.response_data</stringProp>
