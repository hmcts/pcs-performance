            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Extract OAuth from IDAM URL" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def url = prev.getURL()?.toString() ?: &quot;&quot;

def extractParam = { u, param -&gt;
    def m = (u =~ /[?&amp;]${param}=([^&amp;]+)/)
    return m.find() ? java.net.URLDecoder.decode(m.group(1), &quot;UTF-8&quot;) : null
}

def urlNonce = extractParam(url, &quot;nonce&quot;)
def urlState = extractParam(url, &quot;state&quot;)
def urlChallenge = extractParam(url, &quot;code_challenge&quot;)

if (urlNonce) { vars.put(&quot;nonce&quot;, urlNonce) }
if (urlState) { vars.put(&quot;state&quot;, urlState) }
if (urlChallenge) { vars.put(&quot;code_challenge&quot;, urlChallenge) }
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
            <hashTree/>
            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="DEBUG Login Hop Logger" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// #region agent log
def logPath = &quot;/Users/priyadharsini/Desktop/Gatling/xui-performance/.cursor/debug-c2c500.log&quot;
def safe = { v -&gt; String.valueOf(v ?: &quot;&quot;).replace(&apos;&quot;&apos;, &quot;&apos;&quot;).replace(&apos;\n&apos;,&apos; &apos;).replace(&apos;\r&apos;,&apos;&apos;) }
def writeLog = { hyp, msg, dataMap -&gt;
  def dataParts = dataMap.collect { k, v -&gt; &apos;&quot;&apos; + safe(k) + &apos;&quot;:&quot;&apos; + safe(v) + &apos;&quot;&apos; }.join(&apos;,&apos;)
  def line = &apos;{&quot;sessionId&quot;:&quot;c2c500&quot;,&quot;runId&quot;:&quot;post-fix&quot;,&quot;hypothesisId&quot;:&quot;&apos; + safe(hyp) + &apos;&quot;,&quot;location&quot;:&quot;LOGIN_AUTH&quot;,&quot;message&quot;:&quot;&apos; + safe(msg) + &apos;&quot;,&quot;data&quot;:{&apos; + dataParts + &apos;},&quot;timestamp&quot;:&apos; + System.currentTimeMillis() + &apos;}\n&apos;
  try { def f = new File(logPath); f.parentFile?.mkdirs(); f.append(line, &apos;UTF-8&apos;) } catch (Exception e) { log.warn(e.message) }
  log.info(&apos;[DEBUG-c2c500] &apos; + hyp + &apos; &apos; + msg + &apos; &apos; + dataMap)
}
def finalUrl = prev.getURL()?.toString() ?: &apos;&apos;
def code = prev.getResponseCode() ?: &apos;&apos;
def body = prev.getResponseDataAsString() ?: &apos;&apos;
def csrf = vars.get(&apos;csrf&apos;) ?: &apos;&apos;
writeLog(&apos;A&apos;, &apos;auth_login_landed&apos;, [responseCode: code, finalUrl: finalUrl, landsOnEnterEmail: finalUrl.contains(&apos;/enter-email&apos;), hasEnterEmailText: body.contains(&apos;Enter your email address&apos;), csrfNotFound: (csrf == &apos;NOT_FOUND&apos;), csrfLen: csrf.length(), success: prev.isSuccessful()])
// #endregion
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
