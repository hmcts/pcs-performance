              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Verify Amend And Write CSV" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import java.text.SimpleDateFormat

def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;-&quot;
def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
def updatedFlagComment = vars.get(&quot;updatedFlagComment&quot;) ?: &quot;Updated&quot;
def flagComment = vars.get(&quot;flagComment&quot;) ?: &quot;Testing&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def flagFound = body.contains(&quot;CF0002&quot;) &amp;&amp; body.contains(&quot;Complex Case&quot;) &amp;&amp; body.contains(updatedFlagComment)
def ok = prev.isSuccessful() &amp;&amp; flagFound
if (!ok) {
    prev.setSuccessful(false)
}

def threadName = ctx.getThread().getThreadName()
def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
def rowKey = &quot;cc_csv_row_&quot; + threadName + &quot;_&quot; + iteration
if (props.get(rowKey)) {
    return
}
props.put(rowKey, &quot;true&quot;)

def scriptHome = props.get(&quot;SCRIPT_HOME&quot;)
if (!scriptHome) {
    scriptHome = new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
    props.put(&quot;SCRIPT_HOME&quot;, scriptHome)
}
def csvPath = props.get(&quot;__CC_RUN_RESULTS_CSV_PATH__&quot;)
if (!csvPath) {
    def logsRoot = new File(scriptHome, vars.get(&quot;logsDir&quot;) ?: &quot;Logs&quot;)
    logsRoot.mkdirs()
    def tsName = new SimpleDateFormat(&quot;yyyy-MM-dd_HH-mm-ss&quot;).format(new Date())
    def csvFile = new File(logsRoot, &quot;ManageCaseFlag-run-results-&quot; + tsName + &quot;.csv&quot;)
    csvFile.write(&quot;timestamp,username,Case_ID,flagComment,updatedFlagComment,status\n&quot;, &quot;UTF-8&quot;)
    csvPath = csvFile.absolutePath
    props.put(&quot;__CC_RUN_RESULTS_CSV_PATH__&quot;, csvPath)
}

def esc = { v -&gt;
    def s = (v ?: &quot;&quot;).toString()
    if (s.contains(&quot;,&quot;) || s.contains(&quot;\&quot;&quot;) || s.contains(&quot;\n&quot;)) {
        return &quot;\&quot;&quot; + s.replace(&quot;\&quot;&quot;, &quot;\&quot;\&quot;&quot;) + &quot;\&quot;&quot;
    }
    return s
}
def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
def status = ok ? &quot;PASS&quot; : &quot;FAIL&quot;
def line = [ts, username, caseId, flagComment, updatedFlagComment, status].collect(esc).join(&quot;,&quot;)
new File(csvPath).append(line + &quot;\n&quot;, &quot;UTF-8&quot;)
log.info(&quot;[CSV] &quot; + status + &quot; | login=&quot; + username + &quot; | Case_ID=&quot; + caseId)
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
