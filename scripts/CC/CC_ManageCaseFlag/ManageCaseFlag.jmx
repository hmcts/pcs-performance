          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Build CreateFlags Event Body" enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import java.text.SimpleDateFormat
import java.util.TimeZone

vars.put(&quot;createFlagsBodyReady&quot;, &quot;false&quot;)
vars.put(&quot;createFlagsSkipReason&quot;, &quot;&quot;)
vars.put(&quot;flagSubmitOk&quot;, &quot;false&quot;)

def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;-&quot;
def xsrfToken = vars.get(&quot;xsrf_token&quot;)
def eventToken = vars.get(&quot;event_token&quot;)
def triggerJson = vars.get(&quot;eventTriggerJson&quot;)
if (!xsrfToken) {
    def reason = &quot;xsrf_token missing - cannot submit createFlags event&quot;
    vars.put(&quot;createFlagsSkipReason&quot;, reason)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(reason)
    return
}

if (!eventToken || !triggerJson) {
    def reason = &quot;event_token or eventTriggerJson missing - run step 06 first&quot;
    vars.put(&quot;createFlagsSkipReason&quot;, reason)
    SampleResult.setSuccessful(false)
    SampleResult.setResponseMessage(reason)
    return
}

def flagComment = vars.get(&quot;flagComment&quot;) ?: &quot;Testing&quot;
def trigger = new JsonSlurper().parseText(triggerJson)
def fieldMap = [:]
(trigger.case_fields ?: []).each { cf -&gt;
    if (cf?.id) { fieldMap[cf.id] = cf.value }
}

def cloneValue = { value -&gt; value == null ? null : new JsonSlurper().parseText(JsonOutput.toJson(value)) }
def parties = cloneValue(fieldMap.parties ?: [])
def allDefendants = cloneValue(fieldMap.allDefendants ?: [])
parties = (parties ?: []).sort { a, b -&gt;
    def aDef = a?.value?.containsKey(&quot;defendantFlags&quot;) ? 0 : 1
    def bDef = b?.value?.containsKey(&quot;defendantFlags&quot;) ? 0 : 1
    aDef &lt;=&gt; bDef
}

def existingCaseFlags = cloneValue(fieldMap.caseFlags ?: [:]) ?: [:]
def existingDetails = (existingCaseFlags.details ?: []).collect { cloneValue(it) }
def hasActiveCf0002 = existingDetails.any { it?.value?.flagCode == &quot;CF0002&quot; &amp;&amp; it?.value?.status == &quot;Active&quot; }
if (hasActiveCf0002) {
    def reason = &quot;Case &quot; + caseId + &quot; already has active CF0002 Complex Case flag - updating flagComment and submitting createFlags&quot;
    vars.put(&quot;createFlagsSkipReason&quot;, reason)
    log.info(reason)
}

def sdf = new SimpleDateFormat(&quot;yyyy-MM-dd&apos;T&apos;HH:mm:ss.SSS&apos;Z&apos;&quot;)
sdf.setTimeZone(TimeZone.getTimeZone(&quot;UTC&quot;))
def now = sdf.format(new Date())

// If an active CF0002 already exists, update its flagComment in the payload.
if (hasActiveCf0002) {
    existingDetails = (existingDetails ?: []).collect { d -&gt;
        try {
            if (d?.value?.flagCode == &quot;CF0002&quot; &amp;&amp; d?.value?.status == &quot;Active&quot;) {
                d.value.flagComment = flagComment
                d.value.dateTimeCreated = now
            }
        } catch (ignored) {}
        return d
    }
}

def flagDetail = [
    value: [
        name: &quot;Complex Case&quot;,
        name_cy: &quot;Achos Cymhleth&quot;,
        subTypeValue: null,
        subTypeValue_cy: null,
        subTypeKey: null,
        otherDescription: null,
        otherDescription_cy: null,
        flagComment: flagComment,
        flagComment_cy: null,
        dateTimeCreated: now,
        path: [[id: null, value: &quot;Case&quot;]],
        hearingRelevant: &quot;Yes&quot;,
        flagCode: &quot;CF0002&quot;,
        status: &quot;Active&quot;,
        availableExternally: &quot;No&quot;
    ]
]

def caseFlagsPayload = existingCaseFlags ?: [:]
caseFlagsPayload.details = hasActiveCf0002 ? existingDetails : (existingDetails + [flagDetail])

def payload = [
    data: [
        caseFlags: caseFlagsPayload,
        parties: parties,
        allDefendants: allDefendants
    ],
    event: [id: &quot;createFlags&quot;, summary: &quot;&quot;, description: &quot;&quot;],
    event_token: eventToken,
    ignore_warning: false
]

def body = JsonOutput.toJson(payload)
vars.put(&quot;createFlagsEventBody&quot;, body)
vars.put(&quot;createFlagsBodyReady&quot;, &quot;true&quot;)
vars.put(&quot;createFlagsSkipReason&quot;, &quot;&quot;)
log.info(&quot;CreateFlags payload built | parties=&quot; + (parties?.size() ?: 0) + &quot; | allDefendants=&quot; + (allDefendants?.size() ?: 0))

