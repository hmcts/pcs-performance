              <stringProp name="script">// #region agent log
def logPath = &quot;/Users/priyadharsini/Desktop/Gatling/xui-performance/.cursor/debug-c2c500.log&quot;
def safe = { v -&gt; String.valueOf(v ?: &quot;&quot;).replace(&apos;&quot;&apos;, &quot;&apos;&quot;).replace(&apos;\n&apos;,&apos; &apos;).replace(&apos;\r&apos;,&apos;&apos;) }
def csrf = vars.get(&apos;csrf&apos;) ?: &apos;&apos;
def body = prev.getResponseDataAsString() ?: &apos;&apos;
def line = &apos;{&quot;sessionId&quot;:&quot;c2c500&quot;,&quot;runId&quot;:&quot;post-fix&quot;,&quot;hypothesisId&quot;:&quot;B&quot;,&quot;location&quot;:&quot;LOGIN_PWD&quot;,&quot;message&quot;:&quot;password_post&quot;,&quot;data&quot;:{&quot;responseCode&quot;:&quot;&apos; + safe(prev.getResponseCode()) + &apos;&quot;,&quot;finalUrl&quot;:&quot;&apos; + safe(prev.getURL()?.toString()) + &apos;&quot;,&quot;csrfNotFound&quot;:&quot;&apos; + (csrf == &apos;NOT_FOUND&apos;) + &apos;&quot;,&quot;hasManageCases&quot;:&quot;&apos; + (body.contains(&apos;Manage cases&apos;) || body.contains(&apos;HMCTS Manage cases&apos;)) + &apos;&quot;,&quot;hasCannotAccess&quot;:&quot;&apos; + body.contains(&apos;cannot access&apos;) + &apos;&quot;,&quot;success&quot;:&quot;&apos; + prev.isSuccessful() + &apos;&quot;},&quot;timestamp&quot;:&apos; + System.currentTimeMillis() + &apos;}\n&apos;
try { def f = new File(logPath); f.parentFile?.mkdirs(); f.append(line, &apos;UTF-8&apos;) } catch (Exception e) { log.warn(e.message) }
log.info(&apos;[DEBUG-c2c500] B password_post code=&apos; + prev.getResponseCode())
// #endregion
</stringProp>
