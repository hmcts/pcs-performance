            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="DEBUG Enter Email Logger" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// #region agent log
def logPath = &quot;/Users/priyadharsini/Desktop/Gatling/xui-performance/.cursor/debug-c2c500.log&quot;
def safe = { v -&gt; String.valueOf(v ?: &quot;&quot;).replace(&apos;&quot;&apos;, &quot;&apos;&quot;).replace(&apos;\n&apos;,&apos; &apos;).replace(&apos;\r&apos;,&apos;&apos;) }
def loc = &apos;&apos;
try {
  def headers = prev.getResponseHeaders() ?: &apos;&apos;
  headers.eachLine { line -&gt;
    if (line.toLowerCase().startsWith(&apos;location:&apos;)) { loc = line.substring(9).trim() }
  }
} catch (Exception ignore) {}
def line = &apos;{&quot;sessionId&quot;:&quot;c2c500&quot;,&quot;runId&quot;:&quot;post-fix&quot;,&quot;hypothesisId&quot;:&quot;C&quot;,&quot;location&quot;:&quot;LOGIN_EMAIL&quot;,&quot;message&quot;:&quot;enter_email_post&quot;,&quot;data&quot;:{&quot;responseCode&quot;:&quot;&apos; + safe(prev.getResponseCode()) + &apos;&quot;,&quot;location&quot;:&quot;&apos; + safe(loc) + &apos;&quot;,&quot;csrfNotFound&quot;:&quot;&apos; + ((vars.get(&apos;csrf&apos;) ?: &apos;&apos;) == &apos;NOT_FOUND&apos;) + &apos;&quot;,&quot;success&quot;:&quot;&apos; + prev.isSuccessful() + &apos;&quot;},&quot;timestamp&quot;:&apos; + System.currentTimeMillis() + &apos;}\n&apos;
try { def f = new File(logPath); f.parentFile?.mkdirs(); f.append(line, &apos;UTF-8&apos;) } catch (Exception e) { log.warn(e.message) }
log.info(&apos;[DEBUG-c2c500] C enter_email code=&apos; + prev.getResponseCode())
// #endregion
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
