        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Normalize Username And Case ID" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import org.apache.jmeter.services.FileServer

def csvPath = &quot;/Users/priyadharsini/Desktop/untitled folder/input files\\/Case_ID_Link.csv&quot;
def csvFile = new File(csvPath)
if (!csvFile.exists()) {
  def alt = new File(FileServer.getFileServer().getBaseDir(), &quot;Case_ID_Link.csv&quot;)
  if (alt.exists()) { csvFile = alt }
}
vars.put(&quot;caseLinkCsvPath&quot;, csvFile.absolutePath)

def emails = []
if (csvFile.exists()) {
  csvFile.eachLine { line, num -&gt;
    if (num == 1) return
    def email = line.split(&quot;,&quot;, -1)[0].trim()
    if (email &amp;&amp; !emails.any { it.equalsIgnoreCase(email) }) {
      emails &lt;&lt; email
    }
  }
}

def threadNum = ctx.getThreadNum()
def username = vars.get(&quot;username&quot;) ?: &quot;&quot;
if (emails) {
  username = emails[threadNum % emails.size()]
}
vars.put(&quot;username&quot;, username)

def toCcdId = { raw -&gt; (raw ?: &quot;&quot;).toString().trim().replaceAll(&quot;[^0-9]&quot;, &quot;&quot;) }
def case1 = toCcdId(vars.get(&quot;Case_Number1&quot;) ?: vars.get(&quot;Case number1&quot;))
def case2 = toCcdId(vars.get(&quot;Case_Number2&quot;) ?: vars.get(&quot;Case number2&quot;))
if (case1) { vars.put(&quot;Case_ID&quot;, case1) }
if (case2) { vars.put(&quot;Linking_Case_ID&quot;, case2) }

log.info(&quot;[CCCaseLink] Thread=&quot; + Thread.currentThread().getName() + &quot; Username=&quot; + username + &quot; csv=&quot; + csvFile.absolutePath)
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
