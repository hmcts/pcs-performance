                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def linkingId = vars.get(&quot;Linking_Case_ID&quot;)
def created = vars.get(&quot;linkingCaseCreatedDate&quot;) ?: &quot;2026-05-14T17:36:41.445&quot;
def caseType = vars.get(&quot;linkingCaseType&quot;) ?: &quot;PCS&quot;
