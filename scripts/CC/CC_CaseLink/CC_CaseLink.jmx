              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="06 Log Link Submit Result" enabled="false">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import java.text.SimpleDateFormat

def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
def auditPath = new File(scriptHome, vars.get(&quot;auditLogPath&quot;) ?: &quot;CCCaseLink_audit.log&quot;).absolutePath
def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
def threadName = ctx.getThread().getThreadName()
def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;-&quot;
def linkingId = vars.get(&quot;Linking_Case_ID&quot;) ?: &quot;-&quot;
def code = prev.getResponseCode() ?: &quot;unknown&quot;
def ok = prev.isSuccessful()
def level = ok ? &quot;PASS&quot; : &quot;FAIL&quot;
def detail = ok ? (&quot;case link submitted HTTP=&quot; + code) : (&quot;link submit failed HTTP=&quot; + code + &quot; msg=&quot; + prev.getResponseMessage())
def line = &quot;[&quot; + ts + &quot;] [&quot; + level + &quot;] event=LINK_SUBMIT | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=&quot; + caseId + &quot; | Linking_Case_ID=&quot; + linkingId + &quot; | &quot; + detail
new File(auditPath).append(line + &quot;\n&quot;)
if (ok) {
  log.info(line)
} else {
  def errorPath = props.get(&quot;__CC_ERROR_LOG_PATH__&quot;)
  if (errorPath) { new File(errorPath).append(line + &quot;\n&quot;, &quot;UTF-8&quot;) }
  log.error(line)
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
