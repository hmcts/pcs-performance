              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="CC_SC01_CaseLink_Force_Case_Issued_Page" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import org.apache.jmeter.services.FileServer

def csvPath = vars.get(&quot;caseLinkCsvPath&quot;) ?: &quot;/Users/priyadharsini/Desktop/untitled folder/input files\\/Case_ID_Link.csv&quot;
def csvFile = new File(csvPath)
if (!csvFile.exists()) {
  def alt = new File(FileServer.getFileServer().getBaseDir(), &quot;Case_ID_Link.csv&quot;)
  if (alt.exists()) { csvFile = alt; csvPath = alt.absolutePath }
}

def QUEUE_KEY = &quot;__CC_CSV_UNIQUE_PAIRS__&quot;
def INDEX_KEY = &quot;__CC_CSV_PAIR_NEXT__&quot;

synchronized (org.apache.jmeter.JMeter.class) {
  if (!props.containsKey(QUEUE_KEY)) {
    def pairs = []
    def seen = new LinkedHashSet()
    if (csvFile.exists()) {
      csvFile.eachLine { line, num -&gt;
        if (num == 1) return
        def parts = line.split(&quot;,&quot;, -1)
        if (parts.length &lt; 3) return
        def c1 = parts[1].trim().replaceAll(&quot;[^0-9]&quot;, &quot;&quot;)
        def c2 = parts[2].trim().replaceAll(&quot;[^0-9]&quot;, &quot;&quot;)
        if (!c1 || !c2 || c1 == c2) return
        def pk = (c1 &lt;= c2) ? (c1 + &quot;|&quot; + c2) : (c2 + &quot;|&quot; + c1)
        if (seen.add(pk)) {
          pairs &lt;&lt; [caseId: c1, linkingId: c2, pairKey: pk]
        }
      }
    }
    props.put(QUEUE_KEY, pairs)
    props.put(INDEX_KEY, &quot;0&quot;)
    log.info(&quot;[CCCaseLink] Loaded &quot; + pairs.size() + &quot; unique Case number1/Case number2 pairs from &quot; + csvPath)
  }
}

def pairs = props.get(QUEUE_KEY)
def idx
synchronized (org.apache.jmeter.JMeter.class) {
  idx = (props.get(INDEX_KEY) ?: &quot;0&quot;) as int
  props.put(INDEX_KEY, (idx + 1).toString())
}

vars.put(&quot;cc_pair_ready&quot;, &quot;false&quot;)
if (!pairs || idx &gt;= pairs.size()) {
  log.error(&quot;[CCCaseLink] No unused CSV pair left idx=&quot; + idx + &quot; size=&quot; + (pairs ? pairs.size() : 0))
  return
}

def row = pairs[idx]
vars.put(&quot;Case_ID&quot;, row.caseId)
vars.put(&quot;Linking_Case_ID&quot;, row.linkingId)
vars.put(&quot;cc_pair_ready&quot;, &quot;true&quot;)
vars.put(&quot;cc_iteration&quot;, (idx + 1).toString())
vars.put(&quot;workbasketPage&quot;, &quot;1&quot;)

def path = &quot;/data/internal/searchCases?ctid=PCS&amp;use_case=WORKBASKET&amp;view=WORKBASKET&amp;state=CASE_ISSUED&amp;page=1&quot;
sampler.setPath(path)
sampler.setProperty(&quot;HTTPSampler.path&quot;, path)
log.info(&quot;[CCCaseLink] CSV pair Case_ID=&quot; + row.caseId + &quot; Linking_Case_ID=&quot; + row.linkingId + &quot; user=&quot; + (vars.get(&quot;username&quot;) ?: &quot;&quot;))
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
