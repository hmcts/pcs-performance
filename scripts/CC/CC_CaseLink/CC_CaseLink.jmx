              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Select Case And Linking Case From List" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import java.text.SimpleDateFormat
import org.apache.jmeter.services.FileServer

def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(FileServer.getFileServer().getBaseDir()).getAbsolutePath()
def auditPath = new File(scriptHome, vars.get(&quot;auditLogPath&quot;) ?: &quot;CCCaseLink_audit.log&quot;).absolutePath
def auditFile = new File(auditPath)
def threadName = ctx.getThread().getThreadName()
def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
def caseId = (vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;).replaceAll(&quot;[^0-9]&quot;, &quot;&quot;)
def linkingId = (vars.get(&quot;Linking_Case_ID&quot;) ?: &quot;&quot;).replaceAll(&quot;[^0-9]&quot;, &quot;&quot;)
vars.put(&quot;Case_ID&quot;, caseId)
vars.put(&quot;Linking_Case_ID&quot;, linkingId)

def writeAudit = { level, event, extra -&gt;
    def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
    def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
    def line = &quot;[&quot; + ts + &quot;] [&quot; + level + &quot;] event=&quot; + event + &quot; | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=&quot; + (vars.get(&quot;Case_ID&quot;) ?: &quot;-&quot;) + &quot; | Linking_Case_ID=&quot; + (vars.get(&quot;Linking_Case_ID&quot;) ?: &quot;-&quot;) + &quot; | &quot; + extra
    auditFile.append(line + &quot;\n&quot;)
    if (level == &quot;FAIL&quot;) { log.error(line) } else { log.info(line) }
}

if (!caseId || !linkingId || caseId == linkingId) {
    vars.put(&quot;cc_pair_ready&quot;, &quot;false&quot;)
    writeAudit(&quot;FAIL&quot;, &quot;PAIR_SELECTION&quot;, &quot;CSV Case number1/Case number2 missing or invalid&quot;)
    return
}

vars.put(&quot;cc_pair_ready&quot;, &quot;true&quot;)
writeAudit(&quot;PASS&quot;, &quot;PAIR_SELECTED&quot;, &quot;source=Case_ID_Link.csv Case number1 linked to Case number2&quot;)
</stringProp>
