            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="09 Validate Linking Case ID" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def linkingId = vars.get(&quot;Linking_Case_ID&quot;)?.trim()
def valid = linkingId &amp;&amp; !(linkingId.contains(&apos;${&apos;)) &amp;&amp; linkingId ==~ /\\d+/

if (!valid) {
log.error(&quot;[FAIL] 09_Open_Linked_Case: Linking_Case_ID is missing or invalid: [&quot; + linkingId + &quot;]&quot;)
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.ui-case-view.v2+json</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Content-Type</stringProp>
                    <stringProp name="Header.value">application/json</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">experimental</stringProp>
                    <stringProp name="Header.value">true</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="09 Log HTTP Result" enabled="false">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import java.text.SimpleDateFormat

def code = prev.getResponseCode() ?: &apos;unknown&apos;
def bytes = prev.getBytes() ?: 0
def linkingId = vars.get(&quot;Linking_Case_ID&quot;)
def caseId = vars.get(&quot;Case_ID&quot;)
def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
def threadName = ctx.getThread().getThreadName()
def ok = prev.isSuccessful()
def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
def auditPath = new File(scriptHome, vars.get(&quot;auditLogPath&quot;) ?: &quot;CCCaseLink_audit.log&quot;).absolutePath
def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
def completeKey = &quot;cc_run_complete_&quot; + threadName + &quot;_&quot; + iteration

if (ok &amp;&amp; !props.get(completeKey)) {
props.put(completeKey, &quot;true&quot;)
def auditLine = &quot;[&quot; + ts + &quot;] [PASS] event=RUN_COMPLETE | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=&quot; + caseId + &quot; | Linking_Case_ID=&quot; + linkingId + &quot; | full flow completed HTTP=&quot; + code
new File(auditPath).append(auditLine + &quot;\n&quot;)
log.info(auditLine)
} else if (!ok) {
def auditLine = &quot;[&quot; + ts + &quot;] [FAIL] event=RUN_FAIL | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=&quot; + caseId + &quot; | Linking_Case_ID=&quot; + linkingId + &quot; | 09_Open_Linked_Case failed HTTP=&quot; + code
new File(auditPath).append(auditLine + &quot;\n&quot;)
def errorPath = props.get(&quot;__CC_ERROR_LOG_PATH__&quot;)
if (errorPath) { new File(errorPath).append(auditLine + &quot;\n&quot;, &quot;UTF-8&quot;) }
log.error(auditLine)
}

log.info(&quot;[VERIFY] 09_Open_Linked_Case -&gt; HTTP &quot; + code + &quot; | bodyBytes=&quot; + bytes + &quot; | Linking_Case_ID=&quot; + linkingId + &quot; (bodyBytes is response SIZE, not an error code)&quot;)
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
