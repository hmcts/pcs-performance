      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="CC Run Results CSV Logger" enabled="true">
        <stringProp name="cacheKey">false</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">import java.text.SimpleDateFormat

def result = sampleEvent.getResult()
def label = result.getSampleLabel() ?: &quot;&quot;
if (label != &quot;09_Open_Linked_Case&quot;) {
    return
}

def threadName = result.getThreadName() ?: &quot;unknown&quot;
def username = vars.get(&quot;username&quot;) ?: &quot;&quot;
def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;&quot;
def linkingId = vars.get(&quot;Linking_Case_ID&quot;) ?: &quot;&quot;
def ok = result.isSuccessful()
def code = result.getResponseCode() ?: &quot;&quot;

def rowKey = &quot;cc_csv_row_&quot; + threadName + &quot;_&quot; + iteration
if (props.get(rowKey)) {
    return
}
props.put(rowKey, &quot;true&quot;)

def csvPath = props.get(&quot;__CC_RUN_RESULTS_CSV_PATH__&quot;)
if (!csvPath) {
    log.warn(&quot;[CSV] Results file path not initialized; skipping row for thread=&quot; + threadName)
    return
}

def esc = { v -&gt;
    def s = (v ?: &quot;&quot;).toString()
    if (s.contains(&quot;,&quot;) || s.contains(&quot;\&quot;&quot;) || s.contains(&quot;\n&quot;)) {
        return &quot;\&quot;&quot; + s.replace(&quot;\&quot;&quot;, &quot;\&quot;\&quot;&quot;) + &quot;\&quot;&quot;
    }
    return s
}

def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
def status = ok ? &quot;PASS&quot; : &quot;FAIL&quot;
def line = [ts, threadName, username, iteration, caseId, linkingId, status, code].collect(esc).join(&quot;,&quot;)

new File(csvPath).append(line + &quot;\n&quot;, &quot;UTF-8&quot;)
log.info(&quot;[CSV] &quot; + status + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=&quot; + caseId + &quot; | Linking_Case_ID=&quot; + linkingId + &quot; | file=&quot; + props.get(&quot;__CC_RUN_RESULTS_CSV_NAME__&quot;))
</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223Listener>
      <hashTree/>
      <JSR223Listener guiclass="TestBeanGUI" testclass="JSR223Listener" testname="API Call Trace Logger" enabled="true">
        <stringProp name="cacheKey">false</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="script">import java.text.SimpleDateFormat

def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
def logPath = new File(scriptHome, vars.get(&quot;apiLogPath&quot;) ?: &quot;Logs/CCCaseLink-run.log&quot;).absolutePath
def logFile = new File(logPath).getAbsoluteFile()
if (logFile.parentFile &amp;&amp; !logFile.parentFile.exists()) {
    logFile.parentFile.mkdirs()
}

if (!props.get(&quot;ccCaseLinkApiLogStarted&quot;)) {
    props.put(&quot;ccCaseLinkApiLogStarted&quot;, &quot;true&quot;)
    logFile.append(&quot;=== CCCaseLink API Trace | started &quot; + new Date() + &quot; ===\n\n&quot;)
}

def result = sampleEvent.getResult()
def label = result.getSampleLabel() ?: &quot;unknown&quot;
def url = result.getURL()?.toString() ?: &quot;&quot;

if (!url || label == &quot;Debug Sampler&quot;) {
    return
}

def method = result.getHTTPMethod() ?: &quot;&quot;
def responseCode = result.getResponseCode() ?: &quot;&quot;
def responseMessage = result.getResponseMessage() ?: &quot;&quot;
def successful = result.isSuccessful()
def elapsedMs = result.getTime()
def bytes = result.getBytesAsLong()
def threadName = result.getThreadName() ?: &quot;&quot;
def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;-&quot;
def linkingId = vars.get(&quot;Linking_Case_ID&quot;) ?: &quot;-&quot;

def redact = { String text -&gt;
    if (!text) return &quot;&quot;
    return text
        .replaceAll(/(?i)(password|encodedPassword|csrf|event_token|oauth_code|code_verifier)([=:]\s*&quot;?)[^&quot;&amp;\s]+/, &apos;$1$2***&apos;)
        .replaceAll(/(?i)(password|encodedPassword|csrf|event_token|oauth_code|code_verifier)(&quot;\s*:\s*&quot;)[^&quot;]+/, &apos;$1$2***&quot;&apos;)
}

def safeUrl = redact(url)
def responseBody = &quot;&quot;
try {
    responseBody = new String(result.getResponseData() ?: new byte[0], &quot;UTF-8&quot;)
} catch (ignored) {
    responseBody = &quot;&quot;
}
def bodySnippet = redact(responseBody.take(1200))

def requestData = &quot;&quot;
try {
    requestData = redact(result.getSamplerData() ?: &quot;&quot;)
} catch (ignored) {
    requestData = &quot;&quot;
}
def requestSnippet = requestData.take(800)

def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date(result.getTimeStamp()))

def humanLog = new StringBuilder()
humanLog.append(&quot;--------------------------------------------------------------------------------\n&quot;)
humanLog.append(&quot;[&quot;).append(ts).append(&quot;] &quot;).append(label).append(&quot;\n&quot;)
humanLog.append(&quot;Thread : &quot;).append(threadName).append(&quot;\n&quot;)
humanLog.append(&quot;User   : &quot;).append(username).append(&quot; | iteration=&quot;).append(iteration).append(&quot;\n&quot;)
humanLog.append(&quot;Cases  : Case_ID=&quot;).append(caseId).append(&quot; | Linking_Case_ID=&quot;).append(linkingId).append(&quot;\n&quot;)
humanLog.append(&quot;Method : &quot;).append(method).append(&quot;\n&quot;)
humanLog.append(&quot;URL    : &quot;).append(safeUrl).append(&quot;\n&quot;)
humanLog.append(&quot;Result : &quot;).append(responseCode).append(&quot; &quot;).append(responseMessage)
humanLog.append(successful ? &quot; | STATUS=PASS&quot; : &quot; | STATUS=FAIL&quot;)
humanLog.append(&quot; | &quot;).append(elapsedMs).append(&quot;ms | &quot;).append(bytes).append(&quot; bytes\n&quot;)
if (requestSnippet) {
    humanLog.append(&quot;Request:\n&quot;).append(requestSnippet).append(&quot;\n&quot;)
}
humanLog.append(&quot;Response body (first 1200 chars):\n&quot;).append(bodySnippet ?: &quot;&lt;empty&gt;&quot;).append(&quot;\n&quot;)
humanLog.append(&quot;--------------------------------------------------------------------------------\n\n&quot;)

try {
    logFile.append(humanLog.toString())

    def ndjson = [
        runId       : &quot;api-trace&quot;,
        timestamp   : result.getTimeStamp(),
        location    : label,
        message     : &quot;api call result&quot;,
        data        : [
            threadName    : threadName,
            username      : username,
            iteration     : iteration,
            caseId        : caseId,
            linkingCaseId : linkingId,
            method        : method,
            url           : safeUrl.take(300),
            responseCode  : responseCode,
            responseMessage: responseMessage,
            successful    : successful,
            elapsedMs     : elapsedMs,
            bytes         : bytes,
            bodySnippet   : bodySnippet.take(500)
        ]
    ]
    def jsonLine = groovy.json.JsonOutput.toJson(ndjson)
    if (jsonLine) {
        logFile.append(jsonLine)
        logFile.append(&quot;\n&quot;)
    }
} catch (Exception e) {
    log.warn(&quot;[API] trace write failed for &quot; + label + &quot;: &quot; + e.message)
}

if (!successful) {
    def apiFailLine = &quot;[&quot; + ts + &quot;] [FAIL] event=API_FAIL | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=&quot; + caseId + &quot; | Linking_Case_ID=&quot; + linkingId + &quot; | sampler=&quot; + label + &quot; | HTTP=&quot; + responseCode + &quot; | message=&quot; + responseMessage + &quot; | url=&quot; + safeUrl.take(200)
    def errorPath = props.get(&quot;__CC_ERROR_LOG_PATH__&quot;)
    if (errorPath) { new File(errorPath).append(apiFailLine + &quot;\n&quot;, &quot;UTF-8&quot;) }
}

log.info(&quot;[API] &quot; + label + &quot; | user=&quot; + username + &quot; | Case_ID=&quot; + caseId + &quot; | Linking_Case_ID=&quot; + linkingId + &quot; -&gt; HTTP &quot; + responseCode + &quot; (&quot; + elapsedMs + &quot;ms) &quot; + (successful ? &quot;PASS&quot; : &quot;FAIL&quot;))</stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
      </JSR223Listener>
