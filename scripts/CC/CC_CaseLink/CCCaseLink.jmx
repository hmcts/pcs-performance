      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Init Timestamped Run Results CSV" enabled="true">
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="script">import java.text.SimpleDateFormat

def resolveScriptHome = {
    def override = (props.get(&quot;scriptHome&quot;) ?: vars.get(&quot;scriptHome&quot;) ?: &quot;&quot;).trim()
    if (override) {
        return new File(override).getAbsolutePath()
    }
    return new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
}

def scriptHome = resolveScriptHome()
props.put(&quot;SCRIPT_HOME&quot;, scriptHome)
vars.put(&quot;scriptHome&quot;, scriptHome)

def logsRoot = new File(scriptHome, vars.get(&quot;logsDir&quot;) ?: &quot;Logs&quot;)
logsRoot.mkdirs()
new File(scriptHome, &quot;Summary Report&quot;).mkdirs()
new File(scriptHome, &quot;Aggregate Report&quot;).mkdirs()
new File(scriptHome, &quot;Reports&quot;).mkdirs()

def errorPath = new File(scriptHome, vars.get(&quot;errorLogPath&quot;) ?: &quot;Logs/CCCaseLink-errors.log&quot;).absolutePath
props.put(&quot;__CC_ERROR_LOG_PATH__&quot;, errorPath)
new File(errorPath).getParentFile()?.mkdirs()
new File(errorPath).write(&quot;=== CCCaseLink Error Log | started &quot; + new Date() + &quot; ===\n\n&quot;, &quot;UTF-8&quot;)

[&apos;__CC_USED_LINK_PAIRS__&apos;, &apos;__CC_USED_CASE_IDS__&apos;, &apos;__CC_RUN_RESULTS_CSV_PATH__&apos;, &apos;__CC_RUN_RESULTS_CSV_NAME__&apos;, &apos;ccCaseLinkApiLogStarted&apos;].each { props.remove(it) }
props.keySet().findAll { k -&gt;
    k.startsWith(&apos;__cc_iteration_&apos;) || k.startsWith(&apos;cc_csv_row_&apos;) || k.startsWith(&apos;cc_run_complete_&apos;)
}.each { props.remove(it) }

def resultDir = vars.get(&quot;runResultsCsvDir&quot;) ? new File(scriptHome, vars.get(&quot;runResultsCsvDir&quot;)).absolutePath : new File(logsRoot, &quot;.&quot;).absolutePath
def dir = new File(resultDir)
if (!dir.exists()) {
    dir.mkdirs()
}

def ts = new SimpleDateFormat(&quot;yyyy-MM-dd_HH-mm-ss&quot;).format(new Date())
def csvFile = new File(dir, &quot;CCCaseLink-run-results-&quot; + ts + &quot;.csv&quot;)
def header = &quot;timestamp,thread,username,iteration,Case_ID,Linking_Case_ID,status,http_code\n&quot;

csvFile.write(header, &quot;UTF-8&quot;)
props.put(&quot;__CC_RUN_RESULTS_CSV_PATH__&quot;, csvFile.absolutePath)
props.put(&quot;__CC_RUN_RESULTS_CSV_NAME__&quot;, csvFile.name)

log.info(&quot;[SETUP] SCRIPT_HOME=&quot; + scriptHome)
log.info(&quot;[SETUP] Error log file: &quot; + errorPath)
log.info(&quot;[SETUP] Global pair/csv state reset for new run&quot;)
log.info(&quot;[CSV] Run results file created: &quot; + csvFile.absolutePath)
</stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
        </JSR223Sampler>
