          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="06_Submit_CreateCaseLink" enabled="true">
            <stringProp name="HTTPSampler.domain">manage-case.perftest.platform.hmcts.net</stringProp>
            <stringProp name="HTTPSampler.path">/data/cases/${Case_ID}/events</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
