          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Select Case And Linking Case From List" enabled="true">
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.text.SimpleDateFormat

def scriptHome = props.get(&quot;SCRIPT_HOME&quot;) ?: new File(org.apache.jmeter.services.FileServer.getFileServer().getBaseDir()).getAbsolutePath()
def auditPath = new File(scriptHome, vars.get(&quot;auditLogPath&quot;) ?: &quot;Logs/CCCaseLink-audit.log&quot;).absolutePath
def auditFile = new File(auditPath)
def threadName = ctx.getThread().getThreadName()
def username = vars.get(&quot;username&quot;) ?: &quot;unknown&quot;
vars.put(&quot;cc_pair_ready&quot;, &quot;false&quot;)

def writeAudit = { level, event, extra -&gt;
    def ts = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;).format(new Date())
    def iteration = vars.get(&quot;cc_iteration&quot;) ?: &quot;-&quot;
    def caseId = vars.get(&quot;Case_ID&quot;) ?: &quot;-&quot;
    def linkingId = vars.get(&quot;Linking_Case_ID&quot;) ?: &quot;-&quot;
    def line = &quot;[&quot; + ts + &quot;] [&quot; + level + &quot;] event=&quot; + event + &quot; | thread=&quot; + threadName + &quot; | user=&quot; + username + &quot; | iteration=&quot; + iteration + &quot; | Case_ID=&quot; + caseId + &quot; | Linking_Case_ID=&quot; + linkingId + &quot; | &quot; + extra
    auditFile.append(line + &quot;\n&quot;)
    if (level == &quot;FAIL&quot;) {
        def errorPath = props.get(&quot;__CC_ERROR_LOG_PATH__&quot;)
        if (errorPath) { new File(errorPath).append(line + &quot;\n&quot;, &quot;UTF-8&quot;) }
        log.error(line)
    } else {
        log.info(line)
    }
}

def responseBody = prev.getResponseDataAsString() ?: &quot;&quot;
if (prev.getResponseCode() != &quot;200&quot; || !responseBody) {
    writeAudit(&quot;FAIL&quot;, &quot;WORKBASKET_SEARCH&quot;, &quot;workbasket search failed HTTP=&quot; + prev.getResponseCode())
    return
}

def results = new JsonSlurper().parseText(responseBody).results ?: []
def caseIds = results.collect { it?.case_id?.toString() }.findAll { it }.unique()

if (caseIds.size() &lt; 2) {
    writeAudit(&quot;FAIL&quot;, &quot;PAIR_SELECTION&quot;, &quot;not enough cases in workbasket, found=&quot; + caseIds.size())
    return
}

def iterKey = &quot;__cc_iteration_&quot; + threadName
def iteration = (props.get(iterKey) ?: &quot;0&quot;).toInteger() + 1
props.put(iterKey, iteration.toString())
vars.put(&quot;cc_iteration&quot;, iteration.toString())

def USED_PAIRS_KEY = &apos;__CC_USED_LINK_PAIRS__&apos;
def USED_CASE_IDS_KEY = &apos;__CC_USED_CASE_IDS__&apos;

synchronized (org.apache.jmeter.JMeter.class) {
    if (!props.containsKey(USED_PAIRS_KEY)) {
        props.put(USED_PAIRS_KEY, java.util.Collections.synchronizedSet(new LinkedHashSet()))
    }
    if (!props.containsKey(USED_CASE_IDS_KEY)) {
        props.put(USED_CASE_IDS_KEY, java.util.Collections.synchronizedSet(new LinkedHashSet()))
    }
}

def usedPairs = props.get(USED_PAIRS_KEY) as Set
def usedCaseIds = props.get(USED_CASE_IDS_KEY) as Set

def pairKey = { a, b -&gt;
    (a &lt;= b) ? (a + &apos;|&apos; + b) : (b + &apos;|&apos; + a)
}

def caseId = null
def linkingCaseId = null

writeAudit(&quot;INFO&quot;, &quot;RUN_START&quot;, &quot;starting iteration &quot; + iteration + &quot; for user=&quot; + username)

synchronized (usedPairs) {
    outer:
    for (int i = 0; i &lt; caseIds.size(); i++) {
        for (int j = 0; j &lt; caseIds.size(); j++) {
            if (i == j) continue
            def c1 = caseIds[i]
            def c2 = caseIds[j]
            def pk = pairKey(c1, c2)
            if (usedPairs.contains(pk)) continue
            if (usedCaseIds.contains(c1) || usedCaseIds.contains(c2)) continue
            caseId = c1
            linkingCaseId = c2
            usedPairs.add(pk)
            usedCaseIds.add(c1)
            usedCaseIds.add(c2)
            break outer
        }
    }
}

if (!caseId || !linkingCaseId) {
    writeAudit(&quot;FAIL&quot;, &quot;PAIR_SELECTION&quot;, &quot;no unused pair available | usedPairs=&quot; + usedPairs.size() + &quot; | workbasketCases=&quot; + caseIds.size())
    writeAudit(&quot;INFO&quot;, &quot;FLOW_SKIPPED&quot;, &quot;skipping steps 01-09 because no valid case pair was selected&quot;)
    return
}

vars.put(&quot;Case_ID&quot;, caseId)
vars.put(&quot;Linking_Case_ID&quot;, linkingCaseId)
vars.put(&quot;cc_pair_ready&quot;, &quot;true&quot;)

writeAudit(&quot;PASS&quot;, &quot;PAIR_SELECTED&quot;, &quot;pairKey=&quot; + pairKey(caseId, linkingCaseId) + &quot; | usedPairsAfter=&quot; + usedPairs.size())
</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
