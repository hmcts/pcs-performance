          <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="05_Validate_CreateCaseLink" enabled="true">
            <stringProp name="HTTPSampler.domain">manage-case.perftest.platform.hmcts.net</stringProp>
            <stringProp name="HTTPSampler.path">/data/case-types/PCS/validate?pageId=createCaseLinkcreateCaseLink</stringProp>
            <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
            <stringProp name="HTTPSampler.method">POST</stringProp>
            <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
            <boolProp name="HTTPSampler.postBodyRaw">true</boolProp>
            <elementProp name="HTTPsampler.Arguments" elementType="Arguments">
              <collectionProp name="Arguments.arguments">
                <elementProp name="" elementType="HTTPArgument">
                  <boolProp name="HTTPArgument.always_encode">false</boolProp>
                  <stringProp name="Argument.value">${caseLinkValidateBody}</stringProp>
                  <stringProp name="Argument.metadata">=</stringProp>
                </elementProp>
              </collectionProp>
            </elementProp>
          </HTTPSamplerProxy>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Build Case Link Validate Body" enabled="true">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def caseId = vars.get(&quot;Case_ID&quot;)
def linkingId = vars.get(&quot;Linking_Case_ID&quot;)
def created = vars.get(&quot;linkingCaseCreatedDate&quot;) ?: &quot;2026-05-14T17:36:41.445&quot;
def caseType = vars.get(&quot;linkingCaseType&quot;) ?: &quot;PCS&quot;
def eventToken = vars.get(&quot;event_token&quot;)
def reason = &apos;{&quot;value&quot;:{&quot;Reason&quot;:&quot;CLRC002&quot;,&quot;OtherDescription&quot;:&quot;&quot;}}&apos;
def linkEntry = &apos;{&quot;id&quot;:&quot;&apos; + linkingId + &apos;&quot;,&quot;value&quot;:{&quot;CaseReference&quot;:&quot;&apos; + linkingId + &apos;&quot;,&quot;CaseType&quot;:&quot;&apos; + caseType + &apos;&quot;,&quot;CreatedDateTime&quot;:&quot;&apos; + created + &apos;&quot;,&quot;ReasonForLink&quot;:[&apos; + reason + &apos;]}}&apos;
vars.put(&quot;caseLinkValidateBody&quot;, &apos;{&quot;data&quot;:{&quot;caseLinks&quot;:[&apos; + linkEntry + &apos;]},&quot;event&quot;:{&quot;id&quot;:&quot;createCaseLink&quot;,&quot;summary&quot;:&quot;&quot;,&quot;description&quot;:&quot;&quot;},&quot;event_data&quot;:{&quot;caseLinks&quot;:[&apos; + linkEntry + &apos;]},&quot;event_token&quot;:&quot;&apos; + eventToken + &apos;&quot;,&quot;ignore_warning&quot;:false,&quot;case_reference&quot;:&quot;&apos; + caseId + &apos;&quot;}&apos;)</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
              <collectionProp name="HeaderManager.headers">
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Accept</stringProp>
                  <stringProp name="Header.value">application/vnd.uk.gov.hmcts.ccd-data-store-api.case-data-validate.v2+json;charset=UTF-8</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Content-Type</stringProp>
                  <stringProp name="Header.value">application/json</stringProp>
                </elementProp>
                <elementProp name="" elementType="Header">
                  <stringProp name="Header.name">Origin</stringProp>
