            <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Copy_XSRF_From_Cookies">
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def cm = sampler.getCookieManager()
if (cm != null) {
    for (int i = 0; i &lt; cm.getCookieCount(); i++) {
        def c = cm.get(i)
        if (c.getName().equalsIgnoreCase(&quot;XSRF-TOKEN&quot;)) {
            vars.put(&quot;xsrf&quot;, c.getValue())
            break
        }
    }
}
</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PostProcessor>
