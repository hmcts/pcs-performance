          <hashTree>
            <HTTPSamplerProxy guiclass="HttpTestSampleGui" testclass="HTTPSamplerProxy" testname="GET /api/user-details" enabled="true">
              <stringProp name="HTTPSampler.domain">${BASE_URL_1}</stringProp>
              <stringProp name="HTTPSampler.protocol">https</stringProp>
              <stringProp name="HTTPSampler.path">/api/user-details?userId=${userId}</stringProp>
              <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
              <stringProp name="HTTPSampler.method">GET</stringProp>
              <boolProp name="HTTPSampler.use_keepalive">true</boolProp>
              <boolProp name="HTTPSampler.postBodyRaw">false</boolProp>
              <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
                <collectionProp name="Arguments.arguments"/>
              </elementProp>
            </HTTPSamplerProxy>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Set_Refresh_Email" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def uid = vars.get(&quot;userId&quot;) ?: &quot;&quot;
int count = 0
try { count = Integer.parseInt(vars.get(&quot;refreshUserCount&quot;) ?: &quot;0&quot;) } catch (Exception ignored) {}
for (int i = 1; i &lt;= count; i++) {
    if ((vars.get(&quot;refreshUserId_&quot; + i) ?: &quot;&quot;) == uid) {
        vars.put(&quot;refreshEmail&quot;, vars.get(&quot;refreshEmail_&quot; + i) ?: &quot;&quot;)
        break
    }
}
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                <collectionProp name="HeaderManager.headers">
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Accept</stringProp>
                    <stringProp name="Header.value">application/json, text/plain, */*</stringProp>
                  </elementProp>
                  <elementProp name="" elementType="Header">
                    <stringProp name="Header.name">Referer</stringProp>
                    <stringProp name="Header.value">https://manage-org.perftest.platform.hmcts.net/</stringProp>
                  </elementProp>
                </collectionProp>
              </HeaderManager>
              <hashTree/>
              <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Build_Change_Submit_Payload" enabled="true">
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput
import org.apache.jmeter.services.FileServer

def writeRow = { email, userId, idamStatus, cmaState, httpCode, result, message -&gt;
    def csvEscape = { s -&gt;
        def t = (s ?: &quot;&quot;).toString().replace(&quot;\r&quot;, &quot; &quot;).replace(&quot;\n&quot;, &quot; &quot;)
        if (t.contains(&quot;,&quot;) || t.contains(&quot;\&quot;&quot;)) {
            return &quot;\&quot;&quot; + t.replace(&quot;\&quot;&quot;, &quot;\&quot;\&quot;&quot;) + &quot;\&quot;&quot;
        }
        return t
    }
    def stamp = vars.get(&quot;outputStamp&quot;) ?: new Date().format(&quot;yyyyMMdd-HHmmss&quot;)
    vars.put(&quot;outputStamp&quot;, stamp)
    def dir = new File(FileServer.getFileServer().getBaseDir())
    def header = &quot;email,userId,idamStatus,cmaState,httpCode,result,message\n&quot;
    def allFile = new File(dir, &quot;output_RefreshUser_&quot; + stamp + &quot;.csv&quot;)
    def successFile = new File(dir, &quot;output_RefreshUser_success_&quot; + stamp + &quot;.csv&quot;)
    def sorryFile = new File(dir, &quot;output_RefreshUser_sorry_&quot; + stamp + &quot;.csv&quot;)
    [allFile, successFile, sorryFile].each { f -&gt; if (!f.exists()) f.write(header) }
    def line = csvEscape(email) + &quot;,&quot; + csvEscape(userId) + &quot;,&quot; + csvEscape(idamStatus) + &quot;,&quot; + csvEscape(cmaState) + &quot;,&quot; + csvEscape(httpCode) + &quot;,&quot; + result + &quot;,&quot; + csvEscape(message) + &quot;\n&quot;
    allFile.append(line)
    if (result == &quot;SUCCESS&quot;) {
        successFile.append(line)
    } else {
        sorryFile.append(line)
    }
}

vars.put(&quot;doSubmit&quot;, &quot;false&quot;)
vars.put(&quot;refreshPayload&quot;, &quot;{}&quot;)
vars.put(&quot;idamStatus&quot;, &quot;&quot;)
vars.put(&quot;cmaState&quot;, &quot;&quot;)

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def httpCode = prev.getResponseCode() ?: &quot;&quot;
def lower = body.toLowerCase()
def emailGuess = vars.get(&quot;refreshEmail&quot;) ?: &quot;&quot;
def uidGuess = vars.get(&quot;userId&quot;) ?: &quot;&quot;

if (httpCode != &quot;200&quot; || lower.contains(&quot;sorry&quot;) || lower.contains(&quot;&lt;html&quot;)) {
    prev.setSuccessful(false)
    def msg = lower.contains(&quot;sorry&quot;) ? body.replaceAll(&quot;\\s+&quot;, &quot; &quot;).take(250) : (&quot;User details did not load: HTTP &quot; + httpCode)
    writeRow(emailGuess, uidGuess, &quot;&quot;, &quot;&quot;, httpCode, &quot;SORRY&quot;, msg)
    log.warn(&quot;[RefreshUser] details not through email=&quot; + emailGuess + &quot; code=&quot; + httpCode)
    return
}

def parsed
try {
    parsed = new JsonSlurper().parseText(body)
} catch (Exception e) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;user-details is not JSON: &quot; + e.message)
    writeRow(emailGuess, uidGuess, &quot;&quot;, &quot;&quot;, httpCode, &quot;SORRY&quot;, &quot;user-details is not JSON: &quot; + e.message)
    return
}

def u = (parsed.users &amp;&amp; parsed.users.size() &gt; 0) ? parsed.users[0] : [:]
if (!u) {
    prev.setSuccessful(false)
    writeRow(emailGuess, uidGuess, &quot;&quot;, &quot;&quot;, httpCode, &quot;SORRY&quot;, &quot;user-details returned no user&quot;)
    return
}

def userId = (u.userIdentifier ?: uidGuess).toString()
def email = (u.email ?: emailGuess).toString()
def firstName = (u.firstName ?: &quot;&quot;).toString()
def lastName = (u.lastName ?: &quot;&quot;).toString()
def status = (u.idamStatus ?: &quot;&quot;).toString()
def existing = (u.userAccessTypes ?: []) as List
def existingRoles = (u.roles ?: []) as List
def roleNames = existingRoles.collect { it instanceof Map ? (it.name ?: &quot;&quot;).toString() : it.toString() }
def cmaChecked = roleNames.any { it.equalsIgnoreCase(&quot;pui-case-manager&quot;) }
def cmaState = cmaChecked ? &quot;CHECKED&quot; : &quot;UNCHECKED&quot;

vars.put(&quot;refreshEmail&quot;, email)
vars.put(&quot;idamStatus&quot;, status)
vars.put(&quot;cmaState&quot;, cmaState)

log.info(&quot;[RefreshUser] details through email=&quot; + email + &quot; idamStatus=&quot; + status + &quot; cma=&quot; + cmaState)

def cmaRoles = [
    &quot;pui-case-manager&quot;,
    &quot;caseworker&quot;,
    &quot;caseworker-divorce&quot;,
    &quot;caseworker-divorce-solicitor&quot;,
    &quot;caseworker-divorce-financialremedy&quot;,
    &quot;caseworker-divorce-financialremedy-solicitor&quot;,
    &quot;caseworker-probate&quot;,
    &quot;caseworker-ia&quot;,
    &quot;caseworker-probate-solicitor&quot;,
    &quot;caseworker-publiclaw&quot;,
    &quot;caseworker-ia-legalrep-solicitor&quot;,
    &quot;caseworker-publiclaw-solicitor&quot;,
    &quot;caseworker-civil&quot;,
    &quot;caseworker-civil-solicitor&quot;,
    &quot;caseworker-employment&quot;,
    &quot;caseworker-employment-legalrep-solicitor&quot;,
    &quot;caseworker-privatelaw&quot;,
    &quot;caseworker-privatelaw-solicitor&quot;,
    &quot;caseworker-pcs&quot;,
    &quot;caseworker-pcs-solicitor&quot;
]
def rolesAdd = []
if (!cmaChecked) {
    cmaRoles.each { name -&gt;
        if (!roleNames.any { it.equalsIgnoreCase(name) }) {
            rolesAdd.add([name: name])
        }
    }
    log.info(&quot;[RefreshUser] Case management unchecked; will check then submit for &quot; + email)
} else {
    log.info(&quot;[RefreshUser] Case management already checked; submit only for &quot; + email)
}

def required = [
    [jurisdictionId: &quot;BEFTA_MASTER&quot;, organisationProfileId: &quot;SOLICITOR_PROFILE&quot;, accessTypeId: &quot;BEFTA_SOLICITOR_1&quot;, enabled: true],
    [jurisdictionId: &quot;PCS&quot;, organisationProfileId: &quot;SOLICITOR_PROFILE&quot;, accessTypeId: &quot;solicitor-org-claimant-access&quot;, enabled: true],
    [jurisdictionId: &quot;PCS&quot;, organisationProfileId: &quot;SOLICITOR_PROFILE&quot;, accessTypeId: &quot;solicitor-org-defendant-access&quot;, enabled: true],
    [jurisdictionId: &quot;PCS&quot;, organisationProfileId: &quot;SOLICITOR_PROFILE&quot;, accessTypeId: &quot;duty-advisor-access&quot;, enabled: false]
]
def merged = []
def seen = [] as Set
existing.each { at -&gt;
    def key = (at.jurisdictionId ?: &quot;&quot;).toString() + &quot;|&quot; + (at.accessTypeId ?: &quot;&quot;).toString()
    if (!seen.contains(key)) {
        seen.add(key)
        merged.add([
            jurisdictionId: at.jurisdictionId,
            organisationProfileId: at.organisationProfileId ?: &quot;SOLICITOR_PROFILE&quot;,
            accessTypeId: at.accessTypeId,
            enabled: at.enabled
        ])
    }
}
required.each { at -&gt;
    def key = at.jurisdictionId + &quot;|&quot; + at.accessTypeId
    if (!seen.contains(key)) {
        seen.add(key)
        merged.add(at)
    } else {
        merged.each { m -&gt;
            if ((m.jurisdictionId ?: &quot;&quot;).toString() == at.jurisdictionId &amp;&amp; (m.accessTypeId ?: &quot;&quot;).toString() == at.accessTypeId) {
                if (at.accessTypeId != &quot;duty-advisor-access&quot;) {
                    m.enabled = true
                }
            }
        }
    }
}

def orgIds = parsed.organisationProfileIds ?: [&quot;SOLICITOR_PROFILE&quot;, &quot;ORGANISATION_PROFILE&quot;]
def payload = [
    userPayload: [
        id: userId,
        email: email,
        firstName: firstName,
        lastName: lastName,
        idamStatus: status,
        rolesAdd: rolesAdd,
        rolesDelete: [],
        userAccessTypes: merged
    ],
    orgIdsPayload: orgIds
]
vars.put(&quot;refreshPayload&quot;, JsonOutput.toJson(payload))
vars.put(&quot;doSubmit&quot;, &quot;true&quot;)
</stringProp>
                <stringProp name="scriptLanguage">groovy</stringProp>
              </JSR223PostProcessor>
              <hashTree/>
              <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Assert_User_Details" enabled="true">
                <collectionProp name="Asserion.test_strings">
                  <stringProp name="49586">200</stringProp>
                </collectionProp>
                <stringProp name="Assertion.custom_message"></stringProp>
                <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
