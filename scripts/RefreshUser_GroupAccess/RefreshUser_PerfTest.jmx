              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import groovy.json.JsonSlurper
import java.nio.file.Files
import java.nio.file.Paths

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def parsed
try {
    parsed = new JsonSlurper().parseText(body)
} catch (Exception e) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;allUserListWithoutRoles is not JSON: &quot; + e.message)
    return
}

def users = (parsed.users ?: []) as List
def csvPath = vars.get(&quot;emailCsvPath&quot;)
def wanted = []
Files.readAllLines(Paths.get(csvPath)).each { line -&gt;
    def email = (line ?: &quot;&quot;).trim()
    if (!email || email.equalsIgnoreCase(&quot;email&quot;)) return
    wanted.add(email.toLowerCase())
}

def wantedSet = wanted as Set
def matched = []
users.each { u -&gt;
    def em = (u.email ?: &quot;&quot;).toString().toLowerCase()
    if (wantedSet.contains(em)) {
        matched.add(u)
    }
}

def order = [:]
wanted.eachWithIndex { em, i -&gt; order[em] = i }
matched.sort { a, b -&gt;
    def ia = order[(a.email ?: &quot;&quot;).toString().toLowerCase()] ?: 9999
    def ib = order[(b.email ?: &quot;&quot;).toString().toLowerCase()] ?: 9999
    ia &lt;=&gt; ib
}

int n = 0
matched.each { u -&gt;
    n++
    vars.put(&quot;refreshUserId_&quot; + n, (u.userIdentifier ?: &quot;&quot;).toString())
    vars.put(&quot;refreshEmail_&quot; + n, (u.email ?: &quot;&quot;).toString())
    vars.put(&quot;refreshFirstName_&quot; + n, (u.firstName ?: &quot;&quot;).toString())
    vars.put(&quot;refreshLastName_&quot; + n, (u.lastName ?: &quot;&quot;).toString())
}
vars.put(&quot;refreshUserCount&quot;, String.valueOf(n))

def missing = wanted.findAll { em -&gt;
    !matched.any { (it.email ?: &quot;&quot;).toString().equalsIgnoreCase(em) }
}
log.info(&quot;[RefreshUser] matched &quot; + n + &quot; of &quot; + wanted.size() + &quot; filter emails&quot;)
if (missing) {
    log.warn(&quot;[RefreshUser] not found in Filter by name list: &quot; + missing)
}

import org.apache.jmeter.services.FileServer
def csvEscape = { s -&gt;
    def t = (s ?: &quot;&quot;).toString().replace(&quot;\r&quot;, &quot; &quot;).replace(&quot;\n&quot;, &quot; &quot;)
    if (t.contains(&quot;,&quot;) || t.contains(&quot;\&quot;&quot;) || t.contains(&quot; &quot;)) {
        return &quot;\&quot;&quot; + t.replace(&quot;\&quot;&quot;, &quot;\&quot;\&quot;&quot;) + &quot;\&quot;&quot;
    }
    return t
}
def stamp = vars.get(&quot;outputStamp&quot;) ?: new Date().format(&quot;yyyyMMdd-HHmmss&quot;)
vars.put(&quot;outputStamp&quot;, stamp)
def dir = new File(FileServer.getFileServer().getBaseDir())
def header = &quot;email,userId,httpCode,result,message\n&quot;
def allFile = new File(dir, &quot;output_RefreshUser_&quot; + stamp + &quot;.csv&quot;)
def successFile = new File(dir, &quot;output_RefreshUser_success_&quot; + stamp + &quot;.csv&quot;)
def sorryFile = new File(dir, &quot;output_RefreshUser_sorry_&quot; + stamp + &quot;.csv&quot;)
[allFile, successFile, sorryFile].each { f -&gt; if (!f.exists()) f.write(header) }
missing.each { em -&gt;
    def line = csvEscape(em) + &quot;,,,&quot; + &quot;SORRY&quot; + &quot;,&quot; + csvEscape(&quot;Sorry: email not found in Filter by name / user list&quot;) + &quot;\n&quot;
    allFile.append(line)
    sorryFile.append(line)
}
if (n == 0) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;None of the Filter by name emails were in /api/allUserListWithoutRoles&quot;)
}
</stringProp>
