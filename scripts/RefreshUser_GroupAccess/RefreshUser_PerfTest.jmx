                <stringProp name="parameters"></stringProp>
                <stringProp name="script">def uid = vars.get(&quot;userId&quot;) ?: &quot;&quot;
int count = 0
try { count = Integer.parseInt(vars.get(&quot;refreshUserCount&quot;) ?: &quot;0&quot;) } catch (Exception ignored) {}
for (int i = 1; i &lt;= count; i++) {
    if ((vars.get(&quot;refreshUserId_&quot; + i) ?: &quot;&quot;) == uid) {
        vars.put(&quot;refreshEmail&quot;, vars.get(&quot;refreshEmail_&quot; + i) ?: &quot;&quot;)
        break
    }
}
</stringProp>
