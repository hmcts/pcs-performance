                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import groovy.json.JsonSlurper
import groovy.json.JsonOutput

def body = prev.getResponseDataAsString() ?: &quot;&quot;
def parsed
try {
    parsed = new JsonSlurper().parseText(body)
} catch (Exception e) {
    prev.setSuccessful(false)
    prev.setResponseMessage(&quot;user-details is not JSON: &quot; + e.message)
    vars.put(&quot;refreshPayload&quot;, &quot;{}&quot;)
    return
}

def u = (parsed.users &amp;&amp; parsed.users.size() &gt; 0) ? parsed.users[0] : [:]
def userId = (u.userIdentifier ?: vars.get(&quot;userId&quot;) ?: &quot;&quot;).toString()
def email = (u.email ?: vars.get(&quot;refreshEmail&quot;) ?: &quot;&quot;).toString()
def firstName = (u.firstName ?: &quot;&quot;).toString()
def lastName = (u.lastName ?: &quot;&quot;).toString()
def status = (u.idamStatus ?: &quot;ACTIVE&quot;).toString()
def existing = (u.userAccessTypes ?: []) as List

def required = [
    [jurisdictionId: &quot;BEFTA_MASTER&quot;, organisationProfileId: &quot;SOLICITOR_PROFILE&quot;, accessTypeId: &quot;BEFTA_SOLICITOR_1&quot;, enabled: true],
    [jurisdictionId: &quot;PCS&quot;, organisationProfileId: &quot;SOLICITOR_PROFILE&quot;, accessTypeId: &quot;solicitor-org-claimant-access&quot;, enabled: true],
    [jurisdictionId: &quot;PCS&quot;, organisationProfileId: &quot;SOLICITOR_PROFILE&quot;, accessTypeId: &quot;solicitor-org-defendant-access&quot;, enabled: true],
    [jurisdictionId: &quot;PCS&quot;, organisationProfileId: &quot;SOLICITOR_PROFILE&quot;, accessTypeId: &quot;duty-advisor-access&quot;, enabled: false]
]

def merged = []
def seen = [] as Set
existing.each { at -&gt;
    def key = (at.jurisdictionId ?: &quot;&quot;).toString() + &quot;|&quot; + (at.accessTypeId ?: &quot;&quot;).toString()
    if (!seen.contains(key)) {
        seen.add(key)
        merged.add([
            jurisdictionId: at.jurisdictionId,
            organisationProfileId: at.organisationProfileId ?: &quot;SOLICITOR_PROFILE&quot;,
            accessTypeId: at.accessTypeId,
            enabled: at.enabled
        ])
    }
}
required.each { at -&gt;
    def key = at.jurisdictionId + &quot;|&quot; + at.accessTypeId
    if (!seen.contains(key)) {
        seen.add(key)
        merged.add(at)
    } else {
        merged.each { m -&gt;
            if ((m.jurisdictionId ?: &quot;&quot;).toString() == at.jurisdictionId &amp;&amp; (m.accessTypeId ?: &quot;&quot;).toString() == at.accessTypeId) {
                if (at.accessTypeId != &quot;duty-advisor-access&quot;) {
                    m.enabled = true
                }
            }
        }
    }
}

def orgIds = parsed.organisationProfileIds ?: [&quot;SOLICITOR_PROFILE&quot;, &quot;ORGANISATION_PROFILE&quot;]
def payload = [
    userPayload: [
        id: userId,
        email: email,
        firstName: firstName,
        lastName: lastName,
        idamStatus: status,
        rolesAdd: [],
        rolesDelete: [],
        userAccessTypes: merged
    ],
    orgIdsPayload: orgIds
]
vars.put(&quot;refreshPayload&quot;, JsonOutput.toJson(payload))
vars.put(&quot;refreshEmail&quot;, email)
log.info(&quot;[RefreshUser] built refresh payload for &quot; + email + &quot; id=&quot; + userId)
</stringProp>
