                <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Write_Refresh_Output" enabled="true">
                  <stringProp name="cacheKey">false</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">import groovy.json.JsonSlurper
import org.apache.jmeter.services.FileServer

def csvEscape = { s -&gt;
    def t = (s ?: &quot;&quot;).toString().replace(&quot;\r&quot;, &quot; &quot;).replace(&quot;\n&quot;, &quot; &quot;)
    if (t.contains(&quot;,&quot;) || t.contains(&quot;\&quot;&quot;)) {
        return &quot;\&quot;&quot; + t.replace(&quot;\&quot;&quot;, &quot;\&quot;\&quot;&quot;) + &quot;\&quot;&quot;
    }
    return t
}

def stamp = vars.get(&quot;outputStamp&quot;) ?: new Date().format(&quot;yyyyMMdd-HHmmss&quot;)
def dir = new File(FileServer.getFileServer().getBaseDir())
def header = &quot;email,userId,idamStatus,cmaState,httpCode,result,message\n&quot;
def allFile = new File(dir, &quot;output_RefreshUser_&quot; + stamp + &quot;.csv&quot;)
def successFile = new File(dir, &quot;output_RefreshUser_success_&quot; + stamp + &quot;.csv&quot;)
def sorryFile = new File(dir, &quot;output_RefreshUser_sorry_&quot; + stamp + &quot;.csv&quot;)
[allFile, successFile, sorryFile].each { f -&gt; if (!f.exists()) f.write(header) }

def email = vars.get(&quot;refreshEmail&quot;) ?: &quot;&quot;
def userId = vars.get(&quot;userId&quot;) ?: &quot;&quot;
def idamStatus = vars.get(&quot;idamStatus&quot;) ?: &quot;&quot;
def cmaState = vars.get(&quot;cmaState&quot;) ?: &quot;&quot;
def httpCode = prev.getResponseCode() ?: &quot;&quot;
def body = prev.getResponseDataAsString() ?: &quot;&quot;
def lower = body.toLowerCase()

def idamFail = false
def idamMsg = &quot;&quot;
try {
    def parsed = new JsonSlurper().parseText(body)
    def check = { resp -&gt;
        if (resp == null) return
        def c = (resp.idamStatusCode ?: &quot;&quot;).toString().trim()
        def m = (resp.idamMessage ?: &quot;&quot;).toString()
        def ml = m.toLowerCase()
        if (c &amp;&amp; c != &quot;200&quot;) {
            idamFail = true
            idamMsg = (idamMsg ? idamMsg + &quot;; &quot; : &quot;&quot;) + m + &quot; (&quot; + c + &quot;)&quot;
        } else if (ml.contains(&quot;sorry&quot;) || ml.contains(&quot;not found&quot;) || ml.contains(&quot;unable&quot;) || ml.contains(&quot;problem&quot;)) {
            idamFail = true
            idamMsg = (idamMsg ? idamMsg + &quot;; &quot; : &quot;&quot;) + m
        }
    }
    check(parsed.roleAdditionResponse)
    check(parsed.roleDeletionResponse)
    check(parsed.statusUpdateResponse)
} catch (Exception ignored) {}

def hasSorry = lower.contains(&quot;sorry&quot;)
def pendingNote = idamStatus.equalsIgnoreCase(&quot;PENDING&quot;) ? &quot;PENDING user details loaded; Change then submit. &quot; : &quot;&quot;
def cmaNote = (cmaState == &quot;UNCHECKED&quot;) ? &quot;Case management was unchecked and was checked. &quot; : ((cmaState == &quot;CHECKED&quot;) ? &quot;Case management already checked; submit only. &quot; : &quot;&quot;)

def result
def message
if (httpCode == &quot;200&quot; &amp;&amp; !hasSorry &amp;&amp; !idamFail) {
    result = &quot;SUCCESS&quot;
    message = (pendingNote + cmaNote + &quot;User refreshed successfully&quot;).trim()
} else {
    result = &quot;SORRY&quot;
    def snippet = idamMsg ?: body.replaceAll(&quot;\\s+&quot;, &quot; &quot;).take(250)
    message = (pendingNote + cmaNote + (snippet ?: &quot;Refresh failed&quot;)).trim()
}

def line = csvEscape(email) + &quot;,&quot; + csvEscape(userId) + &quot;,&quot; + csvEscape(idamStatus) + &quot;,&quot; + csvEscape(cmaState) + &quot;,&quot; + csvEscape(httpCode) + &quot;,&quot; + result + &quot;,&quot; + csvEscape(message) + &quot;\n&quot;
allFile.append(line)
if (result == &quot;SUCCESS&quot;) {
    successFile.append(line)
} else {
    sorryFile.append(line)
}
log.info(&quot;[RefreshUser] &quot; + result + &quot; email=&quot; + email + &quot; status=&quot; + idamStatus + &quot; cma=&quot; + cmaState + &quot; code=&quot; + httpCode)
</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PostProcessor>
