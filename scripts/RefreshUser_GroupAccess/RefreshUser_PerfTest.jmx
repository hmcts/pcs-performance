                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Copy_XSRF_Cookie" enabled="true">
                  <stringProp name="cacheKey">false</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">def xsrf = vars.get(&quot;xsrf&quot;)
if (xsrf == null || xsrf == &quot;NOT_FOUND&quot; || xsrf.trim().isEmpty()) {
    def cm = sampler.getCookieManager()
    if (cm != null) {
        for (int i = 0; i &lt; cm.getCookieCount(); i++) {
            def c = cm.get(i)
            if (c.getName().equalsIgnoreCase(&quot;XSRF-TOKEN&quot;)) {
                vars.put(&quot;xsrf&quot;, c.getValue())
                break
            }
        }
    }
}
</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PreProcessor>
                <hashTree/>
                <HeaderManager guiclass="HeaderPanel" testclass="HeaderManager" testname="HTTP Header Manager" enabled="true">
                  <collectionProp name="HeaderManager.headers">
                    <elementProp name="" elementType="Header">
